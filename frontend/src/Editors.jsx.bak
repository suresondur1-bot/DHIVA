// ─── SEARCHABLE SELECT COMPONENT ─────────────────────────────────────────────
function SearchableSelect({ value, onChange, options, placeholder = "Type to search..." }) {
  const [search, setSearch] = useState("");
  const [isOpen, setIsOpen] = useState(false);
  const inputRef = useRef(null);
  
  // Filter options based on search
  const filtered = options.filter(opt =>
    opt.label.toLowerCase().includes(search.toLowerCase()) ||
    opt.value.toLowerCase().includes(search.toLowerCase())
  );
  
  // Group filtered options
  const groupedOptions = {};
  filtered.forEach(opt => {
    if (!groupedOptions[opt.group]) groupedOptions[opt.group] = [];
    groupedOptions[opt.group].push(opt);
  });
  
  const selected = options.find(opt => opt.value === value);
  
  return (
    <div style={{ position: "relative", flex: 2 }}>
      <input
        ref={inputRef}
        type="text"
        value={isOpen ? search : (selected?.label || "")}
        onChange={(e) => {
          setSearch(e.target.value);
          if (!isOpen) setIsOpen(true);
        }}
        onFocus={() => setIsOpen(true)}
        onKeyDown={(e) => {
          if (e.key === "Escape") {
            setIsOpen(false);
            setSearch("");
            inputRef.current?.blur();
          }
        }}
        placeholder={placeholder}
        style={{
          ...s.input,
          fontSize: 13,
          cursor: "text",
        }}
      />
      
      {isOpen && (
        <>
          {/* Backdrop to close dropdown */}
          <div
            style={{
              position: "fixed",
              inset: 0,
              zIndex: 999,
            }}
            onClick={() => {
              setIsOpen(false);
              setSearch("");
            }}
          />
          {/* Dropdown menu */}
          <div
            style={{
              position: "absolute",
              bottom: "100%",
              left: 0,
              right: 0,
              maxHeight: 400,
              overflowY: "auto",
              background: "#fff",
              border: "1px solid #d1d5db",
              borderRadius: 8,
              boxShadow: "0 4px 12px rgba(0,0,0,0.15)",
              zIndex: 1000,
              marginBottom: 4,
            }}
          >
            {filtered.length === 0 && (
              <div style={{ padding: 16, color: "#9ca3af", textAlign: "center", fontSize: 13 }}>
                No actions found
              </div>
            )}
            {ACTION_GROUPS.filter(grp => groupedOptions[grp] && groupedOptions[grp].length > 0).map((grp) => (
              <div key={grp}>
                <div style={{
                  padding: "8px 16px",
                  background: "#f9fafb",
                  fontSize: 11,
                  fontWeight: 700,
                  color: "#6b7280",
                  borderBottom: "1px solid #e5e7eb",
                }}>
                  ── {grp} ──
                </div>
                {groupedOptions[grp].map((opt) => (
                  <div
                    key={opt.value}
                    onClick={() => {
                      onChange(opt.value);
                      setIsOpen(false);
                      setSearch("");
                    }}
                    style={{
                      padding: "10px 16px",
                      cursor: "pointer",
                      background: opt.value === value ? "#eff6ff" : "#fff",
                      borderBottom: "1px solid #f3f4f6",
                      fontSize: 13,
                      transition: "background 0.1s",
                    }}
                    onMouseEnter={(e) => {
                      if (opt.value !== value) e.target.style.background = "#f9fafb";
                    }}
                    onMouseLeave={(e) => {
                      e.target.style.background = opt.value === value ? "#eff6ff" : "#fff";
                    }}
                  >
                    {opt.label}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  );
}

function DbQueryForm({ config, onChange }) {
  const cfg = typeof config === "object" && config !== null ? config : {};
  const set = (k, v) => onChange({ ...cfg, [k]: v });
  return (
    <div style={{ display:"flex", flexDirection:"column", gap:10, marginTop:10,
      background:"#e3f0fb", border:"1px solid #bdd7f5", borderRadius:8, padding:12 }}>
      <div style={{ fontSize:12, fontWeight:700, color:"#1a6fc4", marginBottom:4 }}>🗄️ Database Connection</div>
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:8 }}>
        <div>
          <label style={s.label}>DB Type</label>
          <select style={s.input} value={cfg.db_type||"postgresql"} onChange={e=>set("db_type",e.target.value)}>
            <option value="postgresql">PostgreSQL</option>
            <option value="mysql">MySQL / MariaDB</option>
            <option value="mssql">Microsoft SQL Server</option>
            <option value="oracle">Oracle</option>
          </select>
        </div>
        <div>
          <label style={s.label}>Database Name</label>
          <input style={s.input} value={cfg.database||""} onChange={e=>set("database",e.target.value)} placeholder="mydb" />
        </div>
        <div>
          <label style={s.label}>Host</label>
          <input style={s.input} value={cfg.host||""} onChange={e=>set("host",e.target.value)} placeholder="localhost" />
        </div>
        <div>
          <label style={s.label}>Port</label>
          <input style={s.input} value={cfg.port||""} onChange={e=>set("port",e.target.value)} placeholder="5432" />
        </div>
        <div>
          <label style={s.label}>Username</label>
          <input style={s.input} value={cfg.user||""} onChange={e=>set("user",e.target.value)} placeholder="postgres" />
        </div>
        <div>
          <label style={s.label}>Password</label>
          <input style={{ ...s.input }} type="password" value={cfg.password||""} onChange={e=>set("password",e.target.value)} placeholder="••••••••" />
        </div>
      </div>
      <div>
        <label style={s.label}>SQL Query (returns first row, first column)</label>
        <textarea style={{ ...s.input, height:60, resize:"vertical", fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
          value={cfg.query||""} onChange={e=>set("query",e.target.value)}
          placeholder={"SELECT mrn FROM patients WHERE name = 'John' LIMIT 1"} />
      </div>
      <div style={{ fontSize:11, color:"#8a96a8" }}>
        💡 The first value returned by the query will be stored in this variable. Use <span style={{color:"#f59e0b",fontFamily:"'IBM Plex Mono',monospace"}}>{"{{this_var}}"}</span> in any step.
      </div>
    </div>
  );
}


// ─── DB EXTRACT MULTI FORM ───────────────────────────────────────────────────
function DbExtractMultiForm({ config, onChange }) {
  const cfg = (typeof config === "object" && config !== null) ? config : {};
  const set = (k, v) => onChange({ ...cfg, [k]: v });
  const connMode  = cfg.conn_mode || "saved";
  const mappings  = cfg.mappings  || [{ column: "", variable: "" }];

  const setMapping = (idx, key, val) => {
    const next = mappings.map((m, i) => i === idx ? { ...m, [key]: val } : m);
    set("mappings", next);
  };
  const addMapping    = () => set("mappings", [...mappings, { column: "", variable: "" }]);
  const removeMapping = (idx) => set("mappings", mappings.filter((_, i) => i !== idx));

  return (
    <div style={{ marginTop:10, background:"#f0fff4", border:"1px solid #bbf7d0",
      borderRadius:8, padding:14, display:"flex", flexDirection:"column", gap:12 }}>

      {/* Header */}
      <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between" }}>
        <div style={{ fontSize:12, fontWeight:700, color:"#166534" }}>🗄️ DB Extract Multi Columns</div>
        <span style={{ fontSize:11, background:"#dcfce7", color:"#166534",
          padding:"2px 8px", borderRadius:4, fontWeight:600 }}>🐘 PostgreSQL</span>
      </div>

      {/* Connection mode toggle */}
      <div style={{ display:"flex", gap:0, border:"1px solid #bbf7d0", borderRadius:6, overflow:"hidden", width:"fit-content" }}>
        {[["saved","📋 Saved Connection"],["manual","✏️ Enter Manually"]].map(([mode, label])=>(
          <button key={mode} onClick={()=>set("conn_mode", mode)}
            style={{ padding:"5px 14px", fontSize:12, fontWeight:600, border:"none", cursor:"pointer",
              background: connMode===mode ? "#16a34a" : "#f0fff4",
              color: connMode===mode ? "#fff" : "#166534" }}>
            {label}
          </button>
        ))}
      </div>

      {/* Saved connection name */}
      {connMode === "saved" && (
        <div>
          <label style={s.label}>Connection Name <span style={{color:"#e53935"}}>*</span>
            <span style={{fontWeight:400, color:"#8a96a8", marginLeft:6}}>
              — add connections in 🗄️ DB Connections page
            </span>
          </label>
          <input style={s.input} value={cfg.conn_name||""
          }
            placeholder="e.g. NAT_DB"
            onChange={e=>set("conn_name", e.target.value)} />
        </div>
      )}

      {/* Manual connection fields */}
      {connMode === "manual" && (
        <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 1fr 1fr", gap:8 }}>
            <div><label style={s.label}>Host <span style={{color:"#e53935"}}>*</span></label>
              <input style={s.input} value={cfg.host||""} placeholder="localhost"
                onChange={e=>set("host", e.target.value)} /></div>
            <div><label style={s.label}>Port</label>
              <input style={s.input} value={cfg.port||"5432"} placeholder="5432"
                onChange={e=>set("port", e.target.value)} /></div>
            <div><label style={s.label}>Database <span style={{color:"#e53935"}}>*</span></label>
              <input style={s.input} value={cfg.database||""} placeholder="his_db"
                onChange={e=>set("database", e.target.value)} /></div>
            <div><label style={s.label}>Username <span style={{color:"#e53935"}}>*</span></label>
              <input style={s.input} value={cfg.user||""} placeholder="postgres"
                onChange={e=>set("user", e.target.value)} /></div>
          </div>
          <div><label style={s.label}>Password <span style={{color:"#e53935"}}>*</span></label>
            <input style={{ ...s.input }} type="password" value={cfg.password||""} placeholder="••••••••"
              onChange={e=>set("password", e.target.value)} /></div>
        </div>
      )}

      {/* SQL */}
      <div>
        <label style={s.label}>SQL Query <span style={{color:"#e53935"}}>*</span>
          <span style={{fontWeight:400, color:"#8a96a8", marginLeft:6}}>
            — returns first row, maps each column to a variable
          </span>
        </label>
        <textarea style={{ ...s.input, height:68, resize:"vertical",
          fontFamily:"'IBM Plex Mono',monospace", fontSize:12, lineHeight:1.5 }}
          value={cfg.query||""}
          placeholder={"SELECT mrn, full_name, status FROM patients\nWHERE id = '{{patient_id}}'\nLIMIT 1"}
          onChange={e=>set("query", e.target.value)} />
        <div style={{ fontSize:11, color:"#6b7280", marginTop:3 }}>
          💡 Use <code style={{background:"#dcfce7", padding:"1px 5px", borderRadius:3,
            fontFamily:"'IBM Plex Mono',monospace"}}>{'{{variable_name}}'}</code> in the query.
          First row returned is mapped to variables below.
        </div>
      </div>

      {/* Column → Variable mappings */}
      <div>
        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:8 }}>
          <label style={{ ...s.label, margin:0 }}>Column → Variable Mappings</label>
          <button onClick={addMapping}
            style={{ ...s.btn("ghost", true), fontSize:11, padding:"3px 10px",
              borderColor:"#16a34a", color:"#16a34a" }}>+ Add</button>
        </div>
        {/* Header row */}
        <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 32px",
          gap:6, marginBottom:4 }}>
          <div style={{ fontSize:11, fontWeight:700, color:"#6b7280",
            textTransform:"uppercase" }}>Column name (from SELECT)</div>
          <div style={{ fontSize:11, fontWeight:700, color:"#6b7280",
            textTransform:"uppercase" }}>Store into variable</div>
          <div/>
        </div>
        {mappings.map((m, idx) => (
          <div key={idx} style={{ display:"grid", gridTemplateColumns:"1fr 1fr 32px",
            gap:6, marginBottom:6, alignItems:"center" }}>
            <input style={{ ...s.input, margin:0, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
              value={m.column||""}
              placeholder={`col ${idx} e.g. mrn`}
              onChange={e=>setMapping(idx, "column", e.target.value)} />
            <input style={{ ...s.input, margin:0, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
              value={m.variable||""}
              placeholder={`e.g. patient_mrn`}
              onChange={e=>setMapping(idx, "variable", e.target.value)} />
            <button onClick={()=>removeMapping(idx)}
              disabled={mappings.length === 1}
              style={{ background:"none", border:"none", cursor:"pointer",
                color: mappings.length===1 ? "#d1d5db" : "#e53935", fontSize:16 }}>×</button>
          </div>
        ))}
        <div style={{ fontSize:11, color:"#6b7280", marginTop:4 }}>
          💡 Column name must match your SELECT alias exactly (case-sensitive).
          Leave column blank to use positional index (col 0, col 1...).
        </div>
      </div>

      {/* Preview */}
      {mappings.filter(m=>m.variable).length > 0 && (
        <div style={{ background:"#dcfce7", borderRadius:6, padding:"8px 12px", fontSize:11 }}>
          <div style={{ fontWeight:700, color:"#166534", marginBottom:4 }}>After this step you can use:</div>
          {mappings.filter(m=>m.variable).map((m,i)=>(
            <div key={i} style={{ fontFamily:"'IBM Plex Mono',monospace", color:"#166534" }}>
              <span style={{ color:"#15803d", fontWeight:700 }}>{"{{"}{m.variable}{"}}"}</span>
              {m.column ? ` ← column "${m.column}"` : ` ← column ${i}`}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

// ─── DB VALIDATE STEP FORM ────────────────────────────────────────────────────
const DB_ASSERT_TYPES = [
  { value: "equals",    label: "Cell value equals" },
  { value: "contains",  label: "Cell value contains" },
  { value: "row_count", label: "Row count equals" },
  { value: "store",     label: "Store result as variable" },
];

function DbValidateStepForm({ config, onChange }) {
  const cfg = (typeof config === "object" && config !== null) ? config : {};
  const set = (k, v) => onChange({ ...cfg, [k]: v });
  const assertType = cfg.assert_type || "equals";
  const isStore    = assertType === "store";
  const isRowCount = assertType === "row_count";
  const connMode   = cfg.conn_mode || "saved"; // "saved" | "manual"

  const summaryLine = () => {
    if (!cfg.query) return null;
    if (isStore)    return `Store first result into {{${cfg.store_as||"?"}}}`;
    if (isRowCount) return `Assert query returns exactly ${cfg.expected||"?"} row(s)`;
    return `Assert [${cfg.column||"first column"}] ${assertType} "${cfg.expected||"?"}"`;
  };

  return (
    <div style={{ marginTop:10, background:"#f0f7ff", border:"1px solid #bdd7f5",
      borderRadius:8, padding:14, display:"flex", flexDirection:"column", gap:12 }}>

      {/* Header */}
      <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between" }}>
        <div style={{ fontSize:12, fontWeight:700, color:"#1a6fc4" }}>🗄️ DB Validation (PostgreSQL)</div>
        <span style={{ fontSize:11, background:"#e3f0fb", color:"#1a6fc4",
          padding:"2px 8px", borderRadius:4, fontWeight:600 }}>🐘 PostgreSQL</span>
      </div>

      {/* Connection mode toggle */}
      <div style={{ display:"flex", gap:0, border:"1px solid #bdd7f5", borderRadius:6, overflow:"hidden", width:"fit-content" }}>
        {[["saved","📋 Saved Connection"],["manual","✏️ Enter Manually"]].map(([mode, label])=>(
          <button key={mode} onClick={()=>set("conn_mode", mode)}
            style={{ padding:"5px 14px", fontSize:12, fontWeight:600, border:"none", cursor:"pointer",
              background: connMode===mode ? "#1a6fc4" : "#f0f7ff",
              color: connMode===mode ? "#fff" : "#1a6fc4" }}>
            {label}
          </button>
        ))}
      </div>

      {/* Saved connection name */}
      {connMode === "saved" && (
        <div>
          <label style={s.label}>Connection Name <span style={{color:"#e53935"}}>*</span>
            <span style={{fontWeight:400, color:"#8a96a8", marginLeft:6}}>
              — add connections in 🗄️ DB Connections page
            </span>
          </label>
          <input style={s.input} value={cfg.conn_name||""}
            placeholder="e.g. NAT_DB  (exact name from DB Connections)"
            onChange={e=>set("conn_name", e.target.value)} />
        </div>
      )}

      {/* Manual connection fields */}
      {connMode === "manual" && (
        <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 1fr 1fr", gap:8 }}>
            <div>
              <label style={s.label}>Host <span style={{color:"#e53935"}}>*</span></label>
              <input style={s.input} value={cfg.host||""} placeholder="localhost"
                onChange={e=>set("host", e.target.value)} />
            </div>
            <div>
              <label style={s.label}>Port</label>
              <input style={s.input} value={cfg.port||"5432"} placeholder="5432"
                onChange={e=>set("port", e.target.value)} />
            </div>
            <div>
              <label style={s.label}>Database <span style={{color:"#e53935"}}>*</span></label>
              <input style={s.input} value={cfg.database||""} placeholder="his_db"
                onChange={e=>set("database", e.target.value)} />
            </div>
            <div>
              <label style={s.label}>Username <span style={{color:"#e53935"}}>*</span></label>
              <input style={s.input} value={cfg.user||""} placeholder="postgres"
                onChange={e=>set("user", e.target.value)} />
            </div>
          </div>
          <div>
            <label style={s.label}>Password <span style={{color:"#e53935"}}>*</span></label>
            <input style={{ ...s.input }} type="password" value={cfg.password||""} placeholder="••••••••"
              onChange={e=>set("password", e.target.value)} />
          </div>
        </div>
      )}

      {/* SQL */}
      <div>
        <label style={s.label}>SQL Query <span style={{color:"#e53935"}}>*</span></label>
        <textarea style={{ ...s.input, height:68, resize:"vertical",
          fontFamily:"'IBM Plex Mono',monospace", fontSize:12, lineHeight:1.5 }}
          value={cfg.query||""}
          placeholder={"SELECT status FROM patients\nWHERE mrn = '{{mrn}}'\nLIMIT 1"}
          onChange={e=>set("query", e.target.value)} />
        <div style={{ fontSize:11, color:"#6b82a8", marginTop:3 }}>
          💡 Use <code style={{background:"#dbeafe", padding:"1px 5px", borderRadius:3,
            fontFamily:"'IBM Plex Mono',monospace"}}>{"{{variable_name}}"}</code> anywhere in the query
        </div>
      </div>

      {/* Validation type + expected value in one row */}
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10 }}>
        <div>
          <label style={s.label}>Validation Type</label>
          <select style={s.input} value={assertType}
            onChange={e=>set("assert_type", e.target.value)}>
            {DB_ASSERT_TYPES.map(a=><option key={a.value} value={a.value}>{a.label}</option>)}
          </select>
        </div>

        {!isStore && (
          <div>
            <label style={s.label}>
              {isRowCount ? "Expected Row Count" : "Expected Value"}
            </label>
            <input style={s.input}
              value={cfg.expected||""}
              placeholder={isRowCount ? "1" : "e.g. Registered"}
              onChange={e=>set("expected", e.target.value)} />
          </div>
        )}

        {isStore && (
          <div>
            <label style={s.label}>Save result to variable</label>
            <input style={s.input} value={cfg.store_as||""}
              placeholder="e.g. patient_status"
              onChange={e=>set("store_as", e.target.value)} />
          </div>
        )}
      </div>

      {/* Column hint — only for cell-value checks */}
      {!isStore && !isRowCount && (
        <div>
          <label style={s.label}>
            Column name
            <span style={{fontWeight:400, color:"#8a96a8", marginLeft:6}}>
              (optional — defaults to first column returned)
            </span>
          </label>
          <input style={s.input} value={cfg.column||""}
            placeholder="e.g. status"
            onChange={e=>set("column", e.target.value)} />
        </div>
      )}

      {/* Live preview */}
      {summaryLine() && (
        <div style={{ fontSize:11, color:"#1a6fc4", background:"#dbeafe",
          border:"1px solid #bdd7f5", padding:"8px 12px", borderRadius:6,
          fontFamily:"'IBM Plex Mono',monospace" }}>
          ▶ {summaryLine()}
        </div>
      )}
    </div>
  );
}

function VariablesPanel({ variables, onChange }) {
  const [showAdd,   setShowAdd]   = useState(false);
  const [editIdx,   setEditIdx]   = useState(null);
  const [newVar,    setNewVar]    = useState({ name:"", type:"fixed", config:"" });

  // Data table state for inline editing
  const [dtCols,  setDtCols]  = useState([]);
  const [dtRow,   setDtRow]   = useState([]);

  const initDT = (v) => {
    setDtCols(v?.config?.columns || ["col1"]);
    setDtRow(v?.config?.row     || [""]);
  };

  const setDTColCount = (n) => {
    const count = Math.max(1, Math.min(10, +n||1));
    const nc = Array(count).fill("").map((_,i) => dtCols[i]||`col${i+1}`);
    const nr = Array(count).fill("").map((_,i) => dtRow[i]||"");
    setDtCols(nc); setDtRow(nr);
  };

  //const updateVar = (i, field, value) => {
    //const updated = variables.map((v, idx) =>
    //  idx === i ? { ...v, [field]: value } : v
   // );
   // onChange(updated);
  //};

  const addVar = () => {
    if (newVar.type === "data_table") {
      // Use dtCols if defined, otherwise fall back to variable name as single column
      const cols = dtCols.length ? dtCols : (newVar.name.trim() ? [newVar.name.trim()] : ["col1"]);
      const rows = dtRow.length  ? dtRow  : [""];
      const newVars = cols.map((col, ci) => ({
        name:   (col||"").trim() || `col${ci+1}`,
        type:   "data_table",
        config: { value: rows[ci]||"", col_index: ci },
      })).filter(v => v.name);
      if (!newVars.length) return;
      onChange([...(variables||[]), ...newVars]);
      setDtCols(["col1","col2"]); setDtRow(["",""]);
    } else {
      if (!newVar.name.trim()) return;
      onChange([...(variables||[]), { ...newVar, name: newVar.name.trim() }]);
    }
    setNewVar({ name:"", type:"fixed", config:"" });
    setShowAdd(false);
  };

  const removeVar = (i) => onChange((variables||[]).filter((_,idx)=>idx!==i));
  const updateVar = (i, updates) => {
    const nv = [...(variables||[])];
    nv[i] = { ...nv[i], ...updates };
    onChange(nv);
  };

  const typeInfo = (type) => VAR_TYPES.find(v=>v.value===type);

  return (
    <div style={{ background:"#ffffff", border:"1px solid #e2e6ed", borderRadius:10, padding:16, marginBottom:16 }}>
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:12 }}>
        <div style={{ fontWeight:700, fontSize:13, color:"#1a6fc4" }}>
          ⚙️ Variables
          <span style={{ marginLeft:8, fontSize:11, color:"#8a96a8", fontWeight:400 }}>use {"{{"+"var_name"+"}}"} in step values</span>
        </div>
        <button style={s.btn("purple", true)} onClick={()=>{
          setShowAdd(v=>!v);
          setDtCols(["col1","col2"]); setDtRow(["",""]);
          setNewVar({ name:"", type:"fixed", config:"" });
        }}>+ Add Variable</button>
      </div>

      {/* Existing variables */}
      {(variables||[]).length > 0 && (
        <div style={{ marginBottom: showAdd ? 12 : 0 }}>
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 1fr auto", gap:6, marginBottom:6 }}>
            {["Name","Type","Config",""].map(h=><div key={h} style={{ fontSize:10, color:"#8a96a8", fontWeight:700, textTransform:"uppercase", letterSpacing:"0.06em" }}>{h}</div>)}
          </div>
          {(variables||[]).map((v,i) => (
            <div key={i} style={{ marginBottom:8 }}>
              <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 1fr auto", gap:6, alignItems:"center" }}>
                {/* Editable Name */}
                <input
                  style={{ fontFamily:"'IBM Plex Mono',monospace", fontSize:12, color:"#f59e0b",
                    background:"#fef9e7", padding:"4px 8px", borderRadius:5,
                    border:"1px solid #f59e0b", outline:"none", width:"100%" }}
                  value={v.name}
                  onChange={e=>updateVar(i,{name:e.target.value.replace(/\s/g,"_")})}
                  placeholder="variable_name"
                />
                {/* Editable Type */}
                <select
                  style={{ ...s.input, fontSize:12, margin:0 }}
                  value={v.type}
                  onChange={e=>updateVar(i,{type:e.target.value, config:e.target.value==="db_query"?{}:""})}
                >
                  {VAR_TYPES.map(t=><option key={t.value} value={t.value}>{t.label}</option>)}
                </select>
                {/* Editable Config */}
                {v.type==="db_query" || v.type==="data_table" ? (
                  <div style={{ fontSize:11, color:"#8a96a8", fontStyle:"italic" }}>
                    {v.type==="db_query" ? "See DB form below" : (v.config?.value||"—")}
                  </div>
                ) : (
                  <input
                    style={{ ...s.input, fontSize:12, margin:0,
                      fontFamily:"'IBM Plex Mono',monospace" }}
                    value={v.config||""}
                    onChange={e=>updateVar(i,{config:e.target.value})}
                    placeholder={typeInfo(v.type)?.hint||"value"}
                  />
                )}
                <button style={{ ...s.btn("danger",true), padding:"3px 8px", fontSize:11 }} onClick={()=>removeVar(i)}>✕</button>
              </div>
              {v.type === "db_query" && (
                <DbQueryForm config={v.config||{}} onChange={cfg=>updateVar(i,{config:cfg})} />
              )}
            </div>
          ))}
        </div>
      )}

      {/* Add new variable form */}
      {showAdd && (
        <div style={{ background:"#ffffff", border:"1px solid #cdd3dc", borderRadius:8, padding:14 }}>
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 1fr auto", gap:10, alignItems:"flex-end" }}>
            <div>
              <label style={s.label}>Variable Name</label>
              <input style={{ ...s.input, fontFamily:"'IBM Plex Mono',monospace" }} value={newVar.name} onChange={e=>setNewVar(v=>({...v,name:e.target.value.replace(/\s/g,"_")}))} placeholder="patient_mrn" />
            </div>
            <div>
              <label style={s.label}>Type</label>
              <select style={s.input} value={newVar.type} onChange={e=>{ 
                  const t=e.target.value;
                  setNewVar(v=>({...v,type:t,config:t==="db_query"?{}:""}));
                  if(t==="data_table"){ setDtCols(["col1","col2"]); setDtRow(["",""]); }
                }}>
                {VAR_TYPES.map(t=><option key={t.value} value={t.value}>{t.label}</option>)}
              </select>
            </div>
            {newVar.type !== "db_query" && newVar.type !== "data_table" && (
              <div>
                <label style={s.label}>{typeInfo(newVar.type)?.hint||"Config"}</label>
                <input style={s.input} value={newVar.config||""} onChange={e=>setNewVar(v=>({...v,config:e.target.value}))}
                  placeholder={typeInfo(newVar.type)?.hint||""} />
              </div>
            )}
            {(newVar.type === "db_query" || newVar.type === "data_table") && <div />}
            <div style={{ display:"flex", gap:6 }}>
              <button style={s.btn("success",true)} onClick={addVar}>Add</button>
              <button style={s.btn("ghost",true)} onClick={()=>setShowAdd(false)}>✕</button>
            </div>
          </div>

          {/* Dynamic hint */}
          {newVar.type === "dynamic" && (
            <div style={{ marginTop:8, fontSize:12, background:"#fffbeb",
              border:"1px solid #fcd34d", borderRadius:6, padding:"7px 10px", color:"#92400e" }}>
              💡 Add <code>$</code> at end: <code>123$</code> → random number · <code>Suresh$</code> → random name · <code>test@x.com$</code> → random email
            </div>
          )}

          {/* DB Query form */}
          {newVar.type === "db_query" && (
            <DbQueryForm config={newVar.config||{}} onChange={cfg=>setNewVar(v=>({...v,config:cfg}))} />
          )}

          {/* Data Table — single row */}
          {newVar.type === "data_table" && (
            <div style={{ marginTop:10, background:"#f5f3ff", border:"1px solid #c4b5fd", borderRadius:8, padding:"12px 14px" }}>
              <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:10 }}>
                <span style={{ fontSize:12, fontWeight:700, color:"#6b46c1" }}>Number of Columns:</span>
                <input type="number" min="1" max="10" value={dtCols.length||2}
                  onChange={e=>setDTColCount(e.target.value)}
                  style={{ ...s.input, width:60, margin:0 }} />
                <span style={{ fontSize:11, color:"#8a96a8" }}>Each column = one variable</span>
              </div>
              <table style={{ borderCollapse:"collapse", width:"100%", fontSize:12 }}>
                <thead>
                  <tr style={{ background:"#ede9fe" }}>
                    <th style={{ padding:"4px 8px", border:"1px solid #c4b5fd", fontSize:11, color:"#6b46c1", width:28 }}>#</th>
                    {(dtCols.length ? dtCols : ["col1","col2"]).map((col,ci)=>(
                      <th key={ci} style={{ padding:"3px", border:"1px solid #c4b5fd", minWidth:90 }}>
                        <input value={col} onChange={e=>{ const nc=[...dtCols]; nc[ci]=e.target.value; setDtCols(nc); }}
                          placeholder={`col${ci+1}`}
                          style={{ ...s.input, margin:0, fontSize:11, padding:"3px 6px", fontWeight:700,
                            color:"#6b46c1", background:"transparent", border:"none", outline:"none", width:"100%" }} />
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td style={{ padding:"3px 8px", border:"1px solid #c4b5fd", color:"#9ca3af", fontSize:11, textAlign:"center" }}>1</td>
                    {(dtCols.length ? dtCols : ["col1","col2"]).map((_,ci)=>(
                      <td key={ci} style={{ padding:"2px", border:"1px solid #c4b5fd" }}>
                        <input value={(dtRow&&dtRow[ci])||""}
                          onChange={e=>{ const nr=[...(dtRow||[])]; nr[ci]=e.target.value; setDtRow(nr); }}
                          placeholder="value... (add $ for dynamic)"
                          style={{ ...s.input, margin:0, fontSize:12, padding:"4px 6px",
                            border:"none", outline:"none", width:"100%", background:"transparent", minWidth:70 }} />
                      </td>
                    ))}
                  </tr>
                </tbody>
              </table>
              {dtCols.filter(c=>c.trim()).length>0 && (
                <div style={{ fontSize:11, color:"#6b46c1", marginTop:7 }}>
                  Variables: {dtCols.filter(c=>c.trim()).map(c=>(
                    <code key={c} style={{ background:"#ede9fe", padding:"1px 5px", borderRadius:3, marginRight:5 }}>{"{{"+c+"}}"}</code>
                  ))}
                </div>
              )}
              <div style={{ fontSize:11, color:"#8a96a8", marginTop:3 }}>
                💡 Add <code>$</code> to any value for auto-generation (e.g. <code>Suresh$</code>, <code>123$</code>)
              </div>
            </div>
          )}

          {newVar.name && newVar.type !== "data_table" && (
            <div style={{ marginTop:10, fontSize:12, color:"#8a96a8" }}>
              Use as: <span style={{ color:"#f59e0b", fontFamily:"'IBM Plex Mono',monospace" }}>{"{{"+newVar.name+"}}"}</span>
            </div>
          )}
        </div>
      )}

      {(variables||[]).length===0 && !showAdd && (
        <div style={{ fontSize:12, color:"#8a96a8", textAlign:"center", padding:"8px 0" }}>
          No variables yet — add one to use dynamic data in your steps
        </div>
      )}
    </div>
  );
}

// ─── SCRIPT ↔ STEPS CONVERTER ────────────────────────────────────────────────
// ─── SCRIPT CONVERTER ─────────────────────────────────────────────────────────
function stepsToScript(steps, variables, testName) {
  const varBlock = (variables||[]).length > 0 ? (variables||[]).map(v => {
    if (v.type==="fixed")         return `    "${v.name}": "${v.config}"`;
    if (v.type==="random_email")  return `    "${v.name}": f"{v.config or 'user'}_{random_str(8)}@test.com"`;
    if (v.type==="random_number") return `    "${v.name}": str(random.randint(${(v.config||"1-100").replace("-",", ")}))`;
    if (v.type==="random_text")   return `    "${v.name}": random_str(${v.config||8})`;
    if (v.type==="timestamp")     return `    "${v.name}": datetime.now().strftime("${v.config||"%Y%m%d_%H%M%S"}")`;
    if (v.type==="from_list")     return `    "${v.name}": random.choice(["${(v.config||"").split(",").map(x=>x.trim()).join('","')}"])`;
    return `    "${v.name}": ""  # ${v.type}`;
  }).join(",\n") : "";

  const stepLines = (steps||[]).map((step, i) => {
    // Use get_locator-friendly format — preserve special selectors like get_by_role(...)
    const fmtSel = (s) => {
      if (!s) return "";
      // Already a get_by_* expression — use as-is
      if (s.startsWith("get_by_")) return s;
      // Has inner double quotes — wrap in single quotes
      if (s.includes('"')) return `'${s}'`;
      return `"${s}"`;
    };
    const fmtVal = (v) => {
      if (!v) return "";
      if (v.includes('"')) return `'${v}'`;
      return `"${v}"`;
    };
    const sel = fmtSel(step.selector);
    const val = fmtVal(step.value);
    const to  = step.timeout  ? `, timeout=${step.timeout}` : "";
    switch(step.action) {
      case "navigate":          return `    page.goto(${fmtVal(step.value)})`;
      case "click":             return sel.startsWith("get_by_") ? `    page.${sel}.click()` : `    page.click(${sel}${to})`;
      case "type":              return sel.startsWith("get_by_") ? `    page.${sel}.fill(${val})` : `    page.fill(${sel}, ${val}${to})`;
      case "clear":             return sel.startsWith("get_by_") ? `    page.${sel}.fill("")` : `    page.fill(${sel}, "")`;
      case "select":            return `    page.select_option(${sel}, ${val})`;
      case "search_select": {
        const st   = step.search_text ? step.search_text : (step.value || "");
        const pick = step.value || "";
        const wms  = step.wait_ms  ? `  # wait_ms=${step.wait_ms}` : "";
        // Emit a parseable comment that codeToSteps can reconstruct exactly
        return `    # search_select: ${step.selector || ""} search="${st}" pick="${pick}"${wms}
    # (run by ATHMA runner — search & select autocomplete/ng-select)`;
      }
      case "check":             return `    page.check(${sel})`;
      case "hover":             return `    page.hover(${sel})`;
      case "press":             return !step.selector || step.selector.toLowerCase()==="body" ? `    page.keyboard.press(${val})` : `    page.press(${sel}, ${val})`;
      case "wait":              return `    time.sleep(${step.value}/1000)`;
      case "wait_for_selector": return `    page.wait_for_selector(${sel}${to})`;
      case "wait_for_url":      return `    page.wait_for_url(${val}${to})`;
      case "assert_text":       return `    assert ${val} in page.locator(${sel}).inner_text()`;
      case "assert_visible":    return `    assert page.locator(${sel}).is_visible()`;
      case "assert_url":        return `    assert ${val} in page.url`;
      case "assert_title":      return `    assert ${val} in page.title()`;
      case "assert_value":      return `    assert page.input_value(${sel}) == ${val}`;
      case "screenshot":        return `    page.screenshot(path=f"screenshot_step_${i+1}.png")`;
      case "scroll":            return `    page.evaluate(f"window.scrollTo(0, ${step.value||0})")`;
      case "execute_script":    return `    page.evaluate(${val})`;
      case "db_validate":       return `    # DB Validate: ${step.db_config?.query||"(query)"}`;
      default:                  return `    # ${step.action}: ${step.selector||""} ${step.value||""}`;
    }
  }).join("\n");

  return `# Test: ${testName||"Unnamed Test"}
# Generated by ATHMA Automation Tool
# ─────────────────────────────────────────────────────────────────────
from playwright.sync_api import sync_playwright
import time, random, string
from datetime import datetime

def random_str(n): return "".join(random.choices(string.ascii_letters, k=n))

${varBlock ? "# Variables\nvariables = {\n" + varBlock + "\n}" : ""}

def run(page):
${stepLines || "    pass  # No steps yet"}

# ─── Runner ───────────────────────────────────────────────────────────────────
# Append new steps below — they will be imported back into ATHMA on Save
# Use exact Playwright syntax. Supported actions:
#   page.goto(url)  page.click(sel)  page.fill(sel, val)  page.select_option(sel, val)
#   page.check(sel)  page.hover(sel)  page.press(sel, key)  time.sleep(seconds)
#   page.wait_for_selector(sel)  page.wait_for_url(url)  page.screenshot(path=...)
#   page.evaluate(js)  assert val in page.locator(sel).inner_text()
#   assert val in page.url  assert val in page.title()
`;
}
// ── Playwright JS locator → CSS selector helper ─────────────────────────────
// ── Smart Selector Simplifier (module-level, used by Script Editor + Steps) ──
const _KNOWN_PATTERNS = [
  [/app-root[^"']*form[^"']*button/,                               'button[type="submit"]'],
  [/athma-tabs-header[^"']*ul[^"']*li[^"']*>\s*button/,           'athma-tabs-header li.si-container > button'],
  [/athma-page-header[^"']*ul[^"']*li[^"']*>\s*button/,           'athma-tabs-header li > button'],
  [/jhi-dispense-patient-search[^"']*tbody[^"']*td[^"']*>\s*span/, 'jhi-dispense-patient-search tbody tr td span'],
  [/jhi-dispense-patient-search[^"']*tbody[^"']*td/,              'jhi-dispense-patient-search tbody tr td'],
  [/ng-select[^"']*input/,                                        'ng-select input'],
  [/ng-dropdown-panel[^"']*span/,                                 '.ng-dropdown-panel .ng-option'],
  [/ng-dropdown-panel[^"']*div/,                                  '.ng-dropdown-panel .ng-option'],
];
const _STRIP_RE = [
  /^app-root\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*jhi-home\s*>\s*/,
  /^app-root\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*jhi-sidebar\s*>\s*/,
  /^app-root\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*/,
  /^app-root\s*>\s*div\s*>\s*section\s*>\s*/,
  /^jhi-main\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*/,
  /^jhi-main\s*>\s*div\s*>\s*section\s*>\s*/,
  /^body\s*>\s*/,
];
const _INTERACTIVE = new Set(['button','input','select','textarea','a','td','th','tr','span','li']);
function smartSel(sel) {
  if (!sel) return sel;
  if (/^#[\w-]+$/.test(sel)) return sel;
  if (sel.startsWith('[') || sel.startsWith('get_by')) return sel;
  if (!sel.includes('>')) return sel;
  const hasNth = sel.includes('nth-of-type') || sel.includes('nth-child');
  if (sel.split('>').length <= 3 && !hasNth) return sel;

  // Sidebar patterns — detect from class names or known structure
  // div.sidebar-mainmenu-item > span — sidebar module toggle
  // div.sb-subitem > ul > li > a — sidebar sub-menu link
  if (sel.includes('sidebar-mainmenu-item') || sel.includes('sb-subitem') ||
      sel.includes('sb-icon') || sel.includes('athma-') ||
      sel.includes('jhi-sidebar')) {
    const iconMatch = sel.match(/athma-[\w-]+-module-icon/);
    if (iconMatch) return `.${iconMatch[0]}`;
    const sbMatch = sel.match(/sb-icon[\w\s.-]*athma-[\w-]+/);
    if (sbMatch) return `.${sbMatch[0].trim().split(' ').pop()}`;
    let s = sel;
    for (const re of _STRIP_RE) s = s.replace(re, '');
    const segs = s.split('>').map(p => p.trim()).filter(Boolean);
    return segs.slice(-3).join(' > ');
  }

  // Short nth-based selectors from extension recorder — map to stable module icon class
  // div > div:nth-of-type(N) > span — sidebar section toggle, N maps to module icon
  if (sel.match(/div\s*>\s*div:nth-of-type\((\d+)\)\s*>\s*span$/) && sel.split('>').length <= 4) {
    const nth = sel.match(/nth-of-type\((\d+)\)/);
    if (nth) {
      // Map position to module icon class based on sidebar order
      const SIDEBAR_MODULES = [
        null,                                    // 0 = unused
        'athma-my-dashboard-module-icon',        // 1  Dashboard
        'athma-inventory-module-icon',           // 2  Inventory
        'athma-pharmacy-module-icon',            // 3  Pharmacy
        'athma-ambulatory-module-icon',          // 4  Ambulatory
        'athma-hsm-module-icon',                 // 5  HSM
        'athma-ehr-module-icon',                 // 6  EHR
        'athma-adt-module-icon',                 // 7  ADT
        'athma-billing-module-icon',             // 8  Billing
        'athma-ot-module-icon',                  // 9  OTM
        'athma-medical-record-module-icon',      // 10 Medical Records
        'athma-blood-bank-module-icon',          // 11 Blood Bank
        'athma-lis-module-icon',                 // 12 LIS
        'athma-asetu-module-icon',               // 13 ABDM
        'athma-ris-module-icon',                 // 14 RIS
        'athma-srm-module-icon',                 // 15 SRM
        'athma-prm-module-icon',                 // 16 PRM
        'athma-hcx-module-icon',                 // 17 HCX
        'athma-purchase-module-icon',            // 18 Purchase
        'athma-sales-module-icon',               // 19 Sale
        'athma-clinical-research-module-icon',   // 20 Clinical Research
        'athma-ims-module-icon',                 // 21 IMS
        'athma-dms-module-icon',                 // 22 Document Management
        'athma-dietary-module-icon',             // 23 Dietary
        'athma-sms-module-icon',                 // 24 SMS
        'athma-spm-module-icon',                 // 25 SPM
        'athma-cpm-module-icon',                 // 26 CPM
        'athma-administration-module-icon',      // 27 Administration
      ];
      const icon = SIDEBAR_MODULES[parseInt(nth[1])];
      if (icon) return `.${icon}`;
    }
    return sel;
  }
  // ul > li:nth-of-type(N) > button — tabs header button (New Dispense etc)
  if (sel.match(/^ul\s*>\s*li:nth-of-type\(\d+\)\s*>\s*button$/) && sel.split('>').length <= 4) {
    return 'athma-tabs-header li.si-container > button';
  }
  // ul > li:nth-of-type(N) > a — sidebar sub-menu link — keep position, it's meaningful
  if (sel.match(/^ul\s*>\s*li:nth-of-type\(\d+\)\s*>\s*a$/) && sel.split('>').length <= 4) {
    return sel;
  }

  for (const [re, replacement] of _KNOWN_PATTERNS) {
    if (re.test(sel)) return replacement;
  }
  let s = sel;
  for (const re of _STRIP_RE) s = s.replace(re, '');
  const segs = s.split('>').map(p => p.trim()
    .replace(/:nth-of-type\(\d+\)/g, '')
    .replace(/:nth-child\(\d+\)/g, '')
    .trim()
  ).filter(Boolean);
  const meaningful = segs.filter(seg => {
    const base = seg.split(/[.#[:/]/)[0].trim();
    return seg.includes('.') || seg.includes('#') || seg.includes('[') ||
           base.includes('-') || _INTERACTIVE.has(base);
  });
  if (meaningful.length) return meaningful.slice(-3).join(' > ');
  return segs.slice(-3).join(' > ') || sel;
}

function playwrightLocatorToSelector(expr) {
  let m;
  // getByRole('button', { name: 'Sign in' })
  if ((m = expr.match(/getByRole\(['"]button['"],\s*\{[^}]*name:\s*['"]([^'"]+)['"]/)))
    return `get_by_role("button", name="${m[1]}")`;
  // getByRole('link', { name: '...' })
  if ((m = expr.match(/getByRole\(['"]link['"],\s*\{[^}]*name:\s*['"]([^'"]+)['"]/)))
    return `get_by_role("link", name="${m[1]}")`;
  // getByRole('textbox', { name: '...' })
  if ((m = expr.match(/getByRole\(['"]textbox['"],\s*\{[^}]*name:\s*['"]([^'"]+)['"]/)))
    return `[aria-label="${m[1]}"]`;
  // getByRole('combobox').nth(N)
  if ((m = expr.match(/getByRole\(['"]combobox['"]\)\.nth\((\d+)\)/)))
    return `select:nth-of-type(${parseInt(m[1])+1})`;
  // getByRole('combobox')
  if (expr.includes("getByRole('combobox')") || expr.includes('getByRole("combobox")'))
    return "select";
  // getByRole('listbox', { name: '...' })
  if ((m = expr.match(/getByRole\(['"]listbox['"],\s*\{[^}]*name:\s*['"]([^'"]+)['"]/)))
    return `[aria-label="${m[1]}"] ng-select, [aria-label="${m[1]}"] select`;
  // getByText('...', { exact: true })
  if ((m = expr.match(/getByText\(['"]([^'"]+)['"],\s*\{\s*exact:\s*true\s*\}/)))
    return `text="${m[1]}"`;
  // getByText('...')
  if ((m = expr.match(/getByText\(['"]([^'"]+)['"]\)/)))
    return `text=${m[1]}`;
  // getByLabel('...')
  if ((m = expr.match(/getByLabel\(['"]([^'"]+)['"]\)/)))
    return `[aria-label="${m[1]}"]`;
  // getByPlaceholder('...')
  if ((m = expr.match(/getByPlaceholder\(['"]([^'"]+)['"]\)/)))
    return `[placeholder="${m[1]}"]`;
  // locator('...').filter({ hasText: '...' })
  if ((m = expr.match(/locator\(['"]([^'"]+)['"]\)\.filter\(\{[^}]*hasText:\s*['"]([^'"]+)['"]/)))
    return `${m[1]}:has-text("${m[2]}")`;
  // locator('.selector > .child > .el')
  if ((m = expr.match(/locator\(['"]([^'"]+)['"]\)/)))
    return m[1];
  return expr;
}

function scriptToSteps(script) {
  const steps = [];
  const isJS = script.includes("await page.") || script.includes("async ({") || script.includes("getByRole") || script.includes("const { chromium }") || script.includes("chromium.launch");

  if (isJS) {
    // Collapse continuation lines (e.g. chained .fill after .click on next line)
    const collapsed = script.replace(/\r\n/g,"\n").replace(/\n\s+\./g,".");
    const lines = collapsed.split("\n");

    for (const raw of lines) {
      const line = raw.trim().replace(/^await\s+/,"");
      // Skip JS boilerplate lines generated by playwright codegen --target javascript
      if (!line || line.startsWith("//") || line === "// ---------------------") continue;
      if (line.startsWith("test(") || line.startsWith("expect(")) continue;
      if (line.startsWith("import ") || line.startsWith("const {") || line.startsWith("const browser") ||
          line.startsWith("const context") || line.startsWith("const page")) continue;
      if (line.startsWith("(async") || line.startsWith("})();") || line === "});" || line === "});") continue;
      if (line.startsWith("browser.") || line.startsWith("context.") || line.startsWith("chromium.")) continue;
      if (line.includes("chromium.launch") || line.includes("newContext") || line.includes("newPage")) continue;
      if (line.includes("browser.close") || line.includes("context.close")) continue;

      let m;

      // page.goto(url)
      if ((m = line.match(/^page\.goto\(['"]([^'"]+)['"]/))) {
        steps.push({ action:"navigate", value:m[1], selector:"", timeout:30000 }); continue;
      }
      // page.waitForSelector / waitForURL
      if ((m = line.match(/^page\.waitForSelector\(['"]([^'"]+)['"]/))) {
        steps.push({ action:"wait_for_selector", selector:m[1], value:"", timeout:30000 }); continue;
      }
      if ((m = line.match(/^page\.waitForURL\(['"]([^'"]+)['"]/))) {
        steps.push({ action:"wait_for_url", value:m[1], selector:"", timeout:30000 }); continue;
      }

      // Extract locator + action — split on LAST .action( to handle nested parens
      // e.g: page.getByRole('button', { name: 'Sign in' }).click()
      //      page.getByPlaceholder('Search').fill('indent')
      const ACTIONS_RE = /\.(fill|selectOption|press|click|check|hover|type)\(([^)]*)\)\s*;?\s*$/;
      const actionMatch = line.match(ACTIONS_RE);
      if (!actionMatch) continue;
      // Everything between "page." and the matched ".action(" is the locator
      const actionStart  = line.lastIndexOf(actionMatch[0]);
      const locatorPart  = line.slice(5, actionStart); // strip "page." prefix
      const actionName   = actionMatch[1];
      const actionArg    = actionMatch[2].replace(/^['"]|['"]$/g,"");
      const selector     = playwrightLocatorToSelector(locatorPart);

      if (actionName === "fill" || actionName === "type") {
        // Skip if prev step was click on same selector (codegen click-then-fill pattern)
        const prev = steps[steps.length-1];
        if (prev && prev.action === "click" && prev.selector === selector) {
          prev.action = "type"; prev.value = actionArg; continue;
        }
        steps.push({ action:"type", selector, value:actionArg, timeout:30000 });

      } else if (actionName === "selectOption") {
        steps.push({ action:"select", selector, value:actionArg, timeout:30000 });

      } else if (actionName === "press") {
        if (actionArg === "Tab" || actionArg === "Shift+Tab") continue; // skip tab noise
        steps.push({ action:"press", selector, value:actionArg, timeout:30000 });

      } else if (actionName === "click") {
        // Skip duplicate click after type on same element
        const prev = steps[steps.length-1];
        if (prev && (prev.action === "type" || prev.action === "select") && prev.selector === selector) continue;
        steps.push({ action:"click", selector, value:"", timeout:30000 });

      } else if (actionName === "check") {
        steps.push({ action:"check", selector, value:"", timeout:30000 });

      } else if (actionName === "hover") {
        steps.push({ action:"hover", selector, value:"", timeout:30000 });
      }
    }

  } else {
    // ── Python Playwright parser (handles both old API and codegen API) ──────────
    const raw_lines = script.split("\n");
    let start = -1;
    for (let i = 0; i < raw_lines.length; i++) {
      if (raw_lines[i].includes("# Append new steps below")) { start = i+1; break; }
    }
    // For codegen output, parse from first page. line inside def run()
    const parseLines = start >= 0 ? raw_lines.slice(start) : raw_lines;

    // Helper: convert Python codegen locator to CSS selector
    const pyLocatorToSel = (expr) => {
      let m;
      // get_by_role("button", name="Sign in")
      if ((m = expr.match(/get_by_role\(["']button["'],\s*name=["']([^'"]+)["']/)))
        return `get_by_role("button", name="${m[1]}")`;
      // get_by_role("link", name="...")
      if ((m = expr.match(/get_by_role\(["']link["'],\s*name=["']([^'"]+)["']/)))
        return `get_by_role("link", name="${m[1]}")`;
      // get_by_role("textbox", name="...")
      if ((m = expr.match(/get_by_role\(["']textbox["'],\s*name=["']([^'"]+)["']/)))
        return `[aria-label="${m[1]}"]`;
      // get_by_role("combobox", name="...")
      if ((m = expr.match(/get_by_role\(["']combobox["'],\s*name=["']([^'"]+)["']/)))
        return `[aria-label="${m[1]}"] select, select[aria-label="${m[1]}"]`;
      // get_by_role("combobox")
      if (expr.includes("get_by_role(\"combobox\")") || expr.includes("get_by_role('combobox')"))
        return "select";
      // get_by_text("...", exact=True)
      if ((m = expr.match(/get_by_text\(["']([^'"]+)["'],\s*exact=True/)))
        return `:text-is("${m[1]}")`;
      // get_by_text("...")
      if ((m = expr.match(/get_by_text\(["']([^'"]+)["']\)/)))
        return `:text("${m[1]}")`;
      // get_by_label("...")
      if ((m = expr.match(/get_by_label\(["']([^'"]+)["']\)/)))
        return `[aria-label="${m[1]}"]`;
      // get_by_placeholder("...")
      if ((m = expr.match(/get_by_placeholder\(["']([^'"]+)["']\)/)))
        return `[placeholder="${m[1]}"]`;
      // locator("...").filter(has_text="...")
      if ((m = expr.match(/locator\(["']([^'"]+)["']\)\.filter\(has_text=["']([^'"]+)["']/)))
        return `${m[1]}:has-text("${m[2]}")`;
      // locator("...")
      if ((m = expr.match(/locator\(["']([^'"]+)["']\)/)))
        return m[1];
      return expr;
    };

    for (const raw of parseLines) {
      const line = raw.trim();
      if (!line || line.startsWith("#") || line.startsWith("from ") ||
          line.startsWith("import ") || line.startsWith("def ") ||
          line.startsWith("with ") || line.startsWith("browser") ||
          line.startsWith("context") || line.startsWith("playwright") ||
          line === "pass") continue;

      let m;

      // page.goto("url")
      if ((m = line.match(/^page\.goto\(["']([^'"]+)["']/))) {
        steps.push({ action:"navigate", value:m[1], selector:"", timeout:30000 }); continue;
      }
      // page.wait_for_url("...")
      if ((m = line.match(/^page\.wait_for_url\(["']([^'"]+)["']/))) {
        steps.push({ action:"wait_for_url", value:m[1], selector:"", timeout:30000 }); continue;
      }
      // page.wait_for_selector("...")
      if ((m = line.match(/^page\.wait_for_selector\(["']([^'"]+)["']/))) {
        steps.push({ action:"wait_for_selector", selector:m[1], value:"", timeout:30000 }); continue;
      }

      // ── Old API: page.click("selector"), page.fill("selector", "value") ────
      // Handles nested quotes e.g: page.click("a:has-text(\"Indent Inventory\")", timeout=30000)
      // Strategy: extract first string argument by finding the matching closing quote
      const extractFirstArg = (str) => {
        // str starts right after page.action(
        const q = str[0]; // opening quote char (" or ')
        let i = 1, result = "";
        while (i < str.length) {
          if (str[i] === "\\" && i+1 < str.length) {
            // escaped char — unescape it
            result += str[i+1];
            i += 2;
          } else if (str[i] === q) {
            // closing quote
            return result;
          } else {
            result += str[i++];
          }
        }
        return result;
      };

      const extractSecondArg = (str) => {
        // find second string arg after first closing quote + comma
        const first_q = str[0];
        let i = 1;
        while (i < str.length) {
          if (str[i] === "\\" ) { i += 2; continue; }
          if (str[i] === first_q) { i++; break; }
          i++;
        }
        // skip comma and whitespace
        while (i < str.length && (str[i] === "," || str[i] === " ")) i++;
        if (i >= str.length || (str[i] !== '"' && str[i] !== "'")) return "";
        return extractFirstArg(str.slice(i));
      };

      let oldApiM;
      // page.click("sel", ...) — extract selector handling nested escaped quotes
      if ((oldApiM = line.match(/^page\.(click|check|hover)\((["']).*/))) {
        const sel = extractFirstArg(line.slice(line.indexOf("(") + 1));
        steps.push({ action:oldApiM[1], selector:sel, value:"", timeout:30000 }); continue;
      }
      // page.fill("sel", "val")
      if ((oldApiM = line.match(/^page\.fill\((["']).*/))) {
        const argStr = line.slice(line.indexOf("(") + 1);
        const sel = extractFirstArg(argStr);
        const val = extractSecondArg(argStr);
        steps.push({ action:"type", selector:sel, value:val, timeout:30000 }); continue;
      }
      // page.select_option("sel", "val")
      if ((oldApiM = line.match(/^page\.select_option\((["']).*/))) {
        const argStr = line.slice(line.indexOf("(") + 1);
        const sel = extractFirstArg(argStr);
        const val = extractSecondArg(argStr);
        steps.push({ action:"select", selector:sel, value:val, timeout:30000 }); continue;
      }
      // page.keyboard.press(".")
      if ((oldApiM = line.match(/^page\.keyboard\.press\(["'](.+?)["']\)/))) {
        steps.push({ action:"press", selector:"body", value:oldApiM[1], timeout:30000 }); continue;
      }

      // ── Chained locator actions ────────────────────────────────────────────
      // page.<locator>.<action>(<arg>)
      // e.g: page.get_by_role("textbox", name="username").fill("admin")
      //      page.locator(".cls").click()
      const chainMatch = line.match(/^page\.(.*?)\.(fill|click|select_option|press|check|hover|type)\(([^)]*)\)/);
      if (!chainMatch) continue;

      const locExpr  = chainMatch[1];  // e.g. get_by_role("textbox", name="username")
      const action   = chainMatch[2];  // fill / click / press etc
      const argRaw   = chainMatch[3];  // "admin" / "" / "Tab"
      const argVal   = argRaw.replace(/^["']|["']$/g, "");
      const selector = pyLocatorToSel(locExpr);

      if (action === "fill" || action === "type") {
        const prev = steps[steps.length-1];
        if (prev && prev.action === "click" && prev.selector === selector) {
          prev.action = "type"; prev.value = argVal; continue;
        }
        steps.push({ action:"type", selector, value:argVal, timeout:30000 });

      } else if (action === "select_option") {
        steps.push({ action:"select", selector, value:argVal, timeout:30000 });

      } else if (action === "press") {
        if (argVal === "Tab" || argVal === "Shift+Tab") continue;
        steps.push({ action:"press", selector, value:argVal, timeout:30000 });

      } else if (action === "click") {
        const prev = steps[steps.length-1];
        if (prev && (prev.action === "type" || prev.action === "select") && prev.selector === selector) continue;
        steps.push({ action:"click", selector, value:"", timeout:30000 });

      } else if (action === "check") {
        steps.push({ action:"check", selector, value:"", timeout:30000 });

      } else if (action === "hover") {
        steps.push({ action:"hover", selector, value:"", timeout:30000 });
      }
    }
  }
  // ── POST-PROCESS: simplify selectors + inject waits ──────────────────────

  // Known Angular component patterns → stable selectors
  const KNOWN_PATTERNS = [
    [/app-root[^"']*form[^"']*button/,                               'button[type="submit"]'],
    [/app-root[^"']*jhi-sidebar[^"']*li[^"']*>\s*a/,               'jhi-sidebar li a'],
    [/app-root[^"']*jhi-sidebar[^"']*>\s*span/,                    'jhi-sidebar span'],
    [/app-root[^"']*jhi-sidebar[^"']*>\s*a/,                       'jhi-sidebar a'],
    [/athma-tabs-header[^"']*ul[^"']*li[^"']*>\s*button/,          'athma-tabs-header li.si-container > button'],
    [/athma-page-header[^"']*ul[^"']*li[^"']*>\s*button/,          'athma-tabs-header li > button'],
    [/jhi-dispense-patient-search[^"']*tbody[^"']*td[^"']*>\s*span/,'jhi-dispense-patient-search tbody tr td span'],
    [/jhi-dispense-patient-search[^"']*tbody[^"']*td/,              'jhi-dispense-patient-search tbody tr td'],
    [/ng-select[^"']*input/,                                        'ng-select input'],
    [/ng-dropdown-panel[^"']*span/,                                 '.ng-dropdown-panel .ng-option'],
    [/ng-dropdown-panel[^"']*div/,                                  '.ng-dropdown-panel .ng-option'],
  ];

  const STRIP_RE = [
    /^app-root\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*jhi-home\s*>\s*/,
    /^app-root\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*jhi-sidebar\s*>\s*/,
    /^app-root\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*/,
    /^app-root\s*>\s*div\s*>\s*section\s*>\s*/,
    /^jhi-main\s*>\s*div\s*>\s*section\s*>\s*[^>]+>\s*/,
    /^jhi-main\s*>\s*div\s*>\s*section\s*>\s*/,
    /^body\s*>\s*/,
  ];

  const INTERACTIVE = new Set(['button','input','select','textarea','a','td','th','tr','span','li']);

  function smartSel(sel) {
    if (!sel) return sel;
    if (/^#[\w-]+$/.test(sel)) return sel;
    if (sel.startsWith('[') || sel.startsWith('get_by')) return sel;
    if (!sel.includes('>')) return sel;
    const hasNth = sel.includes('nth-of-type') || sel.includes('nth-child');
    if (sel.split('>').length <= 3 && !hasNth) return sel;
    for (const [re, replacement] of KNOWN_PATTERNS) {
      if (re.test(sel)) return replacement;
    }
    let s = sel;
    for (const re of STRIP_RE) s = s.replace(re, '');
    const segs = s.split('>').map(p => p.trim()
      .replace(/:nth-of-type\(\d+\)/g, '')
      .replace(/:nth-child\(\d+\)/g, '')
      .trim()
    ).filter(Boolean);
    const meaningful = segs.filter(seg => {
      const base = seg.split(/[.#[:/]/)[0].trim();
      return seg.includes('.') || seg.includes('#') || seg.includes('[') ||
             base.includes('-') || INTERACTIVE.has(base);
    });
    if (meaningful.length) return meaningful.slice(-3).join(' > ');
    return segs.slice(-3).join(' > ') || sel;
  }

  const simplified = steps.map(step => ({
    ...step,
    selector: step.selector ? smartSel(step.selector) : step.selector,
  }));

  // Auto-inject wait_for_selector after navigate / press Enter / cross-component clicks
  const withWaits = [];
  for (let idx = 0; idx < simplified.length; idx++) {
    const step = simplified[idx];
    withWaits.push(step);
    const next = simplified[idx + 1];
    if (step.action === "navigate" && next && next.selector &&
        ["click","type","select","check"].includes(next.action)) {
      withWaits.push({ action:"wait_for_selector", selector: next.selector, value:"", timeout:15000 });
    }
    if (step.action === "press" && ["Enter","Return","NumpadEnter"].includes(step.value) &&
        next && next.selector && ["click","type"].includes(next.action)) {
      withWaits.push({ action:"wait_for_selector", selector: next.selector, value:"", timeout:15000 });
    }
    if (step.action === "click" && next && next.action === "click" &&
        next.selector && step.selector &&
        next.selector.split(">")[0].trim() !== step.selector.split(">")[0].trim()) {
      withWaits.push({ action:"wait_for_selector", selector: next.selector, value:"", timeout:10000 });
    }
  }

  return withWaits;
}



// ─── SCRIPT EDITOR ──────────────────────────────────────────────────────────
// ─── SCRIPT EDITOR ────────────────────────────────────────────────────────────
// Simple line-by-line code editor. Steps ↔ Python code, bidirectional.
// Supports all actions including loop, if, switch, try/catch, foreach.

// Smart quote: use single quotes if string contains double quotes, else double quotes
const q = (str) => {
  const s = str || "";
  if (s.includes('"') && !s.includes("'")) return "'" + s + "'";
  if (s.includes('"') && s.includes("'")) return '"' + s.replace(/"/g, '\\"') + '"';
  return '"' + s + '"';
};

function stepsToCode(steps) {
  if (!steps || !steps.length) return "def run(page):\n    pass  # No steps yet\n";
  const INDENT_OPEN  = ["loop_start","foreach_start","if_start","switch_start","try_start","repeat_until"];
  const INDENT_MID   = ["else","catch_start","case"];
  const INDENT_CLOSE = ["loop_end","foreach_end","if_end","switch_end","try_end","repeat_until_end"];

  const lines = [];
  let depth = 0;

  const ind = (d) => "    ".repeat(Math.max(0,d));

  steps.forEach((step, i) => {
    const a   = step.action || "";
    const sel = step.selector || "";
    const val = step.value    || "";

    if (INDENT_CLOSE.includes(a)) depth = Math.max(0, depth-1);
    if (INDENT_MID.includes(a))   depth = Math.max(0, depth-1);

    const pfx = ind(depth);

    switch(a) {
      // ── Navigation ────────────────────────────────────────────────────────
      case "navigate":
        lines.push(`${pfx}page.goto(${q(val)})`); break;

      // ── Interactions ──────────────────────────────────────────────────────
      case "click":
        lines.push(sel.startsWith("get_by_")
          ? `${pfx}page.${sel}.click()`
          : `${pfx}page.click(${q(sel)})`); break;
      case "type":
        lines.push(sel.startsWith("get_by_")
          ? `${pfx}page.${sel}.fill(${q(val)})`
          : `${pfx}page.fill(${q(sel)}, ${q(val)})`); break;
      case "clear":
        lines.push(sel.startsWith("get_by_")
          ? `${pfx}page.${sel}.fill("")`
          : `${pfx}page.fill(${q(sel)}, "")`); break;
      case "select":
        lines.push(`${pfx}page.select_option(${q(sel)}, ${q(val)})`); break;
      case "check":
        lines.push(`${pfx}page.check(${q(sel)})`); break;
      case "uncheck":
        lines.push(`${pfx}page.uncheck(${q(sel)})`); break;
      case "hover":
        lines.push(`${pfx}page.hover(${q(sel)})`); break;
      case "press":
        lines.push(!sel || sel.toLowerCase()==="body"
          ? `${pfx}page.keyboard.press(${q(val)})`
          : `${pfx}page.press(${q(sel)}, ${q(val)})`); break;
      case "scroll":
        lines.push(`${pfx}page.evaluate("window.scrollTo(0, ${val||0})")`); break;
      case "execute_script":
        // If this step was created from an unrecognised raw line, output it verbatim
        if (step._raw_line) {
          lines.push(val); // val already has correct indentation
        } else {
          lines.push(`${pfx}page.evaluate(${JSON.stringify(val)})`);
        }
        break;

      // ── Waits ─────────────────────────────────────────────────────────────
      case "wait":
        lines.push(`${pfx}time.sleep(${(parseFloat(val)||1000)/1000})`); break;
      case "wait_for_selector":
        lines.push(`${pfx}page.wait_for_selector(${q(sel)})`); break;
      case "wait_for_url":
        lines.push(`${pfx}page.wait_for_url(${q(val)})`); break;
      case "wait_until":
        lines.push(`${pfx}# wait_until: ${step.if_condition||"condition"}`); break;

      // ── Assertions ────────────────────────────────────────────────────────
      case "assert_text":
        lines.push(`${pfx}assert ${q(val)} in page.locator(${q(sel)}).inner_text()`); break;
      case "assert_not_text":
        lines.push(`${pfx}assert ${q(val)} not in page.locator(${q(sel)}).inner_text()`); break;
      case "assert_visible":
        lines.push(`${pfx}assert page.locator(${q(sel)}).is_visible()`); break;
      case "assert_not_visible":
        lines.push(`${pfx}assert not page.locator(${q(sel)}).is_visible()`); break;
      case "assert_url":
        lines.push(`${pfx}assert ${q(val)} in page.url`); break;
      case "assert_title":
        lines.push(`${pfx}assert ${q(val)} in page.title()`); break;
      case "assert_value":
        lines.push(`${pfx}assert page.input_value(${q(sel)}) == ${q(val)}`); break;
      case "assert_count":
        lines.push(`${pfx}assert page.locator(${q(sel)}).count() == ${val}`); break;

      // ── Store / Capture ────────────────────────────────────────────────────
      case "store_text":
        lines.push(`${pfx}${val} = page.locator(${q(sel)}).inner_text().strip()`); break;
      case "store_value":
        lines.push(`${pfx}${val} = page.input_value(${q(sel)})`); break;
      case "store_attr":
        lines.push(`${pfx}${val} = page.locator(${q(sel)}).get_attribute(${q(step.attr_name||"")})` ); break;
      case "store_url":
        lines.push(`${pfx}${val} = page.url`); break;
      case "store_title":
        lines.push(`${pfx}${val} = page.title()`); break;
      case "store_count":
        lines.push(`${pfx}${val} = page.locator(${q(sel)}).count()`); break;
      case "store_js":
        lines.push(`${pfx}${val} = page.evaluate(${q(step.js_expr||sel)})`); break;

      // ── Assert Variables ───────────────────────────────────────────────────
      case "assert_equals":
        lines.push(`${pfx}assert str(${val}) == str(${q(step.value2||"")}), f"Expected {${q(step.value2||"")}!r} but got {str(${val})!r}"`); break;
      case "assert_not_equals":
        lines.push(`${pfx}assert str(${val}) != str(${q(step.value2||"")}), f"Values should differ but both are {str(${val})!r}"`); break;
      case "assert_contains":
        lines.push(`${pfx}assert ${q(step.value2||"")} in str(${val}), f"Expected {${q(step.value2||"")}!r} in {str(${val})!r}"`); break;
      case "assert_not_contains":
        lines.push(`${pfx}assert ${q(step.value2||"")} not in str(${val}), f"Did not expect {${q(step.value2||"")}!r} in {str(${val})!r}"`); break;
      case "assert_starts_with":
        lines.push(`${pfx}assert str(${val}).startswith(${q(step.value2||"")}), f"Expected to start with {${q(step.value2||"")}!r}"`); break;
      case "assert_ends_with":
        lines.push(`${pfx}assert str(${val}).endswith(${q(step.value2||"")}), f"Expected to end with {${q(step.value2||"")}!r}"`); break;
      case "assert_greater":
        lines.push(`${pfx}assert float(${val}) > float(${q(step.value2||"0")}), f"Expected {${val}} > ${step.value2||0}"`); break;
      case "assert_less":
        lines.push(`${pfx}assert float(${val}) < float(${q(step.value2||"0")}), f"Expected {${val}} < ${step.value2||0}"`); break;
      case "assert_between":
        lines.push(`${pfx}assert float(${q(step.value2||"0")}) <= float(${val}) <= float(${q(step.value3||"0")}), f"Expected {${val}} between ${step.value2||0} and ${step.value3||0}"`); break;
      case "assert_matches":
        lines.push(`${pfx}import re; assert re.search(${q(step.value2||"")}, str(${val})), f"Regex {${q(step.value2||"")}!r} not found in {str(${val})!r}"`); break;
      case "assert_empty":
        lines.push(`${pfx}assert not str(${val}).strip(), f"Expected empty but got {str(${val})!r}"`); break;
      case "assert_not_empty":
        lines.push(`${pfx}assert str(${val}).strip(), f"Expected non-empty value"`); break;

      // ── String Ops ─────────────────────────────────────────────────────────
      case "str_upper":
        lines.push(`${pfx}${val} = str(${val}).upper()`); break;
      case "str_lower":
        lines.push(`${pfx}${val} = str(${val}).lower()`); break;
      case "str_trim":
        lines.push(`${pfx}${val} = str(${val}).strip()`); break;
      case "str_replace":
        lines.push(`${pfx}${val} = str(${val}).replace(${q(step.value2||"")}, ${q(step.value3||"")})`); break;
      case "str_substring":
        lines.push(`${pfx}${val} = str(${val})[${step.value2||0}:${step.value3||""}]`); break;
      case "str_concat":
        lines.push(`${pfx}${val} = str(${val}) + str(${q(step.value2||"")})`); break;
      case "str_length":
        lines.push(`${pfx}${val} = len(str(${val}))`); break;
      case "str_split":
        lines.push(`${pfx}${val} = str(${val}).split(${q(step.value2||",")})[${step.value3||0}]`); break;

      // ── Math Ops ───────────────────────────────────────────────────────────
      case "math_add":
        lines.push(`${pfx}${val} = float(${val}) + float(${q(step.value2||"0")})`); break;
      case "math_subtract":
        lines.push(`${pfx}${val} = float(${val}) - float(${q(step.value2||"0")})`); break;
      case "math_multiply":
        lines.push(`${pfx}${val} = float(${val}) * float(${q(step.value2||"1")})`); break;
      case "math_divide":
        lines.push(`${pfx}${val} = float(${val}) / float(${q(step.value2||"1")})`); break;
      case "math_round":
        lines.push(`${pfx}${val} = round(float(${val}), ${step.value2||2})`); break;
      case "math_abs":
        lines.push(`${pfx}${val} = abs(float(${val}))`); break;
      case "math_random":
        lines.push(`${pfx}import random; ${val} = random.randint(${step.value2||0}, ${step.value3||100})`); break;

      // ── Date Ops ───────────────────────────────────────────────────────────
      case "date_today":
        lines.push(`${pfx}from datetime import datetime, timedelta; ${val} = datetime.today().strftime(${q(step.value2||"%d/%m/%Y")})`); break;
      case "date_now":
        lines.push(`${pfx}from datetime import datetime; ${val} = datetime.now().strftime(${q(step.value2||"%d/%m/%Y %H:%M:%S")})`); break;
      case "date_add":
        lines.push(`${pfx}from datetime import datetime, timedelta; ${val} = (datetime.strptime(str(${val}), ${q(step.value2||"%d/%m/%Y")}) + timedelta(days=${step.value3||1})).strftime(${q(step.value2||"%d/%m/%Y")})`); break;
      case "date_subtract":
        lines.push(`${pfx}from datetime import datetime, timedelta; ${val} = (datetime.strptime(str(${val}), ${q(step.value2||"%d/%m/%Y")}) - timedelta(days=${step.value3||1})).strftime(${q(step.value2||"%d/%m/%Y")})`); break;
      case "date_format":
        lines.push(`${pfx}from datetime import datetime; ${val} = datetime.strptime(str(${val}), ${q(step.value2||"%d/%m/%Y")}).strftime(${q(step.value3||"%Y-%m-%d")})`); break;
      case "date_diff":
        lines.push(`${pfx}from datetime import datetime; ${val} = abs((datetime.strptime(str(${val}), ${q(step.value2||"%d/%m/%Y")}) - datetime.strptime(${q(step.value3||"")}, ${q(step.value2||"%d/%m/%Y")})).days)`); break;

      // ── Encode / Parse ─────────────────────────────────────────────────────
      case "encode_base64":
        lines.push(`${pfx}import base64; ${val} = base64.b64encode(str(${val}).encode()).decode()`); break;
      case "decode_base64":
        lines.push(`${pfx}import base64; ${val} = base64.b64decode(str(${val})).decode()`); break;
      case "url_encode":
        lines.push(`${pfx}from urllib.parse import quote; ${val} = quote(str(${val}))`); break;
      case "json_extract":
        lines.push(`${pfx}import json as _json; ${val} = _json.loads(str(${val}) if isinstance(${val}, str) else _json.dumps(${val}))${step.value2 ? '[' + JSON.stringify(step.value2) + ']' : ''}`); break;
      case "json_parse":
        lines.push(`${pfx}import json as _json; ${val} = _json.loads(str(${val}))`); break;

      // ── Control Flow ──────────────────────────────────────────────────────
      case "loop_start":
        lines.push(`${pfx}for __loop_index__ in range(${val||3}):`); break;
      case "loop_end":
        lines.push(""); break;
      case "foreach_start":
        lines.push(`${pfx}for ${step.loop_var||"current_item"} in [${(val||"").split(",").map(x=>`"${x.trim()}"`).join(", ")}]:`); break;
      case "foreach_end":
        lines.push(""); break;
      case "if_start":
        lines.push(`${pfx}if ${step.if_condition||"True"}:  # ${step.if_selector||step.if_var||""}`); break;
      case "else":
        lines.push(`${pfx}else:`); break;
      case "if_end":
        lines.push(""); break;
      case "switch_start":
        lines.push(`${pfx}__switch__ = ${val||"variable"}`); break;
      case "case":
        lines.push(`${pfx}if __switch__ == ${q(val)}:`); break;
      case "switch_end":
        lines.push(""); break;
      case "try_start":
        lines.push(`${pfx}try:`); break;
      case "catch_start":
        lines.push(`${pfx}except Exception as ${step.error_var||"e"}:`); break;
      case "try_end":
        lines.push(""); break;
      case "break":
        lines.push(`${pfx}break`); break;
      case "continue":
        lines.push(`${pfx}continue`); break;
      case "repeat_until":
        lines.push(`${pfx}for __attempt__ in range(${step.max_retries||10}):`); break;
      case "repeat_until_end":
        lines.push(`${pfx}    break  # repeat_until condition met`); break;

      // ── Misc ──────────────────────────────────────────────────────────────
      case "group":
        lines.push(`${pfx}# ── ${val||"Section"} ──`); break;
      case "call_test":
        lines.push(`${pfx}# call_test: ${val}  # inline call to test case ${val}`); break;
      case "screenshot":
        lines.push(`${pfx}page.screenshot(path="${val||"screenshot"}.png")`); break;
      case "db_validate":
        lines.push(`${pfx}# db_validate: ${step.db_config?.query||"(query)"}`); break;

      default:
        lines.push(`${pfx}# ${a}: ${sel} ${val}`.trim());
    }

    if (INDENT_OPEN.includes(a)) depth++;
    if (INDENT_MID.includes(a))  depth++;
  });

  const body = lines.map(l => "    " + l).join("\n");
  return "def run(page):\n" + body + "\n";
}

function codeToSteps(code) {
  const steps = [];
  const lines  = code.split("\n");
  let m;

  // Helper: extract first string argument from function call args string
  // Handles both "..." and '...' including nested escaped/mixed quotes
  // e.g.  '#username', "admin", timeout=30000  → ['#username', 'admin']
  const extractArgs = (argsStr) => {
    const args = [];
    let i = 0;
    while (i < argsStr.length) {
      // skip whitespace and commas
      while (i < argsStr.length && (argsStr[i] === "," || argsStr[i] === " ")) i++;
      if (i >= argsStr.length) break;
      // keyword arg like timeout=30000 — stop collecting string args
      if (/[a-z_]/.test(argsStr[i]) && argsStr.slice(i).match(/^\w+\s*=/)) break;
      // string arg
      if (argsStr[i] === '"' || argsStr[i] === "'") {
        const q = argsStr[i]; i++;
        let val = "";
        while (i < argsStr.length) {
          if (argsStr[i] === "\\" && i+1 < argsStr.length) { val += argsStr[i+1]; i += 2; }
          else if (argsStr[i] === q) { i++; break; }
          else { val += argsStr[i++]; }
        }
        args.push(val);
      } else {
        // non-string arg (number, variable) — skip
        while (i < argsStr.length && argsStr[i] !== ",") i++;
      }
    }
    return args;
  };

  // Extract args string from: page.action(ARGS)
  const getArgs = (line, action) => {
    const prefix = "page." + action + "(";
    const idx = line.indexOf(prefix);
    if (idx < 0) return null;
    return line.slice(idx + prefix.length);
  };

  for (let raw of lines) {
    const line = raw.trim();
    if (!line) continue;

    // Skip boilerplate
    if (line.startsWith("def ") || line === "pass" ||
        line.startsWith("from ") || line.startsWith("import ") ||
        line.startsWith("with ") || line.startsWith("browser") ||
        line.startsWith("context") || line.startsWith("playwright")) continue;

    // DB Validate comment
    if (line.startsWith("# DB Validate:")) {
      const query = line.replace(/^#\s*DB Validate:\s*/, "").trim();
      steps.push({ action:"db_validate", db_config:{ query }, selector:"", value:"", timeout:30000 });
      continue;
    }

    // Section comment
    if (line.startsWith("# ──") || line.startsWith("# --")) {
      const label = line.replace(/^#\s*[-─]+\s*/, "").replace(/\s*[-─]+\s*$/, "").trim();
      if (label) steps.push({ action:"group", value:label, selector:"", timeout:30000 });
      continue;
    }

    // Parse special recorder comments into proper steps
    if (line.startsWith("#")) {
      // search_select comment: # search_select: SELECTOR search="TEXT" pick="OPTION"
      const ssM = line.match(/^#\s*search_select:\s*(\S+)\s+search="([^"]*)"\s+pick="([^"]*)"/);
      if (ssM) {
        const ssWait = line.match(/wait_ms=(\d+)/);
        steps.push({
          action: "search_select",
          selector: ssM[1].trim(),
          search_text: ssM[2],
          value: ssM[3],
          wait_ms: ssWait ? ssWait[1] : "",
          timeout: 30000
        });
        continue;
      }
      // Old format fallback: # search_select: SELECTOR  VALUE
      const ssMOld = line.match(/^#\s*search_select:\s*(\S+)\s+(.+)$/);
      if (ssMOld && !line.includes("search=")) {
        steps.push({ action:"search_select", selector:ssMOld[1].trim(), value:ssMOld[2].trim(), timeout:30000 });
        continue;
      }
      // Skip the runner comment line
      if (line.includes("run by ATHMA runner")) { continue; }
      // DB Validate already handled above, section comment already handled above
      // All other comments — preserve verbatim as raw so NOTHING is silently dropped
      steps.push({ action:"execute_script", value:raw, selector:"", timeout:30000, _raw_line:true });
      continue;
    }

    // ── Navigation ──
    if (line.startsWith("page.goto(")) {
      const args = extractArgs(getArgs(line, "goto") || "");
      if (args[0]) { steps.push({ action:"navigate", value:args[0], selector:"", timeout:30000 }); continue; }
    }

    // ── Waits ──
    if ((m = line.match(/^time\.sleep\((.+?)\)/)))
      { steps.push({ action:"wait", value:String(parseFloat(m[1])*1000), selector:"", timeout:30000 }); continue; }

    if (line.startsWith("page.wait_for_url(")) {
      const args = extractArgs(getArgs(line, "wait_for_url") || "");
      if (args[0]) { steps.push({ action:"wait_for_url", value:args[0], selector:"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.wait_for_selector(")) {
      const args = extractArgs(getArgs(line, "wait_for_selector") || "");
      if (args[0]) { steps.push({ action:"wait_for_selector", selector:args[0], value:"", timeout:30000 }); continue; }
    }

    // ── Assertions ──
    if ((m = line.match(/^assert ["'](.+?)["'] in page\.locator\(["'](.+?)["']\)\.inner_text\(\)/)))
      { steps.push({ action:"assert_text", selector:m[2], value:m[1], timeout:30000 }); continue; }
    if ((m = line.match(/^assert ["'](.+?)["'] not in page\.locator\(["'](.+?)["']\)\.inner_text\(\)/)))
      { steps.push({ action:"assert_not_text", selector:m[2], value:m[1], timeout:30000 }); continue; }
    if ((m = line.match(/^assert page\.locator\(["'](.+?)["']\)\.is_visible\(\)/)))
      { steps.push({ action:"assert_visible", selector:m[1], value:"", timeout:30000 }); continue; }
    if ((m = line.match(/^assert not page\.locator\(["'](.+?)["']\)\.is_visible\(\)/)))
      { steps.push({ action:"assert_not_visible", selector:m[1], value:"", timeout:30000 }); continue; }
    if ((m = line.match(/^assert ["'](.+?)["'] in page\.url/)))
      { steps.push({ action:"assert_url", value:m[1], selector:"", timeout:30000 }); continue; }
    if ((m = line.match(/^assert ["'](.+?)["'] in page\.title\(\)/)))
      { steps.push({ action:"assert_title", value:m[1], selector:"", timeout:30000 }); continue; }
    if ((m = line.match(/^assert page\.input_value\(["'](.+?)["']\)\s*==\s*["'](.+?)["']/)))
      { steps.push({ action:"assert_value", selector:m[1], value:m[2], timeout:30000 }); continue; }
    if ((m = line.match(/^assert page\.locator\(["'](.+?)["']\)\.count\(\)\s*==\s*(\d+)/)))
      { steps.push({ action:"assert_count", selector:m[1], value:m[2], timeout:30000 }); continue; }

    // ── Store ──
    if ((m = line.match(/^(\w+)\s*=\s*page\.locator\(["'](.+?)["']\)\.inner_text\(\)/)))
      { steps.push({ action:"store_text", selector:m[2], value:m[1], timeout:30000 }); continue; }
    if ((m = line.match(/^(\w+)\s*=\s*page\.input_value\(["'](.+?)["']\)/)))
      { steps.push({ action:"store_value", selector:m[2], value:m[1], timeout:30000 }); continue; }
    if ((m = line.match(/^(\w+)\s*=\s*page\.url/)))
      { steps.push({ action:"store_url", value:m[1], selector:"", timeout:30000 }); continue; }

    // ── Interactions (use extractArgs to handle timeout= and mixed quotes) ──
    if (line.startsWith("page.fill(")) {
      const args = extractArgs(getArgs(line, "fill") || "");
      if (args[0]) { steps.push({ action:"type", selector:args[0], value:args[1]||"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.click(")) {
      const args = extractArgs(getArgs(line, "click") || "");
      if (args[0]) { steps.push({ action:"click", selector:args[0], value:"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.select_option(")) {
      const args = extractArgs(getArgs(line, "select_option") || "");
      if (args[0]) { steps.push({ action:"select", selector:args[0], value:args[1]||"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.check(")) {
      const args = extractArgs(getArgs(line, "check") || "");
      if (args[0]) { steps.push({ action:"check", selector:args[0], value:"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.uncheck(")) {
      const args = extractArgs(getArgs(line, "uncheck") || "");
      if (args[0]) { steps.push({ action:"uncheck", selector:args[0], value:"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.hover(")) {
      const args = extractArgs(getArgs(line, "hover") || "");
      if (args[0]) { steps.push({ action:"hover", selector:args[0], value:"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.press(")) {
      const args = extractArgs(getArgs(line, "press") || "");
      if (args[0]) { steps.push({ action:"press", selector:args[0], value:args[1]||"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.keyboard.press(")) {
      const args = extractArgs(line.slice("page.keyboard.press(".length) || "");
      if (args[0]) { steps.push({ action:"press", selector:"body", value:args[0], timeout:30000 }); continue; }
    }
    if (line.startsWith("page.screenshot(")) {
      if ((m = line.match(/path=["'](.+?)["']/)))
        { steps.push({ action:"screenshot", value:m[1].replace(/\.png$/,""), selector:"", timeout:30000 }); continue; }
    }
    if (line.startsWith("page.evaluate(")) {
      const args = extractArgs(getArgs(line, "evaluate") || "");
      if (args[0]) { steps.push({ action:"execute_script", value:args[0], selector:"", timeout:30000 }); continue; }
    }

    // ── get_by_* chained ──
    if ((m = line.match(/^page\.(get_by_\w+\([^)]*\))\.click\(\)/)))
      { steps.push({ action:"click", selector:m[1], value:"", timeout:30000 }); continue; }
    if ((m = line.match(/^page\.(get_by_\w+\([^)]*\))\.fill\(["'](.*?)["']\)/)))
      { steps.push({ action:"type", selector:m[1], value:m[2], timeout:30000 }); continue; }


    // ── page.locator(...).action() chained calls ──
    if ((m = line.match(/^page\.locator\(["'`](.+?)["'`]\)\.click\(.*\)/)))
      { steps.push({ action:"click", selector:m[1], value:"", timeout:30000 }); continue; }
    if ((m = line.match(/^page\.locator\(["'`](.+?)["'`]\)\.fill\(["'`](.*?)["'`]/)))
      { steps.push({ action:"type", selector:m[1], value:m[2], timeout:30000 }); continue; }
    if ((m = line.match(/^page\.locator\(["'`](.+?)["'`]\)\.check\(/)))
      { steps.push({ action:"check", selector:m[1], value:"", timeout:30000 }); continue; }
    if ((m = line.match(/^page\.locator\(["'`](.+?)["'`]\)\.uncheck\(/)))
      { steps.push({ action:"uncheck", selector:m[1], value:"", timeout:30000 }); continue; }
    if ((m = line.match(/^page\.locator\(["'`](.+?)["'`]\)\.hover\(/)))
      { steps.push({ action:"hover", selector:m[1], value:"", timeout:30000 }); continue; }
    if ((m = line.match(/^page\.locator\(["'`](.+?)["'`]\)\.select_option\(["'`](.*?)["'`]/)))
      { steps.push({ action:"select", selector:m[1], value:m[2], timeout:30000 }); continue; }
    if ((m = line.match(/^page\.locator\(["'`](.+?)["'`]\)\.wait_for\(/)))
      { steps.push({ action:"wait_for_selector", selector:m[1], value:"", timeout:30000 }); continue; }
    // ── store from locator ──
    if ((m = line.match(/^(\w+)\s*=\s*page\.locator\(["'`](.+?)["'`]\)\.(?:inner_text|text_content)\(\)/)))
      { steps.push({ action:"store_text", selector:m[2], value:m[1], timeout:30000 }); continue; }
    // ── page.wait_for_timeout() ──
    if ((m = line.match(/^page\.wait_for_timeout\((\d+)/)))
      { steps.push({ action:"wait", value:m[1], selector:"", timeout:30000 }); continue; }
    // ── page.reload() ──
    if (line.startsWith("page.reload("))
      { steps.push({ action:"refresh", value:"", selector:"", timeout:30000 }); continue; }
    // ── page.go_back() / page.go_forward() ──
    if (line.startsWith("page.go_back("))
      { steps.push({ action:"back", value:"", selector:"", timeout:30000 }); continue; }
    if (line.startsWith("page.go_forward("))
      { steps.push({ action:"forward", value:"", selector:"", timeout:30000 }); continue; }

    // ── scroll / execute_script ──
    if ((m = line.match(/^page\.evaluate\("window\.scrollTo\(0,\s*(.+?)\)"\)/)))
      { steps.push({ action:"scroll", value:m[1], selector:"", timeout:30000 }); continue; }

    // ── Control Flow ──
    if ((m = line.match(/^for __loop_index__ in range\((\d+)\):/)))
      { steps.push({ action:"loop_start", value:m[1], selector:"", timeout:30000 }); continue; }
    if ((m = line.match(/^for (\w+) in \[(.+)\]:/))) {
      const items = m[2].split(",").map(x => x.trim().replace(/^["']|["']$/g,"")).join(", ");
      steps.push({ action:"foreach_start", value:items, loop_var:m[1], selector:"", timeout:30000 }); continue;
    }
    if (line === "else:")
      { steps.push({ action:"else", value:"", selector:"", timeout:30000 }); continue; }
    if ((m = line.match(/^except Exception as (\w+):/)))
      { steps.push({ action:"catch_start", error_var:m[1], value:"", selector:"", timeout:30000 }); continue; }
    if (line === "try:")
      { steps.push({ action:"try_start", value:"", selector:"", timeout:30000 }); continue; }
    if (line === "break")
      { steps.push({ action:"break", value:"", selector:"", timeout:30000 }); continue; }
    if (line === "continue")
      { steps.push({ action:"continue", value:"", selector:"", timeout:30000 }); continue; }
    if ((m = line.match(/^if (.+):(?:\s*#.*)?$/))) {
      const cond = m[1].trim();
      if (cond.includes("page.url")) {
        steps.push({ action:"if_start", if_condition:"url_contains", if_value:cond.match(/["'](.+?)["']/)?.[1]||"", selector:"", value:"", timeout:30000 });
      } else {
        steps.push({ action:"if_start", if_condition:"element_visible", if_selector:cond.replace(/^page\.locator\(["']|["']\)\.is_visible\(\)$/g,""), selector:"", value:"", timeout:30000 });
      }
      continue;
    }

    // ── CATCH-ALL: never drop any line ──────────────────────────────────────
    // Unrecognised lines are preserved as execute_script with original text.
    // Runner executes them as raw Python — zero data loss on save.
    steps.push({
      action: "execute_script",
      value:  raw,          // preserve original indentation
      selector: "",
      timeout: 30000,
      _raw_line: true,      // flag: unrecognised pattern
    });
  }

  return steps;
}


// Fix selectors with unescaped double quotes inside double-quoted strings
// e.g. page.fill("[placeholder="x"]", ...) → page.fill('[placeholder="x"]', ...)
function normalizeScriptQuotes(code) {
  return code.replace(
    /(page\.\w+\s*\()"([^"]*"[^"]*)"([,)\s])/g,
    (match, prefix, inner, suffix) => `${prefix}'${inner}'${suffix}`
  );
}

const ScriptEditor = React.memo(function ScriptEditor({ steps, onChange }) {
  const [code,        setCode]       = useState(() => stepsToCode(steps));
  const [dirty,       setDirty]      = useState(false);
  const [status,      setStatus]     = useState(null);
  const [lastSteps,   setLastSteps]  = useState(steps);
  const [validating,  setValidating] = useState(false);
  const [fullscreen,   setFullscreen]  = useState(false);
  const [warnings,     setWarnings]    = useState([]);
  const [breakpoints,  setBreakpoints] = useState(new Set());

  // ── Debug state ───────────────────────────────────────────────────────────
  const [debugActive,  setDebugActive] = useState(false);  // session running
  const [debugRunId,   setDebugRunId]  = useState(null);
  const [debugPaused,  setDebugPaused] = useState(false);
  const [debugCurLine, setDebugCurLine]= useState(null);   // step index currently executing
  const [debugLineStatus, setDebugLineStatus] = useState({}); // {stepIdx: 'running'|'done'|'error'|'skipped'}
  const [debugVars,    setDebugVars]   = useState({});
  const [debugLogs,    setDebugLogs]   = useState([]);
  const [debugUrl,     setDebugUrl]    = useState("");
  const [debugScreenshot,setDebugScreenshot]=useState("");  // base64 latest screenshot
  const [debugError,   setDebugError]  = useState(null);
  const [debugSlowMo,  setDebugSlowMo] = useState(500);
  const [showDebugPanel,setShowDebugPanel]=useState(false);
  const debugWsRef  = useRef(null);
  const debugPanelRef = useRef(null); // for auto-scroll

  const editorRef = useRef(null);
  const cmRef     = useRef(null);
  const cmLoaded  = useRef(false);

  // Sync steps → code when steps change externally
  useEffect(() => {
    if (steps !== lastSteps) {
      setLastSteps(steps);
      if (!dirty) {
        const nc = stepsToCode(steps);
        setCode(nc);
        if (cmRef.current) cmRef.current.setValue(nc);
      }
    }
  }, [steps]);

  // Analyse code for unrecognised lines (warnings)
  const analyseCode = (c) => {
    const parsed = codeToSteps(c);
    const rawLines = parsed.filter(s => s._raw_line);
    setWarnings(rawLines.map(s => s.value?.trim()).filter(Boolean));
    return { parsed, rawCount: rawLines.length };
  };

  // Build accurate step index → line number map by parsing stepsToCode output
  // Each step maps to the line where its code appears
  const buildStepLineMap = (stepsArr) => {
    const codeStr = stepsToCode(stepsArr);
    const codeLines = codeStr.split("\n");
    const map = {}; // stepIdx → lineNum (0-based)
    let stepIdx = 0;
    // Line 0 is always "def run(page):"
    // Step code starts at line 1
    for (let ln = 1; ln < codeLines.length && stepIdx < stepsArr.length; ln++) {
      const trimmed = codeLines[ln].trim();
      if (!trimmed || trimmed === "pass" || trimmed === "pass  # No steps yet") continue;
      // Skip closing keywords that don't map to a step
      if (["else:", "except Exception"].some(k => trimmed.startsWith(k))) continue;
      map[stepIdx] = ln;
      stepIdx++;
    }
    return map;
  };

  const stepLineMapRef = useRef({});

  const stepToLineNum = (stepIdx) => {
    const mapped = stepLineMapRef.current[stepIdx];
    return mapped !== undefined ? mapped : stepIdx + 1;
  };

  // Update gutter markers combining debug state + breakpoints + warnings


  // ── Debug session ────────────────────────────────────────────────────────
  const startDebug = async () => {
    const c = cmRef.current ? cmRef.current.getValue() : code;
    const { parsed } = analyseCode(c);
    if (!parsed.length) { alert("No steps to debug. Write or record some steps first."); return; }

    // Convert breakpoint line numbers → step indices
    const bpSteps = [];
    parsed.forEach((_, idx) => {
      const ln = stepToLineNum(idx);
      if (breakpoints.has(ln)) bpSteps.push(idx);
    });

    // Build step→line map before starting
    stepLineMapRef.current = buildStepLineMap(parsed);

    setDebugActive(true); setShowDebugPanel(true);
    // Auto-scroll to panel after it renders
    setTimeout(() => {
      if (debugPanelRef.current)
        debugPanelRef.current.scrollIntoView({ behavior:"smooth", block:"start" });
    }, 100); // auto-open panel
    setDebugPaused(false); setDebugCurLine(null);
    setDebugLineStatus({}); setDebugVars({});
    setDebugLogs([]); setDebugUrl(""); setDebugError(null); setDebugScreenshot("");

    try {
      // Step 1 — create the run record and get run_id FIRST
      const res = await api("/api/debug/script", {
        method: "POST",
        body: { steps: parsed, browser: "chrome",
                slow_mo: debugSlowMo, breakpoints: bpSteps }
      });
      const runId = res.run_id;
      setDebugRunId(runId);
      setDebugLogs(l => [...l, { type:"info", ts:Date.now(),
        text: `Debug session #${runId} created — connecting...` }]);

      // Step 2 — connect WebSocket and wait for it to open BEFORE runner starts
      const wsUrl = WS + "?runId=" + runId;
      const ws = new WebSocket(wsUrl);
      debugWsRef.current = ws;

      ws.onmessage = (e) => {
        try {
          const msg = JSON.parse(e.data);
          console.log("[DEBUG WS]", msg.type, msg);
          handleDebugEvent(msg, parsed);
        } catch(parseErr) { console.error("[DEBUG WS parse error]", e.data); }
      };
      ws.onerror = (e) => {
        setDebugLogs(l => [...l, { type:"error", ts:Date.now(), text:"WebSocket error — check backend is running" }]);
      };
      ws.onclose = () => {
        // Only mark inactive if debug was still running (not already stopped)
        setDebugActive(prev => { if(prev) setDebugPaused(false); return false; });
      };

      // Step 3 — signal server that WS is ready, then server starts the runner
      ws.onopen = async () => {
        setDebugLogs(l => [...l, { type:"info", ts:Date.now(), text:"Connected — starting runner..." }]);
        try {
          await api(`/api/debug/${runId}/start`, { method:"POST" });
        } catch(e) {
          setDebugLogs(l => [...l, { type:"error", ts:Date.now(), text:"Failed to start runner: "+e.message }]);
          setDebugActive(false);
        }
      };

    } catch(err) {
      setDebugActive(false);
      setDebugLogs([{ type:"error", text:"Failed to start debug: " + err.message, ts: Date.now() }]);
    }
  };

  const handleDebugEvent = (msg, parsedSteps) => {
    const ts = Date.now();
    switch(msg.type) {
      case "line_start": {
        const ln = stepLineMapRef.current[msg.step_index] ?? (msg.step_index + 1);
        setDebugCurLine(msg.step_index);
        setDebugLineStatus(prev => {
          const next = { ...prev, [msg.step_index]: "running" };
          // Directly update gutter marker
          if (cmRef.current) {
            const el = document.createElement("div");
            el.style.cssText = "width:14px;height:14px;border-radius:50%;background:#3b82f6;margin:2px 3px;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;font-weight:900;box-shadow:0 0 0 3px rgba(59,130,246,0.35)";
            el.textContent = "→"; el.title = "Executing...";
            cmRef.current.setGutterMarker(ln, "CodeMirror-debug", el);
            // Highlight line
            const lc = cmRef.current.lineCount();
            for (let i=0;i<lc;i++) cmRef.current.removeLineClass(i,"background","cm-debug-current");
            if (ln < lc) { cmRef.current.addLineClass(ln,"background","cm-debug-current"); cmRef.current.scrollIntoView({line:ln,ch:0},80); }
          }
          return next;
        });
        if (msg.variables) setDebugVars(msg.variables);
        setDebugLogs(l => [...l, {
          type:"info", ts,
          text: `→ Step ${msg.step_index+1}: ${parsedSteps?.[msg.step_index]?.action || ""}`
        }]);
        break;
      }

      case "line_done": {
        const ln = stepLineMapRef.current[msg.step_index] ?? (msg.step_index + 1);
        setDebugLineStatus(prev => {
          const next = { ...prev, [msg.step_index]: "done" };
          if (cmRef.current) {
            const el = document.createElement("div");
            el.style.cssText = "width:14px;height:14px;border-radius:50%;background:#22c55e;margin:2px 3px;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;font-weight:900";
            el.textContent = "✓"; el.title = "Passed";
            cmRef.current.setGutterMarker(ln, "CodeMirror-debug", el);
            cmRef.current.removeLineClass(ln,"background","cm-debug-current");
          }
          return next;
        });
        if (msg.variables) setDebugVars(msg.variables);
        if (msg.url) setDebugUrl(msg.url);
        if (msg.screenshot) setDebugScreenshot(msg.screenshot);
        setDebugLogs(l => [...l, {
          type:"ok", ts,
          text: `✓ Step ${msg.step_index+1} done (${msg.duration_ms}ms)`
        }]);
        break;
      }

      case "line_error": {
        const ln = stepLineMapRef.current[msg.step_index] ?? (msg.step_index + 1);
        setDebugLineStatus(prev => {
          const next = { ...prev, [msg.step_index]: "error" };
          if (cmRef.current) {
            const el = document.createElement("div");
            el.style.cssText = "width:14px;height:14px;border-radius:50%;background:#ef4444;margin:2px 3px;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;font-weight:900";
            el.textContent = "✗"; el.title = "Failed";
            cmRef.current.setGutterMarker(ln, "CodeMirror-debug", el);
            cmRef.current.removeLineClass(ln,"background","cm-debug-current");
            cmRef.current.addLineClass(ln,"background","cm-error-line");
          }
          return next;
        });
        setDebugError({ stepIndex: msg.step_index, message: msg.error });
        if (msg.screenshot) setDebugScreenshot(msg.screenshot);
        if (msg.url) setDebugUrl(msg.url);
        setDebugLogs(l => [...l, {
          type:"error", ts,
          text: `✗ Step ${msg.step_index+1} FAILED: ${msg.error}`
        }]);
        break;
      }

      case "line_skipped":
        setDebugLineStatus(prev => ({ ...prev, [msg.step_index]: "skipped" }));
        setDebugLogs(l => [...l, { type:"warn", ts, text:`⟶ Step ${msg.step_index+1} skipped` }]);
        break;

      case "debug_paused": {
        const ln = stepLineMapRef.current[msg.step_index] ?? (msg.step_index + 1);
        setDebugPaused(true);
        setDebugCurLine(msg.step_index);
        if (msg.variables) setDebugVars(msg.variables);
        if (cmRef.current) {
          const el = document.createElement("div");
          el.style.cssText = "width:14px;height:14px;border-radius:50%;background:#f59e0b;margin:2px 3px;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;font-weight:900;box-shadow:0 0 0 3px rgba(245,158,11,0.35)";
          el.textContent = "⏸"; el.title = "Paused";
          cmRef.current.setGutterMarker(ln, "CodeMirror-debug", el);
          const lc = cmRef.current.lineCount();
          for (let i=0;i<lc;i++) cmRef.current.removeLineClass(i,"background","cm-debug-current");
          if (ln < lc) { cmRef.current.addLineClass(ln,"background","cm-debug-current"); cmRef.current.scrollIntoView({line:ln,ch:0},80); }
        }
        setDebugLogs(l => [...l, {
          type:"pause", ts,
          text: `⏸ Paused at step ${msg.step_index+1}${msg.reason==="breakpoint"?" (breakpoint)":""}`
        }]);
        break;
      }

      case "debug_stopped":
        setDebugActive(false); setDebugPaused(false);
        setDebugLogs(l => [...l, { type:"warn", ts, text:"⏹ Debug stopped" }]);
        break;

      case "log":
        if (msg.message && !msg.message.startsWith("[DEBUG]")) {
          setDebugLogs(l => [...l, { type: msg.level==="error"?"error":"log", ts, text: msg.message }]);
        }
        break;

      case "status":
        // status:running = runner started, status:failed/passed = runner finished
        if (msg.status === "failed" || msg.status === "passed") {
          setDebugActive(false); setDebugPaused(false); setDebugCurLine(null);
          setDebugLogs(l => [...l, { type: msg.status==="passed"?"ok":"error", ts,
            text: `Debug session ${msg.status}` }]);
        }
        // status:running is just an update, ignore
        break;

      case "done":
        setDebugActive(false); setDebugPaused(false); setDebugCurLine(null);
        setDebugLogs(l => [...l, { type:"ok", ts, text:"✅ Debug session complete" }]);
        if (debugWsRef.current) { debugWsRef.current.close(); debugWsRef.current = null; }
        break;
    }
  };

  const sendDebugCommand = async (cmd) => {
    if (!debugRunId) return;
    setDebugPaused(false);
    try {
      await api(`/api/runs/${debugRunId}/debug-command`, { method:"POST", body:{ command: cmd } });
    } catch(e) {
      setDebugLogs(l => [...l, { type:"error", ts:Date.now(), text:"Command failed: "+e.message }]);
    }
  };

  const stopDebug = async () => {
    await sendDebugCommand("stop");
    setDebugActive(false); setDebugPaused(false); setDebugCurLine(null);
    setDebugLineStatus({});
    if (debugWsRef.current) { debugWsRef.current.close(); debugWsRef.current = null; }
    if (cmRef.current) {
      const lc = cmRef.current.lineCount();
      for (let i=0;i<lc;i++) {
        cmRef.current.removeLineClass(i,"background","cm-debug-current");
        cmRef.current.removeLineClass(i,"background","cm-error-line");
      }
      cmRef.current.clearGutter("CodeMirror-debug");
      updateGutterMarkers(cmRef.current); // restore breakpoints
    }
  };

  // Update gutter markers for raw/warning lines
  // Single gutter update — handles breakpoints + debug state + raw-line warnings
  const updateGutterMarkers = (cm) => {
    if (!cm) return;
    cm.clearGutter("CodeMirror-debug");
    const lineCount = cm.lineCount();
    const codeLines = cm.getValue().split("\n");

    // ── Debug line status (done/error/skipped) — drawn first, lowest priority ──
    Object.entries(debugLineStatus).forEach(([sidxStr, status]) => {
      const ln = parseInt(sidxStr) + 1; // step → line (approx)
      if (ln >= lineCount) return;
      const configs = {
        running: { bg:"#3b82f6", border:"rgba(59,130,246,0.5)", sym:"▶" },
        done:    { bg:"#16a34a", border:"rgba(22,163,74,0.4)",  sym:"✓" },
        error:   { bg:"#dc2626", border:"rgba(220,38,38,0.4)",  sym:"✗" },
        skipped: { bg:"#6b7280", border:"rgba(107,114,128,0.3)",sym:"—" },
      };
      const cfg = configs[status];
      if (!cfg) return;
      const el = document.createElement("div");
      el.style.cssText = `width:16px;height:16px;border-radius:50%;background:${cfg.bg};` +
        `margin:1px 1px;display:flex;align-items:center;justify-content:center;` +
        `font-size:9px;color:#fff;font-weight:900;cursor:default;` +
        `box-shadow:0 0 0 2px ${cfg.border}`;
      el.textContent = cfg.sym;
      el.title = { running:"Executing...", done:"Passed", error:"Failed", skipped:"Skipped" }[status];
      cm.setGutterMarker(ln, "CodeMirror-debug", el);
    });

    // ── Raw/unrecognised lines — yellow dot ──
    const boilerplate = new Set(["def run(page):", "pass", "pass  # No steps yet", ""]);
    codeLines.forEach((raw, i) => {
      const line = raw.trim();
      if (!line || boilerplate.has(line) ||
          line.startsWith("#") || line.startsWith("def ") || line.startsWith("from ") ||
          line.startsWith("page.") || line.startsWith("assert ") ||
          line.startsWith("time.sleep") || line.startsWith("for ") ||
          line.startsWith("if ") || line.startsWith("else:") ||
          line.startsWith("try:") || line.startsWith("except ") ||
          line.startsWith("with ") || line === "break" || line === "continue" ||
          /^\w+\s*=\s*page\./.test(line)) return;
      // Don't overwrite breakpoint or debug status markers
      if (breakpoints.has(i)) return;
      const el = document.createElement("div");
      el.style.cssText = "width:8px;height:8px;border-radius:50%;background:#f59e0b;margin:4px 5px;cursor:default";
      el.title = "Unrecognised line — will be preserved as raw Python";
      cm.setGutterMarker(i, "CodeMirror-debug", el);
    });

    // ── Breakpoints — red dot, highest priority, drawn last ──
    breakpoints.forEach(ln => {
      if (ln >= lineCount) return;
      const el = document.createElement("div");
      el.style.cssText = "width:12px;height:12px;border-radius:50%;background:#ef4444;" +
        "margin:2px 3px;cursor:pointer;box-shadow:0 0 0 2px rgba(239,68,68,0.35)";
      el.title = "Breakpoint — click to remove, F9 to toggle";
      cm.setGutterMarker(ln, "CodeMirror-debug", el);
    });

    // ── Current line highlight ──
    for (let i = 0; i < lineCount; i++)
      cm.removeLineClass(i, "background", "cm-debug-current");
    if (debugCurLine !== null) {
      const ln = debugCurLine + 1;
      if (ln < lineCount) {
        cm.addLineClass(ln, "background", "cm-debug-current");
        cm.scrollIntoView({ line: ln, ch: 0 }, 80);
      }
    }
  };

  // ESC to exit fullscreen
  useEffect(() => {
    const handler = (e) => { if (e.key === "Escape") setFullscreen(false); };
    window.addEventListener("keydown", handler);
    return () => window.removeEventListener("keydown", handler);
  }, []);

  // Cleanup debug WS on unmount
  useEffect(() => () => { if (debugWsRef.current) debugWsRef.current.close(); }, []);

  // Update gutter when debugLineStatus changes
  useEffect(() => { if (cmRef.current) updateGutterMarkers(cmRef.current); }, [debugLineStatus, debugCurLine, breakpoints]);

  // Load CodeMirror
  useEffect(() => {
    if (cmLoaded.current || !editorRef.current) return;
    cmLoaded.current = true;

    const loadScript = (src) => new Promise((res, rej) => {
      if (document.querySelector(`script[src="${src}"]`)) return res();
      const s = document.createElement("script");
      s.src = src; s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
    const loadCSS = (href) => {
      if (document.querySelector(`link[href="${href}"]`)) return;
      const l = document.createElement("link");
      l.rel = "stylesheet"; l.href = href;
      document.head.appendChild(l);
    };

    loadCSS("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css");
    loadCSS("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css");

    loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js")
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/python/python.min.js"))
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"))
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closebrackets.min.js"))
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/comment/comment.min.js"))
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/selection/active-line.min.js"))
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldcode.min.js"))
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.js"))
      .then(() => loadScript("https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/indent-fold.min.js"))
      .then(() => {
        if (!editorRef.current || !window.CodeMirror) return;
        const cm = window.CodeMirror(editorRef.current, {
          value:             code,
          mode:              "python",
          theme:             "dracula",
          lineNumbers:       true,
          gutters:           ["CodeMirror-linenumbers", "CodeMirror-debug"],
          matchBrackets:     true,
          autoCloseBrackets: true,
          styleActiveLine:   true,
          indentUnit:        4,
          tabSize:           4,
          indentWithTabs:    false,
          lineWrapping:      false,
          foldGutter:        true,
          extraKeys: {
            "Tab":       (cm) => cm.execCommand("indentMore"),
            "Shift-Tab": (cm) => cm.execCommand("indentLess"),
            "Ctrl-S":    (cm) => handleSaveRef.current(cm.getValue()),
            "Cmd-S":     (cm) => handleSaveRef.current(cm.getValue()),
            "Ctrl-/":    (cm) => cm.execCommand("toggleComment"),
            "F9":        (cm) => { // toggle breakpoint at current line
              const ln = cm.getCursor().line;
              setBreakpoints(prev => {
                const n = new Set(prev);
                n.has(ln) ? n.delete(ln) : n.add(ln);
                return n;
              });
            },
          },
        });
        cmRef.current = cm;

        cm.on("change", () => {
          const val = cm.getValue();
          setCode(val);
          setDirty(true);
          setStatus(null);
          // Live step count
          try {
            const { parsed, rawCount } = analyseCode(val);
            if (parsed.length > 0) {
              const msg = rawCount > 0
                ? `${parsed.length} steps · ${rawCount} raw line${rawCount!==1?"s":""} (⚠ not in step format, will be preserved)`
                : `${parsed.length} steps detected`;
              setStatus({ type: rawCount>0 ? "warn" : "info", msg });
            }
          } catch(e) {}
          setTimeout(() => updateGutterMarkers(cm), 100);
        });

        // Gutter click — toggle breakpoint
        cm.on("gutterClick", (cm, line, gutter) => {
          if (gutter === "CodeMirror-debug") {
            setBreakpoints(prev => {
              const n = new Set(prev);
              n.has(line) ? n.delete(line) : n.add(line);
              return n;
            });
          }
        });

        cm.setSize("100%", "auto");
        cm.getWrapperElement().style.fontSize  = "13px";
        cm.getWrapperElement().style.lineHeight = "1.65";
        updateGutterMarkers(cm);
      });
  }, []);

  // Update gutter when breakpoints change
  useEffect(() => {
    if (cmRef.current) updateGutterMarkers(cmRef.current);
  }, [breakpoints]);

  // Use ref so Ctrl+S always gets latest handleSave
  const handleSaveRef = useRef(null);

  const handleSave = async (codeVal) => {
    let c = codeVal !== undefined ? codeVal : (cmRef.current ? cmRef.current.getValue() : code);
    c = normalizeScriptQuotes(c);
    setValidating(true);
    setStatus({ type:"info", msg:"Validating..." });

    // Clear previous error highlights
    if (cmRef.current) {
      for (let i = 0; i < cmRef.current.lineCount(); i++)
        cmRef.current.removeLineClass(i, "background", "cm-error-line");
    }

    try {
      const { parsed, rawCount } = analyseCode(c);
      const codeLines = c.split("\n").map(l=>l.trim())
        .filter(l=>l && !l.startsWith("#") && l!=="def run(page):" && l!=="pass" && l !== "pass  # No steps yet");

      if (parsed.length === 0 && codeLines.length > 0) {
        setStatus({ type:"error", msg:"No steps parsed. Check syntax." });
        setValidating(false);
        return;
      }

      // Server-side Python syntax check
      try {
        const result = await api("/api/validate-script", { method:"POST", body:{ code: c } });
        if (!result.valid && result.errors?.length) {
          const err = result.errors[0];
          setStatus({ type:"error", msg:`Line ${err.line}: ${err.message}`, line: err.line });
          if (cmRef.current && err.line) {
            cmRef.current.addLineClass(err.line-1, "background", "cm-error-line");
            cmRef.current.setCursor({ line: err.line-1, ch:0 });
            cmRef.current.focus();
          }
          setValidating(false);
          return;
        }
      } catch(e) { /* server unavailable — proceed with client parse */ }

      onChange(parsed.map(step => ({
        ...step,
        selector: step.selector ? smartSel(step.selector) : step.selector,
      })));
      setDirty(false);
      const msg = rawCount > 0
        ? `✅ Saved ${parsed.length} steps · ${rawCount} raw line${rawCount!==1?"s":""} preserved as-is`
        : `✅ Saved ${parsed.length} step${parsed.length!==1?"s":""}`;
      setStatus({ type:"ok", msg });
      if (cmRef.current) setTimeout(()=>updateGutterMarkers(cmRef.current),100);
    } catch(e) {
      setStatus({ type:"error", msg:"Parse error: " + e.message });
    }
    setValidating(false);
  };

  handleSaveRef.current = handleSave;

  const revert = () => {
    const orig = stepsToCode(steps);
    setCode(orig);
    if (cmRef.current) { cmRef.current.setValue(orig); updateGutterMarkers(cmRef.current); }
    setDirty(false); setStatus(null); setWarnings([]);
    if (cmRef.current)
      for (let i=0;i<cmRef.current.lineCount();i++)
        cmRef.current.removeLineClass(i,"background","cm-error-line");
  };

  const insertAtCursor = (snippet) => {
    if (!cmRef.current) return;
    const cursor = cmRef.current.getCursor();
    const lineContent = cmRef.current.getLine(cursor.line)||"";
    const indent = lineContent.match(/^(\s*)/)[1];
    const indented = snippet.split("\n").map((l,i)=>i===0?l:indent+l).join("\n");
    cmRef.current.replaceSelection(indented);
    cmRef.current.focus();
    setDirty(true);
  };

  const SNIPPETS = [
    { label:"goto",         code:`page.goto("https://")` },
    { label:"click",        code:`page.click(".selector")` },
    { label:"fill",         code:`page.fill(".selector", "value")` },
    { label:"assert text",  code:`assert "text" in page.locator(".selector").inner_text()` },
    { label:"assert visible",code:`assert page.locator(".selector").is_visible()` },
    { label:"wait",         code:`time.sleep(2)` },
    { label:"screenshot",   code:`page.screenshot(path="step.png")` },
  ];
  const CF_SNIPPETS = [
    { label:"for loop",   color:"#805ad5", code:`for __loop_index__ in range(3):\n    pass\n` },
    { label:"foreach",    color:"#6b46c1", code:`for item in ["a","b","c"]:\n    pass\n` },
    { label:"if/else",    color:"#d69e2e", code:`if page.locator(".el").is_visible():\n    pass\nelse:\n    pass\n` },
    { label:"try/except", color:"#e53e3e", code:`try:\n    pass\nexcept Exception as e:\n    page.screenshot(path="error.png")\n` },
  ];

  const navy = "#0d1425";

  const wrapStyle = fullscreen ? {
    position:"fixed", inset:0, zIndex:9000,
    background:"#1e1e2e", display:"flex", flexDirection:"column",
  } : { display:"flex", flexDirection:"column", gap:0 };

  const editorHeight = fullscreen ? "calc(100vh - 100px)" : "520px";

  return (
    <div style={wrapStyle}>

      {/* ── Toolbar ────────────────────────────────────────────────────────── */}
      <div style={{ display:"flex", gap:6, flexWrap:"wrap",
        padding: fullscreen ? "8px 12px" : "8px 0",
        background: fullscreen ? "#1e1e2e" : "transparent",
        borderBottom:"1px solid " + (fullscreen?"#333":"#e2e6ed"),
        alignItems:"center" }}>

        {/* Snippet inserts */}
        <span style={{ fontSize:10, fontWeight:700,
          color: fullscreen?"#9ca3af":"#8a96a8",
          letterSpacing:"0.08em", marginRight:2 }}>INSERT:</span>
        {SNIPPETS.map(sn=>(
          <button key={sn.label} onClick={()=>insertAtCursor(sn.code)}
            style={{ padding:"3px 8px", borderRadius:5, fontSize:11, cursor:"pointer",
              background: fullscreen?"#374151":"#fff",
              border:"1px solid " + (fullscreen?"#4b5563":"#e2e6ed"),
              color: fullscreen?"#d1d5db":"#4a5568" }}>
            {sn.label}
          </button>
        ))}
        <div style={{ width:1, height:20, background: fullscreen?"#374151":"#e2e6ed", margin:"0 2px" }}/>
        {CF_SNIPPETS.map(sn=>(
          <button key={sn.label} onClick={()=>insertAtCursor(sn.code)}
            style={{ padding:"3px 8px", borderRadius:5, fontSize:11, cursor:"pointer",
              background:"transparent",
              border:`1px solid ${sn.color}`, color:sn.color }}>
            {sn.label}
          </button>
        ))}

        {/* Right actions */}
        <div style={{ marginLeft:"auto", display:"flex", gap:6, alignItems:"center" }}>
          {/* Status */}
          {status && (
            <div style={{ fontSize:11, maxWidth:340, borderRadius:5, padding:"3px 8px",
              color:   status.type==="ok"?"#22c55e":status.type==="error"?"#ef4444":status.type==="warn"?"#f59e0b":"#9ca3af",
              background: status.type==="error"?"rgba(239,68,68,0.1)":status.type==="ok"?"rgba(34,197,94,0.1)":status.type==="warn"?"rgba(245,158,11,0.1)":"transparent",
              border: status.type!=="info"?"1px solid":"none",
              borderColor: status.type==="error"?"rgba(239,68,68,0.3)":status.type==="ok"?"rgba(34,197,94,0.3)":"rgba(245,158,11,0.3)" }}>
              {status.type==="error"&&"⚠ "}{status.type==="warn"&&"⚠ "}{status.msg}
              {status.line&&<span style={{marginLeft:6,opacity:0.6}}>line {status.line}</span>}
            </div>
          )}
          {dirty&&<button onClick={revert}
            style={{ padding:"4px 10px", borderRadius:5, fontSize:11, cursor:"pointer",
              background:"transparent", border:"1px solid #6b7280", color:"#9ca3af" }}>
            ↩ Revert
          </button>}
          <button data-save-btn onClick={()=>handleSave()} disabled={!dirty||validating}
            style={{ padding:"5px 14px", borderRadius:6, fontSize:12, fontWeight:700,
              cursor: dirty&&!validating?"pointer":"not-allowed",
              background: dirty&&!validating?"#1a56db":"#374151",
              border:"none", color:"#fff", opacity: dirty&&!validating?1:0.5 }}>
            {validating?"⏳ Checking...":"💾 Save to Steps"}
          </button>
          {/* Debug — single button, controls are in the panel below */}
          <button
            onClick={debugActive ? ()=>setShowDebugPanel(v=>!v) : startDebug}
            style={{ padding:"5px 16px", borderRadius:6, fontSize:12, fontWeight:700,
              cursor:"pointer", border:"none", color:"#fff", flexShrink:0,
              display:"flex", alignItems:"center", gap:6,
              background: debugActive
                ? (debugPaused ? "#d97706" : "#7c3aed")
                : "#7c3aed" }}>
            {debugActive
              ? (debugPaused ? "⏸ PAUSED — click to see controls" : "🐛 Debugging...")
              : "🐛 Debug"}
          </button>
          {/* Fullscreen toggle */}
          <button onClick={()=>{ setFullscreen(v=>!v); setTimeout(()=>{ if(cmRef.current) cmRef.current.refresh(); },50); }}
            title={fullscreen?"Exit fullscreen (Esc)":"Fullscreen"}
            style={{ padding:"5px 10px", borderRadius:6, fontSize:13, cursor:"pointer",
              background: fullscreen?"#374151":"#f3f4f6",
              border:"1px solid " + (fullscreen?"#4b5563":"#e2e6ed"),
              color: fullscreen?"#d1d5db":"#6b7280" }}>
            {fullscreen?"⊠ Exit":"⛶ Full"}
          </button>
        </div>
      </div>

      {/* ── Warning bar (unrecognised lines) ─────────────────────────────── */}
      {warnings.length > 0 && (
        <div style={{ background: fullscreen?"rgba(245,158,11,0.1)":"#fffbeb",
          border:"1px solid rgba(245,158,11,0.4)", borderRadius: fullscreen?0:7,
          padding:"6px 12px", display:"flex", alignItems:"center", gap:8,
          fontSize:11, color:"#92400e",
          margin: fullscreen?"0":"4px 0" }}>
          <span style={{ fontSize:13 }}>⚠</span>
          <span>
            <b>{warnings.length} line{warnings.length!==1?"s":""}</b> not in standard step format.
            They will be <b>preserved and executed as raw Python</b> — shown with 🟡 in gutter.
          </span>
          <span style={{ marginLeft:"auto", opacity:0.7, fontFamily:"monospace",
            maxWidth:300, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>
            {warnings.slice(0,2).join(" · ")}
          </span>
        </div>
      )}

      {/* ── Keyboard hints ───────────────────────────────────────────────── */}
      {!fullscreen && (
        <div style={{ fontSize:11, color:"#9ca3af", padding:"4px 0",
          display:"flex", gap:14, flexWrap:"wrap" }}>
          <span><b style={{color:"#6b7280"}}>Ctrl+S</b> save</span>
          <span><b style={{color:"#6b7280"}}>Tab</b> indent</span>
          <span><b style={{color:"#6b7280"}}>Ctrl+/</b> comment</span>
          <span><b style={{color:"#6b7280"}}>F9</b> toggle breakpoint</span>
          <span><b style={{color:"#6b7280"}}>🔴</b> breakpoint &nbsp; <b style={{color:"#6b7280"}}>🟡</b> raw/unrecognised line</span>
          {dirty&&<span style={{color:"#f59e0b",fontWeight:600}}>● unsaved changes</span>}
        </div>
      )}

      {/* ── CodeMirror ───────────────────────────────────────────────────── */}
      <style>{`
        .cm-error-line      { background: rgba(239,68,68,0.2) !important; }
        .cm-debug-current   { background: rgba(59,130,246,0.15) !important; border-left: 3px solid #3b82f6 !important; }
        .CodeMirror { height: ${editorHeight} !important; font-size:13px !important; font-family:'IBM Plex Mono','Fira Code',monospace !important; }
        .CodeMirror-scroll { min-height: 200px; }
        .CodeMirror-gutters { cursor: pointer; user-select:none; min-width:56px; }
        .CodeMirror-debug   { width:20px; }
        .CodeMirror-linenumber { padding: 0 6px 0 4px !important; }
        .dbg-log-error { color:#f87171; } .dbg-log-ok { color:#4ade80; }
        .dbg-log-pause { color:#fbbf24; } .dbg-log-warn { color:#fb923c; }
        .dbg-log-info  { color:#94a3b8; } .dbg-log-log  { color:#cbd5e1; }
      `}</style>

      {/* ── Debug Panel — shown ABOVE editor when active ─────────────── */}
      {showDebugPanel && (
        <div ref={debugPanelRef} style={{
          background: fullscreen?"#1a1a2e":"#0f172a",
          border:"1px solid #1e293b", borderRadius: fullscreen?0:10,
          marginBottom:6, overflow:"hidden"
        }}>
          {/* Debug panel header — controls always visible here */}
          <div style={{ padding:"10px 14px", borderBottom:"1px solid #1e293b",
            background:"#0d1117" }}>

            {/* Row 1: Status + URL + Slow-mo + Close */}
            <div style={{ display:"flex", alignItems:"center", gap:8, marginBottom:8 }}>
              {/* Status badge */}
              <span style={{ display:"inline-flex", alignItems:"center", gap:5,
                padding:"3px 10px", borderRadius:20, fontSize:11, fontWeight:700,
                background: debugActive ? (debugPaused?"rgba(245,158,11,0.15)":"rgba(34,197,94,0.12)") : "rgba(100,116,139,0.15)",
                color: debugActive ? (debugPaused?"#f59e0b":"#22c55e") : "#64748b",
                border: `1px solid ${debugActive?(debugPaused?"rgba(245,158,11,0.4)":"rgba(34,197,94,0.3)"):"rgba(100,116,139,0.3)"}` }}>
                <span style={{ width:7,height:7,borderRadius:"50%",flexShrink:0,
                  background: debugActive?(debugPaused?"#f59e0b":"#22c55e"):"#475569" }}/>
                {debugActive ? (debugPaused ? "⏸  PAUSED — waiting for command" : "▶  RUNNING") : "⬤  IDLE"}
              </span>
              {debugUrl && (
                <span style={{ fontSize:10, color:"#64748b", fontFamily:"monospace",
                  overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap",
                  maxWidth:320 }}>🌐 {debugUrl}</span>
              )}
              <div style={{ marginLeft:"auto", display:"flex", gap:6, alignItems:"center" }}>
                <label style={{ fontSize:10, color:"#64748b", display:"flex",
                  alignItems:"center", gap:4 }}>
                  Slow-mo:
                  <select value={debugSlowMo} onChange={e=>setDebugSlowMo(+e.target.value)}
                    disabled={debugActive}
                    style={{ background:"#1e293b", border:"1px solid #334155",
                      color:"#cbd5e1", borderRadius:4, padding:"2px 6px", fontSize:11 }}>
                    <option value={0}>Off</option>
                    <option value={300}>300ms</option>
                    <option value={500}>500ms</option>
                    <option value={1000}>1s</option>
                    <option value={2000}>2s</option>
                  </select>
                </label>
                <button onClick={()=>setShowDebugPanel(false)}
                  style={{ background:"none",border:"none",color:"#475569",
                    cursor:"pointer",fontSize:18,lineHeight:1 }}>×</button>
              </div>
            </div>

            {/* Row 2: Control buttons — ALWAYS visible here */}
            <div style={{ display:"flex", gap:8, alignItems:"center" }}>

              <button
                onClick={()=>sendDebugCommand("step")}
                disabled={!debugPaused || !debugActive}
                style={{ padding:"7px 18px", borderRadius:7, fontSize:12, fontWeight:700,
                  cursor: debugPaused&&debugActive ? "pointer" : "not-allowed",
                  background: debugPaused&&debugActive ? "#1d4ed8" : "#1e293b",
                  border: `1px solid ${debugPaused&&debugActive?"#3b82f6":"#334155"}`,
                  color: debugPaused&&debugActive ? "#fff" : "#475569",
                  transition:"all 0.15s", minWidth:90 }}>
                ⏭ Step Over
              </button>

              <button
                onClick={()=>sendDebugCommand("continue")}
                disabled={!debugPaused || !debugActive}
                style={{ padding:"7px 18px", borderRadius:7, fontSize:12, fontWeight:700,
                  cursor: debugPaused&&debugActive ? "pointer" : "not-allowed",
                  background: debugPaused&&debugActive ? "#059669" : "#1e293b",
                  border: `1px solid ${debugPaused&&debugActive?"#10b981":"#334155"}`,
                  color: debugPaused&&debugActive ? "#fff" : "#475569",
                  transition:"all 0.15s", minWidth:110 }}>
                ⏩ Continue
              </button>

              <button
                onClick={()=>sendDebugCommand("skip")}
                disabled={!debugPaused || !debugActive}
                style={{ padding:"7px 18px", borderRadius:7, fontSize:12, fontWeight:700,
                  cursor: debugPaused&&debugActive ? "pointer" : "not-allowed",
                  background: debugPaused&&debugActive ? "#d97706" : "#1e293b",
                  border: `1px solid ${debugPaused&&debugActive?"#f59e0b":"#334155"}`,
                  color: debugPaused&&debugActive ? "#fff" : "#475569",
                  transition:"all 0.15s", minWidth:90 }}>
                ⟶ Skip Step
              </button>

              <div style={{ width:1, height:24, background:"#1e293b", margin:"0 4px" }}/>

              <button
                onClick={stopDebug}
                disabled={!debugActive}
                style={{ padding:"7px 18px", borderRadius:7, fontSize:12, fontWeight:700,
                  cursor: debugActive ? "pointer" : "not-allowed",
                  background: debugActive ? "#dc2626" : "#1e293b",
                  border: `1px solid ${debugActive?"#ef4444":"#334155"}`,
                  color: debugActive ? "#fff" : "#475569",
                  transition:"all 0.15s" }}>
                ⏹ Stop
              </button>

              {!debugActive && (
                <button onClick={startDebug}
                  style={{ padding:"7px 18px", borderRadius:7, fontSize:12, fontWeight:700,
                    cursor:"pointer", background:"#7c3aed", border:"1px solid #8b5cf6",
                    color:"#fff" }}>
                  🐛 Start Debug
                </button>
              )}

              <span style={{ marginLeft:"auto", fontSize:10, color:"#334155" }}>
                {debugActive && debugPaused
                  ? "↑ Click a button to control execution"
                  : debugActive
                    ? "Running... set breakpoint (F9) or wait"
                    : "Click 🐛 Debug in toolbar or Start Debug above"}
              </span>
            </div>
          </div>

          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 1fr", height:220 }}>

            {/* Console log */}
            <div style={{ borderRight:"1px solid #1e293b", display:"flex",
              flexDirection:"column" }}>
              <div style={{ fontSize:10, fontWeight:700, color:"#64748b",
                padding:"4px 10px", borderBottom:"1px solid #1e293b",
                letterSpacing:"0.08em" }}>CONSOLE</div>
              <div style={{ flex:1, overflowY:"auto", padding:"6px 10px",
                fontFamily:"monospace", fontSize:11 }}
                ref={el => { if(el) el.scrollTop = el.scrollHeight; }}>
                {debugLogs.length===0
                  ? <div style={{color:"#334155"}}>No output yet...</div>
                  : debugLogs.map((l,i)=>(
                    <div key={i} className={`dbg-log-${l.type}`}
                      style={{ lineHeight:1.6, wordBreak:"break-all" }}>
                      {l.text}
                    </div>
                  ))}
              </div>
            </div>

            {/* Variables watch */}
            <div style={{ borderRight:"1px solid #1e293b", display:"flex",
              flexDirection:"column" }}>
              <div style={{ fontSize:10, fontWeight:700, color:"#64748b",
                padding:"4px 10px", borderBottom:"1px solid #1e293b",
                letterSpacing:"0.08em" }}>VARIABLES</div>
              <div style={{ flex:1, overflowY:"auto", padding:"6px 10px",
                fontFamily:"monospace", fontSize:11 }}>
                {Object.keys(debugVars).length===0
                  ? <div style={{color:"#334155"}}>No variables yet</div>
                  : Object.entries(debugVars).map(([k,v])=>(
                    <div key={k} style={{ marginBottom:4, display:"flex",
                      gap:6, alignItems:"flex-start" }}>
                      <span style={{ color:"#7dd3fc", flexShrink:0 }}>{k}</span>
                      <span style={{ color:"#475569" }}>=</span>
                      <span style={{ color:"#86efac", wordBreak:"break-all" }}>
                        {typeof v==="object" ? JSON.stringify(v) : String(v)}
                      </span>
                    </div>
                  ))}
              </div>
            </div>

            {/* Screenshot preview */}
            <div style={{ display:"flex", flexDirection:"column" }}>
              <div style={{ fontSize:10, fontWeight:700, color:"#64748b",
                padding:"4px 10px", borderBottom:"1px solid #1e293b",
                letterSpacing:"0.08em" }}>BROWSER PREVIEW</div>
              <div style={{ flex:1, display:"flex", alignItems:"center",
                justifyContent:"center", padding:6, overflow:"hidden" }}>
                {debugScreenshot
                  ? <img src={`data:image/png;base64,${debugScreenshot}`}
                      alt="Browser" style={{ maxWidth:"100%", maxHeight:"100%",
                        objectFit:"contain", borderRadius:4,
                        border:"1px solid #1e293b" }} />
                  : <div style={{ color:"#334155", fontSize:11, textAlign:"center" }}>
                      {debugActive ? "Waiting for screenshot..." : "Start debug to preview"}
                    </div>}
              </div>
            </div>
          </div>

          {/* Error detail */}
          {debugError && (
            <div style={{ padding:"8px 14px", borderTop:"1px solid #1e293b",
              background:"rgba(239,68,68,0.08)",
              fontSize:11, color:"#f87171", fontFamily:"monospace" }}>
              <b>✗ Step {debugError.stepIndex+1} failed:</b> {debugError.message}
            </div>
          )}
        </div>
      )}

      {/* ── CodeMirror Editor ────────────────────────────────────────────── */}
      <div style={{
        border:"1px solid " + (fullscreen?"#374151": dirty?"#f59e0b":"#2d3748"),
        borderRadius: fullscreen?0:8,
        overflow:"hidden",
        flex: fullscreen?1:undefined,
        transition:"border-color 0.2s"
      }}>
        <div ref={editorRef} style={{ height:"100%" }} />
      </div>

      {/* Fullscreen ESC hint */}
      {fullscreen && (
        <div style={{ background:"#1e1e2e", padding:"4px 12px",
          fontSize:11, color:"#4b5563", display:"flex", gap:16, alignItems:"center" }}>
          <span>Press <b style={{color:"#6b7280"}}>Esc</b> or click ⊠ to exit fullscreen</span>
          <span><b style={{color:"#6b7280"}}>Ctrl+S</b> save · <b style={{color:"#6b7280"}}>F9</b> breakpoint · <b style={{color:"#6b7280"}}>Ctrl+/</b> comment</span>
          {dirty&&<span style={{color:"#f59e0b",fontWeight:600,marginLeft:"auto"}}>● unsaved changes</span>}
        </div>
      )}
    </div>
  );

}, (prev, next) => prev.steps === next.steps);



// ── CallTestPicker — isolated component so typing doesn't re-render parent ──
function CallTestPicker({ step, stepIdx, projectId, onPick, onClear }) {
  const [search,   setSearch]   = React.useState("");
  const [results,  setResults]  = React.useState([]);
  const [loading,  setLoading]  = React.useState(false);
  const [cleared,  setCleared]  = React.useState(!step.value);
  const debounceRef = React.useRef(null);

  // Reset cleared flag when a value is provided from outside (e.g. on edit)
  React.useEffect(() => {
    if (step.value) setCleared(false);
    else setCleared(true);
  }, [step.value]);

  // Show selected test name in search box only when there IS a saved value
  // and user hasn't explicitly cleared it this session
  const displayName = !cleared && step.value && step.selector ? step.selector : "";

  const doSearch = async (q) => {
    if (q.length < 3) { setResults([]); return; }
    setLoading(true);
    try {
      const url = projectId
        ? `/api/tests/callable?project_id=${projectId}&search=${encodeURIComponent(q)}`
        : `/api/tests/callable?search=${encodeURIComponent(q)}`;
      const res = await api(url);
      setResults(res || []);
    } catch(e) {
      setResults([]);
    } finally {
      setLoading(false);
    }
  };

  const onType = (e) => {
    const q = e.target.value;
    setSearch(q);
    setResults([]);
    clearTimeout(debounceRef.current);
    if (q.length >= 3) {
      debounceRef.current = setTimeout(() => doSearch(q), 500);
    }
  };

  const pick = (tc) => {
    setSearch("");
    setResults([]);
    setCleared(false);
    clearTimeout(debounceRef.current);
    onPick(tc);
  };

  const clear = () => {
    setSearch("");
    setResults([]);
    setCleared(true);
    clearTimeout(debounceRef.current);
    onClear();
  };

  const hasSelected = !cleared && step.value && step.selector;

  return (
    <div style={{ display:"flex", flexDirection:"column", gap:10 }}>

      {/* Selected test card — shown when a test is picked */}
      {hasSelected && (
        <div style={{ display:"flex", gap:10, alignItems:"center",
          padding:"10px 14px", background:"#f0fdf4", border:"1px solid #86efac",
          borderRadius:8 }}>
          <span style={{ fontSize:20 }}>📞</span>
          <div style={{ flex:1 }}>
            <div style={{ fontSize:13, fontWeight:700, color:"#15803d" }}>
              {step.selector}
            </div>
            <div style={{ fontSize:11, color:"#16a34a", marginTop:2 }}>
              Test ID: {step.value}
            </div>
          </div>
          <button
            onMouseDown={e => { e.preventDefault(); clear(); }}
            style={{ padding:"4px 12px", fontSize:12, fontWeight:600,
              border:"1px solid #fca5a5", borderRadius:6, background:"#fff",
              color:"#e53935", cursor:"pointer" }}>
            ✕ Clear
          </button>
        </div>
      )}

      {/* Search input — always visible */}
      <div style={{ display:"flex", gap:8, alignItems:"center" }}>
        <span style={{ fontSize:12, color:"#6b7280", minWidth:80,
          flexShrink:0, fontWeight:600 }}>🔍 Search</span>
        <input
          style={{ flex:1, padding:"8px 12px", border:"1px solid #d1d5db",
            borderRadius:7, fontSize:13, outline:"none", fontFamily:"inherit",
            color:"#1a2332", background:"#fff" }}
          placeholder={hasSelected ? "Search to change selection..." : "Type 3+ chars (e.g. Patient, Login)..."}
          value={search}
          onChange={onType} />
        {loading && <span style={{ fontSize:13 }}>⏳</span>}
      </div>

      {/* Results list — shown below search */}
      {results.length > 0 && (
        <div style={{ marginLeft:88, border:"1px solid #bdd7f5", borderRadius:8,
          overflow:"hidden", background:"#fff",
          boxShadow:"0 4px 12px rgba(0,0,0,0.1)" }}>
          {results.map(tc => (
            <div key={tc.id}
              onMouseDown={e => { e.preventDefault(); pick(tc); }}
              style={{ padding:"10px 14px", cursor:"pointer", fontSize:13,
                borderBottom:"1px solid #f0f2f5", display:"flex",
                gap:10, alignItems:"center" }}
              onMouseEnter={e => e.currentTarget.style.background="#eff6ff"}
              onMouseLeave={e => e.currentTarget.style.background="#fff"}>
              <span style={{ fontFamily:"monospace", fontSize:11, color:"#8a96a8",
                background:"#f8f9fc", padding:"2px 7px", borderRadius:4, flexShrink:0 }}>
                #{tc.id}
              </span>
              <span style={{ color:"#1a2332", fontWeight:600 }}>{tc.name}</span>
            </div>
          ))}
        </div>
      )}

      {/* Status messages */}
      {search.length > 0 && search.length < 3 && (
        <div style={{ fontSize:11, color:"#8a96a8", paddingLeft:88 }}>
          Type {3 - search.length} more character{3 - search.length !== 1 ? "s" : ""}...
        </div>
      )}
      {search.length >= 3 && results.length === 0 && !loading && (
        <div style={{ fontSize:11, color:"#dc2626", paddingLeft:88 }}>
          No callable tests found for "{search}".
          First mark the test as callable: Edit test → tick "📞 Can be called".
        </div>
      )}

      <div style={{ fontSize:11, color:"#6b7280", background:"#f8fafc",
        border:"1px solid #e5e7eb", borderRadius:6, padding:"6px 10px" }}>
        💡 Only tests marked "📞 Can be called by other test cases" appear here.
        Max 10 results per search.
      </div>
    </div>
  );
}



// ─── TABLE MULTI ACTION UI ────────────────────────────────────────────────────
function TableMultiActionUI({ step, i, updateStep, launchInspector }) {
  const conditions = Array.isArray(step.conditions) ? step.conditions : [];
  const actions    = Array.isArray(step.actions)    ? step.actions    : [];

  const addCond = () => updateStep(i, "conditions", [...conditions, { col:"1", value:"", mode:"contains" }]);
  const addAct  = () => updateStep(i, "actions",    [...actions,    { col:"1", sub_action:"click", value:"", store_as:"" }]);

  const updCond = (ci, field, val) => {
    const nc = conditions.map((c,x) => x===ci ? {...c,[field]:val} : c);
    updateStep(i, "conditions", nc);
  };
  const updAct = (ai, field, val) => {
    const na = actions.map((a,x) => x===ai ? {...a,[field]:val} : a);
    updateStep(i, "actions", na);
  };
  const delCond = (ci) => updateStep(i, "conditions", conditions.filter((_,x)=>x!==ci));
  const delAct  = (ai) => updateStep(i, "actions",    actions.filter((_,x)=>x!==ai));

  return (
    <div style={{ display:"flex", flexDirection:"column", gap:8 }}>

      {/* Header + selector */}
      <div style={{ background:"#e6f1fb", border:"1px solid #b5d4f4", borderRadius:8, padding:"10px 12px" }}>
        <div style={{ fontSize:11, fontWeight:700, color:"#185fa5", marginBottom:8 }}>
          📊 Table Multi Action — Match multiple conditions, update multiple columns
        </div>
        <div style={{ display:"flex", gap:6, alignItems:"flex-end", marginBottom:8 }}>
          <div style={{ flex:1 }}>
            <label style={{ ...s.label, color:"#185fa5" }}>Table CSS selector *</label>
            <input style={{ ...s.input, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
              placeholder="e.g. table or table.indent-items"
              value={step.selector||""}
              onChange={e=>updateStep(i,"selector",e.target.value)} />
          </div>
          <button onClick={()=>launchInspector(i)}
            style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14, flexShrink:0 }}>🎯</button>
        </div>
        <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:8 }}>
          <div>
            <label style={{ ...s.label, color:"#185fa5" }}>Match logic</label>
            <select style={s.input} value={step.match_logic||"all"} onChange={e=>updateStep(i,"match_logic",e.target.value)}>
              <option value="all">ALL conditions must match (AND)</option>
              <option value="any">ANY condition matches (OR)</option>
            </select>
          </div>
          <div>
            <label style={{ ...s.label, color:"#185fa5" }}>Which matching row to act on</label>
            <select style={s.input} value={step.which_match||"first"} onChange={e=>updateStep(i,"which_match",e.target.value)}>
              <option value="first">Use first matching row</option>
              <option value="second">Use second matching row</option>
              <option value="third">Use third matching row</option>
              <option value="fourth">Use fourth matching row</option>
              <option value="fifth">Use fifth matching row</option>
              <option value="all">Update ALL matching rows</option>
            </select>
          </div>
        </div>
      </div>

      {/* CONDITIONS */}
      <div style={{ border:"1px solid #b5d4f4", borderRadius:8, padding:"10px 12px", background:"#f0f7ff" }}>
        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:8 }}>
          <span style={{ fontSize:12, fontWeight:700, color:"#185fa5" }}>Find the row — conditions</span>
          <button onClick={addCond} style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 10px" }}>+ Add condition</button>
        </div>
        {conditions.length===0 && (
          <div style={{ fontSize:12, color:"#9ca3af", textAlign:"center", padding:"8px 0" }}>
            No conditions yet — click "+ Add condition"
          </div>
        )}
        {conditions.map((cond,ci) => (
          <div key={ci} style={{ display:"grid", gridTemplateColumns:"70px 1fr 120px 24px", gap:6, alignItems:"flex-end", marginBottom:6 }}>
            <div>
              <label style={{ ...s.label, fontSize:10 }}>Col no.</label>
              <input type="number" min="1" style={{ ...s.input, fontFamily:"monospace", textAlign:"center" }}
                value={cond.col||"1"} onChange={e=>updCond(ci,"col",e.target.value)} />
            </div>
            <div>
              <label style={{ ...s.label, fontSize:10 }}>Match value</label>
              <input style={{ ...s.input, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                placeholder="e.g. PARACETAMOL or {{Item_name}}"
                value={cond.value||""} onChange={e=>updCond(ci,"value",e.target.value)} />
            </div>
            <div>
              <label style={{ ...s.label, fontSize:10 }}>Mode</label>
              <select style={s.input} value={cond.mode||"contains"} onChange={e=>updCond(ci,"mode",e.target.value)}>
                <option value="contains">Contains</option>
                <option value="equals">Equals</option>
                <option value="startswith">Starts with</option>
              </select>
            </div>
            <button onClick={()=>delCond(ci)}
              style={{ background:"none", border:"none", cursor:"pointer", color:"#e53e3e", fontSize:16, paddingBottom:2 }}>✕</button>
          </div>
        ))}
      </div>

      {/* ACTIONS */}
      <div style={{ border:"1px solid #9fe1cb", borderRadius:8, padding:"10px 12px", background:"#f0fdf8" }}>
        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:8 }}>
          <span style={{ fontSize:12, fontWeight:700, color:"#0f6e56" }}>Actions on matched row</span>
          <button onClick={addAct} style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 10px" }}>+ Add action</button>
        </div>
        {actions.length===0 && (
          <div style={{ fontSize:12, color:"#9ca3af", textAlign:"center", padding:"8px 0" }}>
            No actions yet — click "+ Add action"
          </div>
        )}
        {actions.map((act,ai) => (
          <div key={ai} style={{ display:"grid", gridTemplateColumns:"70px 140px 1fr 24px", gap:6, alignItems:"flex-end", marginBottom:6 }}>
            <div>
              <label style={{ ...s.label, fontSize:10, color:"#0f6e56" }}>Col no.</label>
              <input type="number" min="1" style={{ ...s.input, fontFamily:"monospace", textAlign:"center" }}
                value={act.col||"1"} onChange={e=>updAct(ai,"col",e.target.value)} />
            </div>
            <div>
              <label style={{ ...s.label, fontSize:10, color:"#0f6e56" }}>Action</label>
              <select style={s.input} value={act.sub_action||"click"} onChange={e=>updAct(ai,"sub_action",e.target.value)}>
                <option value="click">Click</option>
                <option value="type">Type value</option>
                <option value="select">Select dropdown</option>
                <option value="search_select">Search and select</option>
                <option value="get_text">Get text to variable</option>
                <option value="assert_text">Assert text</option>
                <option value="assert_visible">Assert visible</option>
                <option value="check">☑️ Check checkbox</option>
                <option value="uncheck">☐ Uncheck checkbox</option>
              </select>
            </div>
            <div>
              <label style={{ ...s.label, fontSize:10, color:"#0f6e56" }}>
                {act.sub_action==="click"||act.sub_action==="assert_visible"||act.sub_action==="check"||act.sub_action==="uncheck" ? "— no value needed —"
                  : act.sub_action==="get_text" ? "Store as variable name"
                  : "Value"}
              </label>
              {act.sub_action==="click"||act.sub_action==="assert_visible"||act.sub_action==="check"||act.sub_action==="uncheck"
                ? <input style={{ ...s.input, opacity:0.4 }} disabled placeholder="no value needed" />
                : <input style={{ ...s.input, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                    placeholder={act.sub_action==="get_text" ? "variable_name" : "value or {{var}}"}
                    value={act.sub_action==="get_text" ? (act.store_as||"") : (act.value||"")}
                    onChange={e=>updAct(ai, act.sub_action==="get_text" ? "store_as" : "value", e.target.value)} />
              }
            </div>
            <button onClick={()=>delAct(ai)}
              style={{ background:"none", border:"none", cursor:"pointer", color:"#e53e3e", fontSize:16, paddingBottom:2 }}>✕</button>
          </div>
        ))}
      </div>
    </div>
  );
}





// ─── FILE LIBRARY PICKER ────────────────────────────────────────────────────────────
// Replaces the plain text input for upload_attachment steps.
// User picks a file from the server library (previously uploaded) or uploads
// a new file from their local machine. The step value always stores the
// server-side path so the runner can use it with no changes.
function FileLibraryPicker({ value, onChange }) {
  const [open,       setOpen]       = useState(false);
  const [files,      setFiles]      = useState([]);
  const [loading,    setLoading]    = useState(false);
  const [uploading,  setUploading]  = useState(false);
  const [error,      setError]      = useState('');
  const fileRef = React.useRef();

  // Derive display name from the stored server path
  const displayName = value ? value.replace(/.*[\\/]/, '') : '';

  const loadFiles = async () => {
    setLoading(true); setError('');
    try {
      const token = localStorage.getItem('autoqa_token');
      const r = await fetch('/api/file-library', { headers: { Authorization: `Bearer ${token}` } });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Failed to load files');
      setFiles(d.files || []);
    } catch(e) { setError(e.message); }
    finally { setLoading(false); }
  };

  const openModal = () => { setOpen(true); loadFiles(); };

  const pickFile = (f) => {
    onChange(f.server_path);
    setOpen(false);
  };

  const deleteFile = async (f, e) => {
    e.stopPropagation();
    if (!confirm(`Delete "${f.filename}" from the server?`)) return;
    try {
      const token = localStorage.getItem('autoqa_token');
      await fetch(`/api/file-library/${encodeURIComponent(f.filename)}`,
        { method: 'DELETE', headers: { Authorization: `Bearer ${token}` } });
      setFiles(prev => prev.filter(x => x.filename !== f.filename));
      // Clear the step value if the deleted file was selected
      if (value && value.replace(/.*[\\/]/, '') === f.filename) onChange('');
    } catch(e) { alert('Delete failed: ' + e.message); }
  };

  const uploadFile = async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    setUploading(true); setError('');
    try {
      const token = localStorage.getItem('autoqa_token');
      const fd = new FormData();
      fd.append('file', file);
      const r = await fetch('/api/file-library', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: fd,
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || 'Upload failed');
      // Auto-select the just-uploaded file and close
      onChange(d.server_path);
      setOpen(false);
    } catch(e) { setError(e.message); }
    finally { setUploading(false); if(fileRef.current) fileRef.current.value=''; }
  };

  const fmtSize = (b) => b < 1024 ? `${b} B` : b < 1024*1024 ? `${(b/1024).toFixed(1)} KB` : `${(b/1024/1024).toFixed(1)} MB`;
  const fmtDate = (iso) => { const d=new Date(iso); return d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}); };

  return (
    <>
      {/* Compact inline display */}
      <div style={{ display:'flex', alignItems:'center', gap:6, flex:1 }}>
        <div style={{ flex:1, background:'#f8fafc', border:'1px solid #d1d5db', borderRadius:6,
          padding:'6px 10px', fontSize:12, color: displayName ? '#1e40af' : '#9ca3af',
          fontFamily:"'IBM Plex Mono',monospace", overflow:'hidden', textOverflow:'ellipsis',
          whiteSpace:'nowrap', minWidth:0 }}>
          {displayName ? `📄 ${displayName}` : 'No file selected'}
        </div>
        <button
          onClick={openModal}
          style={{ flexShrink:0, padding:'6px 12px', fontSize:12, fontWeight:600,
            background:'#1a6fc4', color:'#fff', border:'none', borderRadius:6, cursor:'pointer' }}>
          📂 Choose File
        </button>
        {displayName && (
          <button onClick={()=>onChange('')}
            style={{ flexShrink:0, padding:'5px 8px', fontSize:11, color:'#ef4444',
              background:'#fff', border:'1px solid #fca5a5', borderRadius:6, cursor:'pointer' }}>
            ✕
          </button>
        )}
      </div>

      {/* Modal */}
      {open && (
        <div style={{ position:'fixed', inset:0, zIndex:9999, background:'rgba(0,0,0,0.45)',
          display:'flex', alignItems:'center', justifyContent:'center' }}
          onClick={e=>e.target===e.currentTarget&&setOpen(false)}>
          <div style={{ background:'#fff', borderRadius:14, width:560, maxWidth:'95vw',
            maxHeight:'80vh', display:'flex', flexDirection:'column',
            boxShadow:'0 20px 60px rgba(0,0,0,0.25)', overflow:'hidden' }}>

            {/* Header */}
            <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between',
              padding:'16px 20px', borderBottom:'1px solid #e5e7eb' }}>
              <div style={{ fontSize:16, fontWeight:700, color:'#1a2332' }}>📁 File Library</div>
              <button onClick={()=>setOpen(false)}
                style={{ background:'none', border:'none', fontSize:20, cursor:'pointer', color:'#6b7280' }}>×</button>
            </div>

            {/* Upload strip */}
            <div style={{ padding:'14px 20px', background:'#f0f7ff',
              borderBottom:'1px solid #bdd7f5', display:'flex', alignItems:'center', gap:12 }}>
              <div style={{ fontSize:13, fontWeight:600, color:'#185fa5' }}>⬆️ Upload new file from your computer</div>
              <input ref={fileRef} type='file' onChange={uploadFile}
                style={{ display:'none' }} id='flp-file-input' />
              <label htmlFor='flp-file-input'
                style={{ padding:'7px 16px', background: uploading?'#9ca3af':'#1a6fc4',
                  color:'#fff', borderRadius:7, fontSize:12, fontWeight:600,
                  cursor: uploading?'not-allowed':'pointer', flexShrink:0 }}>
                {uploading ? '⏳ Uploading...' : 'Choose File'}
              </label>
              <div style={{ fontSize:11, color:'#6b7280' }}>Max 50 MB</div>
            </div>

            {/* Error */}
            {error && (
              <div style={{ padding:'8px 20px', background:'#fff5f5', color:'#c53030',
                fontSize:12, borderBottom:'1px solid #fed7d7' }}>⚠️ {error}</div>
            )}

            {/* File list */}
            <div style={{ flex:1, overflowY:'auto', padding:'12px 16px' }}>
              {loading ? (
                <div style={{ textAlign:'center', padding:32, color:'#9ca3af', fontSize:13 }}>⏳ Loading files...</div>
              ) : files.length === 0 ? (
                <div style={{ textAlign:'center', padding:32, color:'#9ca3af', fontSize:13 }}>
                  <div style={{ fontSize:32, marginBottom:8 }}>📂</div>
                  No files uploaded yet. Upload one above to get started.
                </div>
              ) : (
                <table style={{ width:'100%', borderCollapse:'collapse', fontSize:13 }}>
                  <thead>
                    <tr style={{ background:'#f8fafc' }}>
                      <th style={{ padding:'8px 10px', textAlign:'left', fontWeight:600,
                        color:'#6b7280', fontSize:11, textTransform:'uppercase',
                        borderBottom:'1px solid #e5e7eb' }}>File name</th>
                      <th style={{ padding:'8px 10px', textAlign:'right', fontWeight:600,
                        color:'#6b7280', fontSize:11, textTransform:'uppercase',
                        borderBottom:'1px solid #e5e7eb', whiteSpace:'nowrap' }}>Size</th>
                      <th style={{ padding:'8px 10px', textAlign:'right', fontWeight:600,
                        color:'#6b7280', fontSize:11, textTransform:'uppercase',
                        borderBottom:'1px solid #e5e7eb', whiteSpace:'nowrap' }}>Uploaded</th>
                      <th style={{ width:36, borderBottom:'1px solid #e5e7eb' }}></th>
                    </tr>
                  </thead>
                  <tbody>
                    {files.map(f => {
                      const isSelected = value && value.replace(/.*[\\/]/, '') === f.filename;
                      return (
                        <tr key={f.filename}
                          onClick={()=>pickFile(f)}
                          style={{ cursor:'pointer', borderBottom:'1px solid #f3f4f6',
                            background: isSelected ? '#eff6ff' : 'transparent',
                            transition:'background 0.1s' }}
                          onMouseEnter={e=>!isSelected&&(e.currentTarget.style.background='#f9fafb')}
                          onMouseLeave={e=>!isSelected&&(e.currentTarget.style.background='transparent')}>
                          <td style={{ padding:'10px 10px' }}>
                            <div style={{ display:'flex', alignItems:'center', gap:7 }}>
                              <span style={{ fontSize:16 }}>
                                {/\.(pdf)$/i.test(f.filename)?'📄':
                                 /\.(xlsx?|csv)$/i.test(f.filename)?'📊':
                                 /\.(docx?)$/i.test(f.filename)?'📝':
                                 /\.(jpe?g|png|gif|webp|bmp)$/i.test(f.filename)?'🖼️':
                                 /\.(zip|rar|7z)$/i.test(f.filename)?'🗂️':'📄'}
                              </span>
                              <span style={{ fontWeight: isSelected?700:400,
                                color: isSelected?'#1e40af':'#1a2332' }}>{f.filename}</span>
                              {isSelected && (
                                <span style={{ fontSize:10, background:'#1a6fc4', color:'#fff',
                                  padding:'1px 7px', borderRadius:10, fontWeight:700 }}>✓ selected</span>
                              )}
                            </div>
                          </td>
                          <td style={{ padding:'10px 10px', textAlign:'right',
                            color:'#6b7280', whiteSpace:'nowrap' }}>{fmtSize(f.size)}</td>
                          <td style={{ padding:'10px 10px', textAlign:'right',
                            color:'#6b7280', whiteSpace:'nowrap' }}>{fmtDate(f.uploaded_at)}</td>
                          <td style={{ padding:'10px 6px', textAlign:'center' }}>
                            <button
                              onClick={e=>deleteFile(f,e)}
                              title='Delete from server'
                              style={{ background:'none', border:'none', cursor:'pointer',
                                color:'#ef4444', fontSize:15, padding:'2px 4px',
                                borderRadius:4, lineHeight:1 }}>
                              🗑️
                            </button>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              )}
            </div>

            {/* Footer */}
            <div style={{ padding:'12px 20px', borderTop:'1px solid #e5e7eb',
              background:'#f9fafb', display:'flex', justifyContent:'space-between',
              alignItems:'center' }}>
              <div style={{ fontSize:11, color:'#9ca3af' }}>
                Files are stored on the server and reusable across all test scripts.
              </div>
              <button onClick={()=>setOpen(false)}
                style={{ padding:'7px 16px', fontSize:12, fontWeight:600,
                  background:'#f3f4f6', color:'#374151', border:'1px solid #d1d5db',
                  borderRadius:7, cursor:'pointer' }}>Close</button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}


function StepEditor({ steps, onChange, variables, projectId }) {
  const [varPicker,   setVarPicker]  = useState(null);
  const [selected,    setSelected]   = useState(new Set()); // selected step indices
  const [clipboard,   setClipboard]  = useState([]);        // copied steps
  const [selectMode,  setSelectMode] = useState(false);     // checkbox mode on/off

  const [inspStep,    setInspStep]   = useState(null);
  const [inspLoading, setInspLoading]= useState(false);
  const [inspResult,  setInspResult] = useState(null);
  const [inspUrl,     setInspUrl]    = useState("");
  const inspSid = useRef(null);
  const inspWs  = useRef(null);

  const closeInspector = () => {
    if (inspSid.current) { api("/api/inspector/" + inspSid.current, { method:"DELETE" }).catch(()=>{}); inspSid.current = null; }
    if (inspWs.current)  { inspWs.current.close(); inspWs.current = null; }
    setInspResult(null); setInspStep(null); setInspLoading(false);
  };

  const launchInspector = async (stepIdx) => {
    if (inspSid.current) { setInspStep(stepIdx); setInspResult(null); return; }
    setInspStep(stepIdx); setInspResult(null); setInspLoading(true);
    try {
      const d = await api("/api/inspector/start", { method:"POST", body:{} });
      inspSid.current = d.session_id;
      const ws = new WebSocket(WS + "?runId=" + d.session_id);
      inspWs.current = ws;
      ws.onmessage = (e) => {
        const msg = JSON.parse(e.data);
        if (msg.type==="picked") { setInspResult({ selectors:msg.selectors, element:msg.element, stepIdx }); setInspLoading(false); }
        if (msg.type==="error")  { alert("Inspector error: "+msg.message); closeInspector(); }
        if (msg.type==="cancelled"||msg.type==="closed") {
          inspSid.current=null;
          if(inspWs.current){inspWs.current.close();inspWs.current=null;}
          setInspStep(null); setInspLoading(false);
        }
      };
      ws.onerror = () => {};
      ws.onopen  = () => setInspLoading(false); // just show instructions, wait for extension
    } catch(err) { alert("Inspector error: "+err.message); closeInspector(); }
  };

  const applySelector = (selValue) => { updateStep(inspResult.stepIdx, "selector", selValue); closeInspector(); };
  const addStep       = () => onChange([...steps, { action:"navigate", selector:"", value:"", timeout:30000 }]);
  const updateStep    = (i, field, val) => { const ns=[...steps]; ns[i]={...ns[i],[field]:val}; onChange(ns); };
  const updateStepAndSave = (i, field, val) => { const ns=[...steps]; ns[i]={...ns[i],[field]:val}; onChange(ns); setTimeout(()=>{ const btn=document.querySelector('[data-save-btn]'); if(btn)btn.click(); },100); };
  const removeStep    = (i) => onChange(steps.filter((_,idx)=>idx!==i));
  const moveStep      = (i, dir) => { const ns=[...steps]; const j=i+dir; if(j<0||j>=ns.length) return; [ns[i],ns[j]]=[ns[j],ns[i]]; onChange(ns); };
  const insertStep    = (i) => {
    const ns = [...steps];
    ns.splice(i+1, 0, { action:"click", selector:"", value:"", timeout:30000 });
    onChange(ns);
  };
  const duplicateStep = (i) => {
    const ns = [...steps];
    ns.splice(i+1, 0, { ...JSON.parse(JSON.stringify(steps[i])) });
    onChange(ns);
  };

  // ── Multi-select copy/paste ───────────────────────────────────────────────
  const toggleSelect  = (i) => setSelected(prev => {
    const s = new Set(prev);
    s.has(i) ? s.delete(i) : s.add(i);
    return s;
  });
  const selectAll     = () => setSelected(new Set(steps.map((_,i)=>i)));
  const clearSelect   = () => { setSelected(new Set()); setSelectMode(false); };

  const copySelected  = () => {
    const copied = [...selected].sort((a,b)=>a-b).map(i => JSON.parse(JSON.stringify(steps[i])));
    setClipboard(copied);
    setSelected(new Set());
    setSelectMode(false);
  };

  const cutSelected   = () => {
    const sorted = [...selected].sort((a,b)=>a-b);
    const copied = sorted.map(i => JSON.parse(JSON.stringify(steps[i])));
    setClipboard(copied);
    const ns = steps.filter((_,i) => !selected.has(i));
    onChange(ns);
    setSelected(new Set());
    setSelectMode(false);
  };

  const deleteSelected = () => {
    onChange(steps.filter((_,i) => !selected.has(i)));
    setSelected(new Set());
    setSelectMode(false);
  };

  // pasteAfter(i) — paste clipboard after position i (-1 = paste at top)
  const pasteAfter = (i) => {
    if (!clipboard.length) return;
    const ns = [...steps];
    ns.splice(i+1, 0, ...clipboard.map(s => JSON.parse(JSON.stringify(s))));
    onChange(ns);
  };

  const insertVar = (name) => {
    if (!varPicker) return;
    const cur = steps[varPicker.stepIdx]?.[varPicker.field] || "";
    updateStep(varPicker.stepIdx, varPicker.field, cur + "{{" + name + "}}");
    setVarPicker(null);
  };

  const CF_ACTIONS = ["loop_start","loop_end","foreach_start","foreach_end",
    "if_start","else","if_end","switch_start","case","switch_end",
    "break","continue","repeat_until","repeat_until_end",
    "try_start","catch_start","try_end","wait_until","group"];

  const cfStyle = (action) => {
    if (["loop_start","loop_end"].includes(action))               return { border:"2px solid #805ad5", background:"#faf5ff" };
    if (["foreach_start","foreach_end"].includes(action))         return { border:"2px solid #6b46c1", background:"#f5f0ff" };
    if (["if_start","else","if_end"].includes(action))            return { border:"2px solid #d69e2e", background:"#fffff0" };
    if (["switch_start","case","switch_end"].includes(action))    return { border:"2px solid #2b6cb0", background:"#ebf8ff" };
    if (["break","continue"].includes(action))                    return { border:"2px solid #e53e3e", background:"#fff5f5" };
    if (["repeat_until","repeat_until_end"].includes(action))     return { border:"2px solid #38b2ac", background:"#e6fffa" };
    if (["try_start","catch_start","try_end"].includes(action))   return { border:"2px solid #e53e3e", background:"#fff5f5" };
    if (action==="wait_until")                                    return { border:"2px solid #3182ce", background:"#ebf8ff" };
    if (action==="group")                                         return { border:"1px dashed #a0aec0", background:"#f7fafc" };
    return {};
  };

  const getIndent = (steps, idx) => {
    let depth=0;
    for(let i=0;i<idx;i++){
      const a=steps[i].action;
      if(["loop_start","foreach_start","if_start","switch_start","repeat_until","try_start"].includes(a)) depth++;
      if(["loop_end","foreach_end","if_end","switch_end","repeat_until_end","try_end"].includes(a)) depth=Math.max(0,depth-1);
      if(["else","catch_start"].includes(a)) depth=Math.max(0,depth-1);
      if(a==="case") depth=Math.max(1,depth);
    }
    return depth;
  };

  const IF_CONDITIONS = [
    { value:"element_visible",    label:"Element is visible" },
    { value:"element_not_visible",label:"Element is NOT visible" },
    { value:"var_equals",         label:"Variable == value" },
    { value:"var_not_equals",     label:"Variable != value" },
    { value:"var_contains",       label:"Variable contains" },
    { value:"url_contains",       label:"URL contains" },
    { value:"url_not_contains",   label:"URL does NOT contain" },
    { value:"page_title_contains",label:"Page title contains" },
  ];

  const needsSelector = ["click","type","clear","select","search_select","check","uncheck","hover","press","press_sequentially","compare_pdf_page",
    "double_click","right_click","upload_attachment","download","drag_and_drop","focus","blur",
    "wait_for_selector","assert_text","assert_not_text","assert_visible","assert_not_visible",
    "assert_attribute","assert_css","assert_enabled","assert_disabled","assert_checked",
    "assert_not_checked","assert_selected","assert_value","assert_count",
    "store_text","store_value","store_attr","store_count"];

  const hasVars = (variables||[]).length > 0;

  const VarBtn = ({ stepIdx, field }) => hasVars ? (
    <button style={{ position:"absolute", right:6, top:"50%", transform:"translateY(-50%)",
      ...s.btn("purple",true), padding:"3px 8px", fontSize:10 }}
      onClick={()=>setVarPicker({stepIdx,field})}>{"{{..}}"}</button>
  ) : null;

  return (
    <div>
      {/* Variable picker */}
      {varPicker && hasVars && (
        <div style={{ background:"#f8f9fc", border:"1px solid #1a6fc4", borderRadius:8, padding:10, marginBottom:10 }}>
          <div style={{ fontSize:11, color:"#1a6fc4", fontWeight:700, marginBottom:8 }}>
            Pick a variable for step #{varPicker.stepIdx+1}:
          </div>
          <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
            {variables.map(v=>(
              <button key={v.name} style={{ ...s.btn("purple",true), fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                onClick={()=>insertVar(v.name)}>
                {"{{"}{v.name}{"}}"} <span style={{fontSize:10,opacity:0.7}}>{v.type}</span>
              </button>
            ))}
          </div>
          <button style={{ ...s.btn("ghost",true), marginTop:8, fontSize:11 }} onClick={()=>setVarPicker(null)}>Cancel</button>
        </div>
      )}

      {/* ── Select Mode toolbar ─────────────────────────────────────────── */}
      <div style={{ display:"flex", gap:8, alignItems:"center", marginBottom:6,
        padding:"6px 10px", background: selectMode?"#eff6ff":"#f8f9fc",
        borderRadius:8, border: selectMode?"1px solid #bdd7f5":"1px solid #e2e6ed",
        flexWrap:"wrap", position:"sticky", top:0, zIndex:10 }}>
        {/* Toggle select mode */}
        <button
          onClick={()=>{ setSelectMode(m=>!m); setSelected(new Set()); }}
          style={{ ...s.btn(selectMode?"primary":"ghost", true), fontSize:12, padding:"4px 12px" }}>
          {selectMode ? "✓ Selecting..." : "☐ Select Steps"}
        </button>

        {selectMode && (<>
          <button onClick={selectAll}
            style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 8px" }}>
            All
          </button>
          <button onClick={()=>setSelected(new Set())}
            style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 8px" }}>
            None
          </button>
          <span style={{ fontSize:11, color:"#64748b", padding:"0 4px" }}>
            {selected.size} selected
          </span>

          {selected.size > 0 && (<>
            <div style={{ width:1, height:18, background:"#e2e6ed", margin:"0 2px" }}/>
            <button onClick={copySelected}
              title="Copy selected steps to clipboard"
              style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 10px",
                color:"#1a6fc4", borderColor:"#bdd7f5", background:"#eff6ff", fontWeight:600 }}>
              📋 Copy
            </button>
            <button onClick={cutSelected}
              title="Cut selected steps (copy + remove)"
              style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 10px",
                color:"#d97706", borderColor:"#fde68a", background:"#fffbeb", fontWeight:600 }}>
              ✂️ Cut
            </button>
            <button onClick={deleteSelected}
              title="Delete selected steps"
              style={{ ...s.btn("danger",true), fontSize:11, padding:"3px 10px" }}>
              🗑 Delete
            </button>
          </>)}
        </>)}

        {/* Clipboard info + paste at end */}
        {clipboard.length > 0 && !selectMode && (
          <>
            <div style={{ width:1, height:18, background:"#e2e6ed", margin:"0 2px" }}/>
            <span style={{ fontSize:11, color:"#1a6fc4", background:"#eff6ff",
              padding:"3px 8px", borderRadius:6, border:"1px solid #bdd7f5" }}>
              📋 {clipboard.length} step{clipboard.length>1?"s":""} copied
            </span>
            <button onClick={()=>pasteAfter(steps.length-1)}
              style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 10px",
                color:"#1a6fc4", borderColor:"#bdd7f5", fontWeight:600 }}>
              ⬇ Paste at End
            </button>
            <button onClick={()=>setClipboard([])}
              style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 6px", color:"#9ca3af" }}>
              ✕
            </button>
          </>
        )}
      </div>

      {/* Steps list */}
      {steps.map((step, i) => {
        const insertBefore = i === 0 ? null : (
          <div
            style={{ height:10, display:"flex", alignItems:"center",
              cursor:"pointer", opacity:0, transition:"opacity 0.15s", margin:"0 2px" }}
            onMouseEnter={e=>e.currentTarget.style.opacity="1"}
            onMouseLeave={e=>e.currentTarget.style.opacity="0"}
            onClick={()=>insertStep(i-1)}>
            <div style={{ flex:1, height:2, background:"#1a6fc4", borderRadius:2, opacity:0.5 }}/>
            <span style={{ padding:"1px 8px", fontSize:10, fontWeight:700, color:"#fff",
              background:"#1a6fc4", borderRadius:8, margin:"0 4px", whiteSpace:"nowrap" }}>
              + insert here
            </span>
            {clipboard.length > 0 && (
              <span
                onClick={e=>{ e.stopPropagation(); pasteAfter(i-1); }}
                style={{ padding:"1px 8px", fontSize:10, fontWeight:700, color:"#fff",
                  background:"#7c3aed", borderRadius:8, margin:"0 4px", whiteSpace:"nowrap",
                  cursor:"pointer" }}>
                📋 paste {clipboard.length} here
              </span>
            )}
            <div style={{ flex:1, height:2, background:"#1a6fc4", borderRadius:2, opacity:0.5 }}/>
          </div>
        );
        const indent   = getIndent(steps, i);
        const extra    = cfStyle(step.action);
        const isCF     = CF_ACTIONS.includes(step.action);
        const isElseTag= ["else","if_end","loop_end","foreach_end","switch_end","repeat_until_end","try_end"].includes(step.action);
        const isBreak  = step.action==="break";
        const isCont   = step.action==="continue";
        const isGroup  = step.action==="group";
        const isCallTest = step.action==="call_test";
        const isLoop   = step.action==="loop_start";
        const isForeach= step.action==="foreach_start";
        const isIF     = step.action==="if_start";
        const isSwitch = step.action==="switch_start";
        const isCase   = step.action==="case";
        const STORE_ACTIONS = ["store_text","store_value","store_attr","store_url","store_title","store_count","store_js","get_table_value"];
        const STR_ACTIONS   = ["str_upper","str_lower","str_trim","str_replace","str_substring","str_concat","str_length","str_split"];
        const MATH_ACTIONS  = ["math_add","math_subtract","math_multiply","math_divide","math_round","math_abs","math_random"];
        const DATE_ACTIONS  = ["date_today","date_now","date_add","date_subtract","date_format","date_diff"];
        const ENC_ACTIONS   = ["encode_base64","decode_base64","url_encode","url_decode","json_parse","json_extract"];
        const VAR_ASSERT    = ["assert_equals","assert_not_equals","assert_contains","assert_not_contains",
                               "assert_starts_with","assert_ends_with","assert_greater","assert_less",
                               "assert_between","assert_matches","assert_empty","assert_not_empty","assert_soft"];
        const isStore    = STORE_ACTIONS.includes(step.action);
        const isStoreUrl = step.action==="store_url";
        const isStrOp    = STR_ACTIONS.includes(step.action);
        const isMathOp   = MATH_ACTIONS.includes(step.action);
        const isDateOp   = DATE_ACTIONS.includes(step.action);
        const isEncOp    = ENC_ACTIONS.includes(step.action);
        const isVarAssert= VAR_ASSERT.includes(step.action);
        const isAssertVar = isVarAssert;
        const isEncodeOp  = isEncOp;
        const needsStoreAs = isStore||isStoreUrl||isStrOp||isMathOp||isDateOp||isEncOp;
        const isRepeat = step.action==="repeat_until";
        const isTry    = step.action==="try_start";
        const isCatch  = step.action==="catch_start";
        const isWaitU  = step.action==="wait_until";

        return (
          <React.Fragment key={i}>
          {insertBefore}
          <div style={{ display:"flex", alignItems:"flex-start", gap:0 }}>
          {selectMode && (
            <div style={{ paddingTop:10, paddingRight:4, flexShrink:0 }}>
              <input type="checkbox"
                checked={selected.has(i)}
                onChange={()=>toggleSelect(i)}
                style={{ width:16, height:16, cursor:"pointer", accentColor:"#1a6fc4" }}/>
            </div>
          )}
          <div style={{ flex:1 }}>
          <div style={{
            background:"#ffffff", border:"1px solid #e2e6ed", borderRadius:8,
            padding:12, marginBottom:6, marginLeft:indent*18,
            opacity: step.disabled ? 0.5 : 1,
            ...extra }}>

            {/* Header row */}
            <div style={{ display:"flex", gap:6, alignItems:"center", marginBottom:8 }}>
              <span style={{ fontSize:11, color:"#8a96a8", minWidth:24, fontFamily:"'IBM Plex Mono',monospace" }}>{i+1}</span>
              {/* Disable/Enable toggle */}
              <button
                title={step.disabled ? "Step disabled — click to enable" : "Step enabled — click to disable"}
                onClick={()=>updateStep(i, "disabled", !step.disabled)}
                style={{ flexShrink:0, padding:"2px 8px", borderRadius:10, fontSize:10, fontWeight:700, cursor:"pointer", border:"1px solid",
                  background: step.disabled ? "#f3f4f6" : "#dcfce7",
                  borderColor: step.disabled ? "#d1d5db" : "#86efac",
                  color: step.disabled ? "#9ca3af" : "#16a34a" }}>
                {step.disabled ? "OFF" : "ON"}
              </button>
              {step._healed && (
                <span title="AI healed this selector" style={{ fontSize:10, background:"#7c3aed", color:"#fff", padding:"1px 6px", borderRadius:10, fontWeight:700, flexShrink:0 }}>🤖 healed</span>
              )}
              {step.disabled && (
                <span style={{ fontSize:10, background:"#f3f4f6", color:"#9ca3af", padding:"1px 8px", borderRadius:10, fontWeight:700, flexShrink:0, textDecoration:"line-through" }}>DISABLED</span>
              )}
              <SearchableSelect
                value={step.action}
                onChange={(newAction) => updateStep(i, "action", newAction)}
                options={ACTIONS}
                placeholder="Type to search actions..."
              />
              <button style={s.btn("ghost",true)} onClick={()=>moveStep(i,-1)} title="Move up">↑</button>
              <button style={s.btn("ghost",true)} onClick={()=>moveStep(i,1)} title="Move down">↓</button>
              <button
                title="Insert new step below this one"
                onClick={()=>insertStep(i)}
                style={{ ...s.btn("ghost",true), padding:"4px 8px", color:"#1a6fc4",
                  borderColor:"#bdd7f5", background:"#eff6ff", fontSize:13, fontWeight:700 }}>
                +
              </button>
              <button
                title="Duplicate this step"
                onClick={()=>duplicateStep(i)}
                style={{ ...s.btn("ghost",true), padding:"4px 7px", fontSize:11, color:"#6b7280" }}>
                ⎘
              </button>
              <button style={{ ...s.btn("danger",true), padding:"4px 8px" }} onClick={()=>removeStep(i)} title="Delete step">✕</button>
            </div>

            {/* ── Step Description / Note ── */}
            <textarea
              placeholder="📝 Step note (optional) — describe what this step does"
              value={step.description||""}
              onChange={e=>updateStep(i,"description",e.target.value)}
              rows={2}
              style={{ width:"100%", fontSize:11,
                color: step.description ? "#1e40af" : "#9ca3af",
                background: step.description ? "#eff6ff" : "#fafafa",
                border: step.description ? "1px solid #93c5fd" : "1px solid #e5e7eb",
                borderRadius:5, padding:"6px 10px",
                marginTop:4, boxSizing:"border-box",
                fontStyle: step.description ? "normal" : "italic",
                outline:"none", fontFamily:"inherit",
                resize:"vertical", lineHeight:1.5 }}
            />

            {/* ── Skip Translation ── */}
            {(step.action === "type" || step.action === "search_select") && (
              <div style={{ display:"flex", alignItems:"center", gap:8, marginTop:6 }}>
                <input type="checkbox"
                  checked={!!step.no_translate}
                  onChange={e => updateStep(i, "no_translate", e.target.checked ? true : undefined)}
                  style={{ cursor:"pointer" }}
                />
                <span style={{ fontSize:11, fontWeight:600, color:"#6b7280", cursor:"pointer" }}>
                  🚫 Skip translation (use original value)
                </span>
              </div>
            )}

            {/* ── Retry on fail (all steps) ── */}
            {!isElseTag && !isBreak && !isCont && (
              <div style={{ display:"flex", alignItems:"center", gap:8, marginTop:6 }}>
                <span style={{ fontSize:11, fontWeight:600, color:"#6b7280" }}>🔄 Retry on fail:</span>
                <select
                  value={step.retry_count || 0}
                  onChange={e => updateStep(i, "retry_count", parseInt(e.target.value))}
                  style={{ fontSize:11, padding:"2px 6px", borderRadius:4,
                    border:"1px solid #d1d5db", background:"#fff", cursor:"pointer" }}>
                  <option value={0}>No</option>
                  <option value={1}>Yes — 1x</option>
                  <option value={2}>Yes — 2x</option>
                  <option value={3}>Yes — 3x</option>
                </select>
                {(step.retry_count > 0) && (
                  <span style={{ fontSize:11, color:"#6b7280", display:"flex", alignItems:"center", gap:4 }}>
                    delay:
                    <input type="number" min={500} max={10000} step={500}
                      value={step.retry_delay_ms || 1000}
                      onChange={e => updateStep(i, "retry_delay_ms", parseInt(e.target.value))}
                      style={{ width:60, fontSize:11, padding:"1px 4px", borderRadius:4,
                        border:"1px solid #d1d5db", textAlign:"center" }}
                    />ms
                  </span>
                )}
              </div>
            )}

            {/* Close/marker tags */}
            {isElseTag && (
              <div style={{ fontSize:12, color:"#8a96a8", fontStyle:"italic", paddingLeft:30 }}>
                {step.action==="else"?"— ELSE: steps below run when IF is false —"
                :step.action==="if_end"?"— END IF —"
                :step.action==="loop_end"?"— END LOOP —"
                :step.action==="foreach_end"?"— END FOR EACH —"
                :step.action==="repeat_until_end"?"— condition checked here — repeats if FALSE —"
                :step.action==="try_end"?"— END TRY/CATCH —"
                :"— END SWITCH —"}
              </div>
            )}
            {(isBreak||isCont) && (
              <div style={{ fontSize:12, fontStyle:"italic", paddingLeft:30,
                color:isBreak?"#e53e3e":"#ed8936" }}>
                {isBreak?"— exits the current loop immediately —":"— skips to the next loop iteration —"}
              </div>
            )}

            {/* Group */}
            {isGroup && (
              <input style={{ ...s.input, fontStyle:"italic", color:"#4a5568" }}
                placeholder="Group label / comment..."
                value={step.value||""}
                onChange={e=>updateStep(i,"value",e.target.value)} />
            )}

            {isCallTest && (
              <CallTestPicker
                key={`ct_${i}`}
                step={step}
                stepIdx={i}
                projectId={projectId}
                onPick={(tc) => {
                  // Batch update in single onChange call to avoid mid-remount
                  const ns = [...steps];
                  ns[i] = { ...ns[i], value: String(tc.id), selector: tc.name };
                  onChange(ns);
                }}
                onClear={() => {
                  const ns = [...steps];
                  ns[i] = { ...ns[i], value: "", selector: "" };
                  onChange(ns);
                }}
              />
            )}

            {/* Loop */}
            {isLoop && (() => {
              const dt        = step.data_table || {};
              const dtEnabled = !!dt.enabled;
              const cols      = dt.columns || [""];
              const rows      = dt.rows    || [[""]];

              const setDT = (patch) => {
                const cur = step.data_table || { enabled:false, columns:[""], rows:[[""]] };
                updateStep(i, "data_table", { ...cur, ...patch });
              };
              const setCol = (ci, val) => {
                const c = [...cols]; c[ci] = val; setDT({ columns:c });
              };
              const setCell = (ri, ci, val) => {
                const r = rows.map(row=>[...row]);
                if (!r[ri]) r[ri] = [];
                r[ri][ci] = val;
                setDT({ rows:r });
              };
              const addCol = () => {
                setDT({ columns:[...cols,""], rows: rows.map(r=>[...r,""]) });
              };
              const removeCol = (ci) => {
                if (cols.length <= 1) return;
                setDT({ columns: cols.filter((_,j)=>j!==ci), rows: rows.map(r=>r.filter((_,j)=>j!==ci)) });
              };
              const addRow = () => {
                setDT({ rows:[...rows, cols.map(()=>"")] });
              };
              const removeRow = (ri) => {
                if (rows.length <= 1) return;
                setDT({ rows: rows.filter((_,j)=>j!==ri) });
              };

              return (
                <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
                  <div style={{ display:"flex", gap:8, alignItems:"center", flexWrap:"wrap" }}>
                    {!dtEnabled && <>
                      <span style={{ fontSize:12, color:"#805ad5", fontWeight:700 }}>Repeat</span>
                      <input style={{ ...s.input, width:80 }} type="number" min="1"
                        placeholder="3" value={step.value||""}
                        onChange={e=>updateStep(i,"value",e.target.value)} />
                      <span style={{ fontSize:12, color:"#805ad5", fontWeight:700 }}>times</span>
                    </>}
                    <label style={{ display:"flex", alignItems:"center", gap:6, cursor:"pointer",
                      fontSize:12, color:"#805ad5", fontWeight:700,
                      background:"#ede9fe", padding:"4px 10px", borderRadius:20,
                      border:"1px solid #c4b5fd" }}>
                      <input type="checkbox" checked={dtEnabled}
                        onChange={e => setDT({ enabled:e.target.checked,
                          columns: cols.length?cols:[""],
                          rows: rows.length?rows:[[""]] })} />
                      &nbsp;Use Data Table
                    </label>
                    {!dtEnabled && (
                      <span style={{ fontSize:11, color:"#8a96a8" }}>
                        Use <code style={{background:"#ede9fe",padding:"1px 5px",borderRadius:3}}>{"{{__loop_index__}}"}</code> for index
                      </span>
                    )}
                  </div>

                  {dtEnabled && (
                    <div style={{ background:"#faf5ff", border:"1px solid #c4b5fd",
                      borderRadius:10, padding:"12px 14px" }}>
                      <div style={{ display:"flex", justifyContent:"space-between",
                        alignItems:"center", marginBottom:10 }}>
                        <div style={{ fontSize:12, fontWeight:700, color:"#6d28d9" }}>
                          📋 Data Table — {rows.length} row{rows.length!==1?"s":""}, {cols.length} column{cols.length!==1?"s":""}
                        </div>
                        <div style={{ display:"flex", gap:6 }}>
                          <button onClick={addCol}
                            style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 8px",
                              color:"#7c3aed", borderColor:"#c4b5fd" }}>+ Column</button>
                          <button onClick={addRow}
                            style={{ ...s.btn("ghost",true), fontSize:11, padding:"3px 8px",
                              color:"#7c3aed", borderColor:"#c4b5fd" }}>+ Row</button>
                        </div>
                      </div>
                      <div style={{ overflowX:"auto" }}>
                        <table style={{ borderCollapse:"collapse", width:"100%", fontSize:12 }}>
                          <thead>
                            <tr>
                              <th style={{ padding:"4px 8px", color:"#8a96a8", fontSize:10, textAlign:"center", width:28 }}>#</th>
                              {cols.map((col,ci) => (
                                <th key={ci} style={{ padding:"4px 4px", minWidth:120 }}>
                                  <div style={{ display:"flex", alignItems:"center", gap:3 }}>
                                    <input
                                      style={{ ...s.input, margin:0, fontSize:11, padding:"3px 7px",
                                        fontWeight:700, background:"#ede9fe", borderColor:"#c4b5fd", color:"#6d28d9" }}
                                      placeholder={"col"+(ci+1)}
                                      value={col}
                                      onChange={e=>setCol(ci,e.target.value)} />
                                    {cols.length > 1 && (
                                      <button onClick={()=>removeCol(ci)}
                                        style={{ background:"none", border:"none", cursor:"pointer",
                                          color:"#e53e3e", fontSize:14, padding:"0 2px" }}>×</button>
                                    )}
                                  </div>
                                  <div style={{ fontSize:10, color:"#9c4fd6", marginTop:2, textAlign:"center" }}>
                                    {col ? "{{"+col+"}}" : ""}
                                  </div>
                                </th>
                              ))}
                              <th style={{ width:24 }}/>
                            </tr>
                          </thead>
                          <tbody>
                            {rows.map((row,ri) => (
                              <tr key={ri} style={{ background: ri%2===0?"#fff":"#f5f3ff" }}>
                                <td style={{ padding:"3px 8px", color:"#a0aec0", fontSize:10, textAlign:"center" }}>{ri+1}</td>
                                {cols.map((_,ci) => (
                                  <td key={ci} style={{ padding:"3px 4px" }}>
                                    <input
                                      style={{ ...s.input, margin:0, fontSize:12, padding:"4px 8px" }}
                                      placeholder={cols[ci]||("col"+(ci+1))}
                                      value={(row&&row[ci])||""}
                                      onChange={e=>setCell(ri,ci,e.target.value)} />
                                  </td>
                                ))}
                                <td style={{ padding:"3px 4px" }}>
                                  {rows.length > 1 && (
                                    <button onClick={()=>removeRow(ri)}
                                      style={{ background:"none", border:"none", cursor:"pointer",
                                        color:"#e53e3e", fontSize:14, padding:"0 3px" }}>×</button>
                                  )}
                                </td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                      <div style={{ fontSize:11, color:"#7c3aed", marginTop:8 }}>
                        💡 Use <code style={{background:"#ede9fe",padding:"1px 5px",borderRadius:3}}>{"{{column_name}}"}</code> in any step inside this loop to use column values per row
                      </div>
                    </div>
                  )}
                  {/* Continue on assertion fail */}
                  <div style={{ display:"flex", alignItems:"center", gap:8, marginTop:8,
                    padding:"8px 12px", background:"#fef9c3", border:"1px solid #fde68a",
                    borderRadius:7 }}>
                    <input type="checkbox" id={`cof_loop_${i}`}
                      checked={!!step.continue_on_fail}
                      onChange={e=>updateStep(i,"continue_on_fail",e.target.checked)}
                      style={{ width:15, height:15, cursor:"pointer" }} />
                    <label htmlFor={`cof_loop_${i}`} style={{ fontSize:12, fontWeight:600,
                      color:"#92400e", cursor:"pointer" }}>
                      🟡 Continue on assertion fail
                    </label>
                    <span style={{ fontSize:11, color:"#b45309", marginLeft:4 }}>
                      — complete all iterations, collect all failures, mark test failed at end
                    </span>
                  </div>
                  {/* Retry on fail */}
                  <div style={{ display:"flex", alignItems:"center", gap:8, marginTop:8,
                    padding:"8px 12px", background:"#eff6ff", border:"1px solid #bfdbfe",
                    borderRadius:7 }}>
                    <span style={{ fontSize:12, fontWeight:600, color:"#1e40af" }}>🔄 Retry on fail:</span>
                    <select
                      value={step.retry_count || 0}
                      onChange={e => updateStep(i, "retry_count", parseInt(e.target.value))}
                      style={{ fontSize:12, padding:"2px 6px", borderRadius:4,
                        border:"1px solid #93c5fd", background:"#fff", cursor:"pointer", color:"#1e40af" }}>
                      <option value={0}>No</option>
                      <option value={1}>Yes — 1x</option>
                      <option value={2}>Yes — 2x</option>
                      <option value={3}>Yes — 3x</option>
                    </select>
                    {(step.retry_count > 0) && (
                      <span style={{ fontSize:11, color:"#3b82f6", display:"flex", alignItems:"center", gap:4 }}>
                        delay:
                        <input
                          type="number" min={500} max={10000} step={500}
                          value={step.retry_delay_ms || 1000}
                          onChange={e => updateStep(i, "retry_delay_ms", parseInt(e.target.value))}
                          style={{ width:65, fontSize:11, padding:"1px 4px", borderRadius:4,
                            border:"1px solid #93c5fd", textAlign:"center" }}
                        />ms
                      </span>
                    )}
                  </div>
                </div>
              );
            })()}
            {/* ForEach */}
            {isForeach && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#6b46c1", fontWeight:700, minWidth:80 }}>Items</span>
                  <div style={{ flex:1, position:"relative" }}>
                    <input style={{ ...s.input, paddingRight:hasVars?80:12 }}
                      placeholder="a, b, c  OR  {{list_var}}"
                      value={step.value||""}
                      onChange={e=>updateStep(i,"value",e.target.value)} />
                    <VarBtn stepIdx={i} field="value" />
                  </div>
                </div>
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#6b46c1", fontWeight:700, minWidth:80 }}>Item var</span>
                  <input style={{ ...s.input, width:180 }}
                    placeholder="current_item"
                    value={step.loop_var||"current_item"}
                    onChange={e=>updateStep(i,"loop_var",e.target.value)} />
                  <span style={{ fontSize:11, color:"#8a96a8" }}>
                    Use <code style={{background:"#ede9fe",padding:"1px 5px",borderRadius:3}}>{"{{current_item}}"}</code> inside this loop
                  </span>
                </div>
                {/* Continue on assertion fail */}
                <div style={{ display:"flex", alignItems:"center", gap:8, marginTop:4,
                  padding:"8px 12px", background:"#fef9c3", border:"1px solid #fde68a",
                  borderRadius:7 }}>
                  <input type="checkbox" id={`cof_${i}`}
                    checked={!!step.continue_on_fail}
                    onChange={e=>updateStep(i,"continue_on_fail",e.target.checked)}
                    style={{ width:15, height:15, cursor:"pointer" }} />
                  <label htmlFor={`cof_${i}`} style={{ fontSize:12, fontWeight:600,
                    color:"#92400e", cursor:"pointer" }}>
                    🟡 Continue on assertion fail
                  </label>
                  <span style={{ fontSize:11, color:"#b45309", marginLeft:4 }}>
                    — complete all iterations, collect all failures, then mark test as failed
                  </span>
                </div>
              </div>
            )}

            {/* IF */}
            {isIF && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#d69e2e", fontWeight:700, minWidth:40 }}>IF</span>
                  <select style={{ ...s.input, flex:1 }}
                    value={step.if_condition||"element_visible"}
                    onChange={e=>updateStep(i,"if_condition",e.target.value)}>
                    {IF_CONDITIONS.map(c=>(<option key={c.value} value={c.value}>{c.label}</option>))}
                  </select>
                </div>
                {["element_visible","element_not_visible"].includes(step.if_condition||"element_visible") && (
                  <div style={{ display:"flex", gap:6 }}>
                    <input style={{ ...s.input, flex:1 }}
                      placeholder="selector / get_by_role(...)"
                      value={step.if_selector||""}
                      onChange={e=>updateStep(i,"if_selector",e.target.value)} />
                    <button onClick={()=>launchInspector(i)}
                      style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14 }}>🎯</button>
                  </div>
                )}
                {["var_equals","var_not_equals","var_contains"].includes(step.if_condition||"") && (
                  <>
                    <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                      <span style={{ fontSize:12, color:"#8a96a8", minWidth:70 }}>Variable</span>
                      <div style={{ flex:1, position:"relative" }}>
                        <input style={{ ...s.input, paddingRight:hasVars?80:12 }}
                          placeholder="{{var_name}}" value={step.if_var||""}
                          onChange={e=>updateStep(i,"if_var",e.target.value)} />
                        <VarBtn stepIdx={i} field="if_var" />
                      </div>
                    </div>
                    <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                      <span style={{ fontSize:12, color:"#8a96a8", minWidth:70 }}>Equals</span>
                      <input style={{ ...s.input, flex:1 }}
                        placeholder="expected value" value={step.if_value||""}
                        onChange={e=>updateStep(i,"if_value",e.target.value)} />
                    </div>
                  </>
                )}
                {["url_contains","url_not_contains","page_title_contains"].includes(step.if_condition||"") && (
                  <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                    <span style={{ fontSize:12, color:"#8a96a8", minWidth:70 }}>Value</span>
                    <input style={{ ...s.input, flex:1 }}
                      placeholder="text to match" value={step.if_value||""}
                      onChange={e=>updateStep(i,"if_value",e.target.value)} />
                  </div>
                )}
              </div>
            )}

            {/* Repeat Until */}
            {isRepeat && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                <div style={{ fontSize:12, color:"#38b2ac", fontWeight:700 }}>Repeat until this condition is TRUE:</div>
                <select style={{ ...s.input }}
                  value={step.if_condition||"element_visible"}
                  onChange={e=>updateStep(i,"if_condition",e.target.value)}>
                  {IF_CONDITIONS.map(c=>(<option key={c.value} value={c.value}>{c.label}</option>))}
                </select>
                {["element_visible","element_not_visible"].includes(step.if_condition||"element_visible") && (
                  <div style={{ display:"flex", gap:6 }}>
                    <input style={{ ...s.input, flex:1 }} placeholder="selector"
                      value={step.if_selector||""} onChange={e=>updateStep(i,"if_selector",e.target.value)} />
                    <button onClick={()=>launchInspector(i)} style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14 }}>🎯</button>
                  </div>
                )}
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Max retries</span>
                  <input style={{ ...s.input, width:80 }} type="number" min="1" placeholder="10"
                    value={step.max_retries||""} onChange={e=>updateStep(i,"max_retries",e.target.value)} />
                  <span style={{ fontSize:12, color:"#8a96a8" }}>interval:</span>
                  <input style={{ ...s.input, width:80 }} type="number" min="500" placeholder="2000"
                    value={step.interval_ms||""} onChange={e=>updateStep(i,"interval_ms",e.target.value)} />
                  <span style={{ fontSize:12, color:"#8a96a8" }}>ms</span>
                </div>
              </div>
            )}

            {/* Try */}
            {isTry && (
              <div style={{ fontSize:12, color:"#c53030", lineHeight:1.7, paddingLeft:4 }}>
                <b>Try block:</b> steps below will be attempted.<br/>
                If any step fails → execution jumps to the <b>Catch</b> block.
              </div>
            )}

            {/* Catch */}
            {isCatch && (
              <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                <div style={{ fontSize:12, color:"#c53030", lineHeight:1.7 }}>
                  <b>Catch block:</b> runs only if a step in Try failed.
                </div>
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:100 }}>Store error in</span>
                  <input style={{ ...s.input, width:180 }}
                    placeholder="error_message (variable name)"
                    value={step.error_var||""} onChange={e=>updateStep(i,"error_var",e.target.value)} />
                </div>
              </div>
            )}

            {/* Wait Until */}
            {isWaitU && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                <div style={{ fontSize:12, color:"#3182ce", fontWeight:700 }}>Pause until condition is TRUE:</div>
                <select style={{ ...s.input }}
                  value={step.if_condition||"element_visible"}
                  onChange={e=>updateStep(i,"if_condition",e.target.value)}>
                  {IF_CONDITIONS.map(c=>(<option key={c.value} value={c.value}>{c.label}</option>))}
                </select>
                {["element_visible","element_not_visible"].includes(step.if_condition||"element_visible") && (
                  <div style={{ display:"flex", gap:6 }}>
                    <input style={{ ...s.input, flex:1 }} placeholder="selector"
                      value={step.if_selector||""} onChange={e=>updateStep(i,"if_selector",e.target.value)} />
                    <button onClick={()=>launchInspector(i)} style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14 }}>🎯</button>
                  </div>
                )}
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Timeout</span>
                  <input style={{ ...s.input, width:100 }} type="number" placeholder="30000"
                    value={step.timeout||""} onChange={e=>updateStep(i,"timeout",e.target.value)} />
                  <span style={{ fontSize:12, color:"#8a96a8" }}>ms</span>
                </div>
                <div style={{ display:"flex", gap:8, alignItems:"center", marginTop:4 }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Retry</span>
                  <input style={{ ...s.input, width:60 }} type="number" placeholder="0" min="0" max="5"
                    value={step.retry_count||""} onChange={e=>updateStep(i,"retry_count",+e.target.value)} />
                  <span style={{ fontSize:12, color:"#8a96a8" }}>times</span>
                  <input style={{ ...s.input, width:80 }} type="number" placeholder="1000" min="0"
                    value={step.retry_delay_ms||""} onChange={e=>updateStep(i,"retry_delay_ms",+e.target.value)} />
                  <span style={{ fontSize:12, color:"#8a96a8" }}>ms delay</span>
                </div>
              </div>
            )}

            {/* Switch */}
            {isSwitch && (
              <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                <span style={{ fontSize:12, color:"#2b6cb0", fontWeight:700, minWidth:80 }}>Switch on</span>
                <div style={{ flex:1, position:"relative" }}>
                  <input style={{ ...s.input, paddingRight:hasVars?80:12 }}
                    placeholder="{{variable_name}}" value={step.value||""}
                    onChange={e=>updateStep(i,"value",e.target.value)} />
                  <VarBtn stepIdx={i} field="value" />
                </div>
              </div>
            )}

            {/* Case */}
            {isCase && (
              <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                <span style={{ fontSize:12, color:"#2b6cb0", fontWeight:700, minWidth:80 }}>When ==</span>
                <input style={{ ...s.input, flex:1 }}
                  placeholder="exact value to match" value={step.value||""}
                  onChange={e=>updateStep(i,"value",e.target.value)} />
              </div>
            )}

            {/* Store text/value */}
            {isStore && (
              <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                <div style={{ display:"flex", gap:6 }}>
                  <input style={{ ...s.input, flex:1 }}
                    placeholder="selector / get_by_role(...)"
                    value={step.selector||""}
                    onChange={e=>updateStep(i,"selector",e.target.value)} />
                  <button onClick={()=>launchInspector(i)}
                    style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14 }}>🎯</button>
                </div>
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Store into</span>
                  <input style={{ ...s.input, flex:1 }}
                    placeholder="variable_name (no braces)"
                    value={step.value||""}
                    onChange={e=>updateStep(i,"value",e.target.value)} />
                </div>
              </div>
            )}

            {/* Store URL */}
            {isStoreUrl && (
              <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Store into</span>
                <input style={{ ...s.input, flex:1 }}
                  placeholder="variable_name"
                  value={step.value||""}
                  onChange={e=>updateStep(i,"value",e.target.value)} />
              </div>
            )}

            {/* Extended store — attr, js, count, title */}
            {(step.action==="store_attr") && (
              <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                <div style={{ display:"flex", gap:6 }}>
                  <input style={{ ...s.input, flex:1 }}
                    placeholder="selector / get_by_role(...)"
                    value={step.selector||""}
                    onChange={e=>updateStep(i,"selector",e.target.value)} />
                  <button onClick={()=>launchInspector(i)}
                    style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14 }}>🎯</button>
                </div>
                <input style={s.input} placeholder="Attribute name (e.g. href, value, data-id)"
                  value={step.attr_name||""} onChange={e=>updateStep(i,"attr_name",e.target.value)} />
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Store into</span>
                  <input style={{ ...s.input, flex:1 }} placeholder="variable_name"
                    value={step.value||""} onChange={e=>updateStep(i,"value",e.target.value)} />
                </div>
              </div>
            )}
            {(step.action==="store_js") && (
              <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                <input style={{ ...s.input, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                  placeholder="JS expression (e.g. document.title)"
                  value={step.js_expr||""} onChange={e=>updateStep(i,"js_expr",e.target.value)} />
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Store into</span>
                  <input style={{ ...s.input, flex:1 }} placeholder="variable_name"
                    value={step.value||""} onChange={e=>updateStep(i,"value",e.target.value)} />
                </div>
              </div>
            )}

            {/* ── get_table_value UI ── */}
            {(step.action==="get_table_value") && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                {/* Info banner */}
                <div style={{ background:"#fdf4ff", border:"1px solid #e9d5ff", borderRadius:7,
                  padding:"8px 12px", fontSize:12, color:"#7e22ce", lineHeight:1.6 }}>
                  📋 Finds the row with this label and extracts the numeric value.<br/>
                  <span style={{ color:"#6d28d9", fontWeight:600 }}>
                    🎯 Auto-detects popover/modal context
                  </span>
                  {" "}— if a popover is open when this step runs, it searches inside the popover first.
                  Leave <b>Table selector</b> blank for auto-detect.
                </div>
                {/* Label to search */}
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:90, flexShrink:0 }}>
                    Row label
                  </span>
                  <input style={{ ...s.input, flex:1 }}
                    placeholder="e.g. Gross Amount, Net Payable, Total..."
                    value={step.value||""} onChange={e=>updateStep(i,"value",e.target.value)} />
                </div>
                {/* Store as */}
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:90, flexShrink:0 }}>
                    Store as var
                  </span>
                  <input style={{ ...s.input, flex:1 }}
                    placeholder="variable_name (optional)"
                    value={step.store_as||""} onChange={e=>updateStep(i,"store_as",e.target.value)} />
                </div>
                {/* Compare with */}
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:90, flexShrink:0 }}>
                    Compare with
                  </span>
                  <input style={{ ...s.input, flex:1, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                    placeholder="{{variable}} or 1180.00 (optional — leave blank to just store)"
                    value={step.value2||""} onChange={e=>updateStep(i,"value2",e.target.value)} />
                </div>
                {/* Optional table selector */}
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <span style={{ fontSize:12, color:"#8a96a8", minWidth:90, flexShrink:0 }}>
                    Table selector
                  </span>
                  <input style={{ ...s.input, flex:1, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                    placeholder="Optional CSS selector to scope to a specific table"
                    value={step.selector||""} onChange={e=>updateStep(i,"selector",e.target.value)} />
                </div>
                <div style={{ fontSize:11, color:"#9ca3af", marginTop:2, lineHeight:1.7 }}>
                  💡 <b>Auto-context detection order:</b><br/>
                  1. Open popover / modal (if any visible) → searches inside it first<br/>
                  2. Highest z-index visible overlay with a table<br/>
                  3. Falls back to full page if not found in overlay<br/>
                  Commas stripped automatically — <code>1,180.00</code> compares equal to <code>1180</code>
                </div>
                {/* Continue on fail toggle */}
                {step.value2 && (
                  <div style={{ display:"flex", alignItems:"center", gap:8,
                    background: "#fff5f5",
                    border: "1px solid #fecaca",
                    borderRadius:7, padding:"8px 12px" }}>
                    <input type="checkbox"
                      id={`cof-${i}`}
                      checked={step.continue_on_fail !== false}
                      onChange={e => updateStep(i, "continue_on_fail", e.target.checked ? true : false)}
                      style={{ width:15, height:15, cursor:"pointer", accentColor:"#e53935" }} />
                    <label htmlFor={`cof-${i}`} style={{ fontSize:12, cursor:"pointer",
                      color: "#dc2626", fontWeight:600 }}>
                      {step.continue_on_fail === false
                        ? "❌ Stop test if amount doesn't match"
                        : "⚠️ Continue even if amount doesn't match (logs as soft fail)"}
                    </label>
                  </div>
                )}
              </div>
            )}

            {/* Assert variable actions */}
            {isAssertVar && (() => {
              const a = step.action;
              const needsVal2 = !["assert_empty","assert_not_empty"].includes(a);
              const needsVal3 = ["assert_between","str_replace","str_substring","math_random","date_format","date_diff"].includes(a);
              return (
                <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                  <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                    <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Value / Var</span>
                    <input style={{ ...s.input, flex:1, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                      placeholder="{{variable}} or literal value"
                      value={step.value||""} onChange={e=>updateStep(i,"value",e.target.value)} />
                  </div>
                  {needsVal2 && (
                    <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                      <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>
                        {a==="assert_between"?"Min value":a==="assert_matches"?"Regex pattern":"Expected"}
                      </span>
                      <input style={{ ...s.input, flex:1 }}
                        placeholder={a==="assert_matches"?"e.g. ^\\d{10}$":"expected value or {{var}}"}
                        value={step.value2||""} onChange={e=>updateStep(i,"value2",e.target.value)} />
                    </div>
                  )}
                  {needsVal3 && (
                    <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                      <span style={{ fontSize:12, color:"#8a96a8", minWidth:80 }}>Max value</span>
                      <input style={{ ...s.input, flex:1 }} placeholder="max value"
                        value={step.value3||""} onChange={e=>updateStep(i,"value3",e.target.value)} />
                    </div>
                  )}
                </div>
              );
            })()}

            {/* String / Math / Date / Encode ops */}
            {(isStrOp||isMathOp||isDateOp||isEncodeOp) && (() => {
              const a = step.action;
              const labels = {
                str_replace:   ["Variable", "Find text", "Replace with"],
                str_substring: ["Variable", "Start index", "End index"],
                str_split:     ["Variable", "Delimiter", "Part index"],
                str_concat:    ["Variable", "Append text", null],
                math_add:      ["Variable", "Add value", null],
                math_subtract: ["Variable", "Subtract value", null],
                math_multiply: ["Variable", "Multiply by", null],
                math_divide:   ["Variable", "Divide by", null],
                math_round:    ["Variable", "Decimal places", null],
                math_random:   ["Store into", "Min", "Max"],
                date_today:    ["Store into", "Format (e.g. DD/MM/YYYY or %d/%m/%Y)", null],
                date_now:      ["Store into", "Format (e.g. DD/MM/YYYY HH:mm:SS)", null],
                date_add:      ["Variable", "Format (e.g. DD/MM/YYYY)", "Days to add"],
                date_subtract: ["Variable", "Format (e.g. DD/MM/YYYY)", "Days to subtract"],
                date_format:   ["Variable", "Input format (e.g. DD/MM/YYYY)", "Output format (e.g. YYYY-MM-DD)"],
                date_diff:     ["Variable (date1)", "Format (e.g. DD/MM/YYYY)", "Date 2 string"],
              };
              const [l1="Variable", l2=null, l3=null] = labels[a] || [];
              return (
                <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                  <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                    <span style={{ fontSize:12, color:"#8a96a8", minWidth:90 }}>{l1}</span>
                    <input style={{ ...s.input, flex:1, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                      placeholder="{{variable_name}}" value={step.value||""}
                      onChange={e=>updateStep(i,"value",e.target.value)} />
                  </div>
                  {l2 && (
                    <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                      <span style={{ fontSize:12, color:"#8a96a8", minWidth:90 }}>{l2}</span>
                      <input style={{ ...s.input, flex:1 }}
                        placeholder={a==="str_split" ? "space or comma or - (no quotes needed)" : l2}
                        value={step.value2||""}
                        onChange={e => {
                          let v = e.target.value;
                          // Auto-strip surrounding quotes if user types " " or ' '
                          if (a === "str_split" && v.length >= 2 &&
                              ((v[0] === '"' && v[v.length-1] === '"') ||
                               (v[0] === "\'" && v[v.length-1] === "\'"))) {
                            v = v.slice(1, -1);
                          }
                          updateStep(i,"value2",v);
                        }} />
                    </div>
                  )}
                  {a==="str_split" && (
                    <div style={{ fontSize:11, color:"#8a96a8", paddingLeft:98 }}>
                      💡 Type delimiter WITHOUT quotes — just a space, comma, etc. Index is 0-based (first part = 0)
                    </div>
                  )}
                  {l3 && (
                    <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                      <span style={{ fontSize:12, color:"#8a96a8", minWidth:90 }}>{l3}</span>
                      <input style={{ ...s.input, flex:1 }} placeholder={l3}
                        value={step.value3||""} onChange={e=>updateStep(i,"value3",e.target.value)} />
                    </div>
                  )}
                  {/* store_as: optional field to save result into a different variable */}
                  {!["math_random","date_today","date_now","json_extract"].includes(a) && (
                    <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                      <span style={{ fontSize:12, color:"#8a96a8", minWidth:90 }}>Store as var</span>
                      <input style={{ ...s.input, flex:1, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                        placeholder={`${(step.value||"").replace(/[{}]/g,"").trim() || "same_variable"} (leave blank to overwrite)`}
                        value={step.store_as||""}
                        onChange={e=>updateStep(i,"store_as",e.target.value)} />
                    </div>
                  )}
                </div>
              );
            })()}

            {/* DB Validate */}
            {step.action==="db_validate" && (
              <DbValidateStepForm
                config={step.db_config}
                onChange={cfg=>updateStep(i,"db_config",cfg)} />
            )}

            {/* DB Extract Multi */}
            {step.action==="db_extract_multi" && (
              <DbExtractMultiForm
                config={step.db_config}
                onChange={cfg=>updateStep(i,"db_config",cfg)} />
            )}

            {/* ── Visual Testing Steps ────────────────────────────────────────────── */}
            {(step.action==="visual_checkpoint" || step.action==="visual_figma_check") && (
              <div style={{ marginTop:12, padding:"14px 16px", background:"#fdf2f2",
                borderRadius:10, border:"1px solid #f5c5a3" }}>

                <div style={{ fontSize:12, fontWeight:700, color:"#8B0000",
                  marginBottom:10, display:"flex", alignItems:"center", gap:6 }}>
                  🎨 Visual Testing Config
                  <span style={{ fontSize:11, fontWeight:400, color:"#9ca3af" }}>
                    — screenshot taken at this exact point in the test
                  </span>
                </div>

                {/* Name */}
                <div style={{ marginBottom:10 }}>
                  <label style={{ fontSize:11, fontWeight:600, color:"#374151",
                    display:"block", marginBottom:4 }}>Checkpoint name *</label>
                  <input
                    style={{ ...s.input, marginBottom:0 }}
                    placeholder="e.g. OPD Booking Screen"
                    value={step.value||""}
                    onChange={e=>updateStep(i,"value",e.target.value)}
                  />
                  <div style={{ fontSize:11, color:"#9ca3af", marginTop:3 }}>
                    Used as the baseline filename. Must be unique per screen.
                  </div>
                </div>

                {/* Threshold */}
                <div style={{ marginBottom:10 }}>
                  <label style={{ fontSize:11, fontWeight:600, color:"#374151",
                    display:"block", marginBottom:4 }}>Mismatch threshold (%)</label>
                  <input
                    style={{ ...s.input, marginBottom:0, width:120 }}
                    type="number" min={0} max={50} step={0.5}
                    placeholder="5"
                    value={step.threshold||"5"}
                    onChange={e=>updateStep(i,"threshold",e.target.value)}
                  />
                  <div style={{ fontSize:11, color:"#9ca3af", marginTop:3 }}>
                    Fail if pixel mismatch exceeds this %. Default: 5%
                  </div>
                </div>

                {/* Figma fields (only for assert_figma_design) */}
                {step.action==="visual_figma_check" && (
                  <>
                    <div style={{ marginBottom:10 }}>
                      <label style={{ fontSize:11, fontWeight:600, color:"#374151",
                        display:"block", marginBottom:4 }}>Figma frame URL *</label>
                      <input
                        style={{ ...s.input, marginBottom:0 }}
                        placeholder="https://www.figma.com/file/XYZ/Design?node-id=42:108"
                        value={step.figma_url||""}
                        onChange={e=>updateStep(i,"figma_url",e.target.value)}
                      />
                      <div style={{ fontSize:11, color:"#9ca3af", marginTop:3 }}>
                        Right-click frame in Figma → Copy link to selection
                      </div>
                    </div>
                    <div style={{ marginBottom:4 }}>
                      <label style={{ fontSize:11, fontWeight:600, color:"#374151",
                        display:"block", marginBottom:4 }}>Figma access token</label>
                      <input
                        style={{ ...s.input, marginBottom:0 }}
                        type="password"
                        placeholder="figd_xxxxxxxxxxxxxxxxxxxx"
                        value={step.figma_token||""}
                        onChange={e=>updateStep(i,"figma_token",e.target.value)}
                      />
                      <div style={{ fontSize:11, color:"#9ca3af", marginTop:3 }}>
                        Figma → Settings → Personal Access Tokens → Generate
                      </div>
                    </div>
                  </>
                )}

                {/* Baseline mode info */}
                {step.action==="visual_checkpoint" && (
                  <div style={{ fontSize:11, color:"#8B0000", background:"#fff",
                    padding:"8px 12px", borderRadius:8, border:"1px solid #f5c5a3" }}>
                    💡 <strong>First run:</strong> screenshot saved as baseline automatically.
                    &nbsp;<strong>Future runs:</strong> compared against that baseline using Claude Vision.
                  </div>
                )}

                {/* Match Level */}
                <div style={{ marginTop:10, marginBottom:10 }}>
                  <label style={{ fontSize:11, fontWeight:600, color:"#374151",
                    display:"block", marginBottom:6 }}>Match level</label>
                  <div style={{ display:"flex", gap:8, flexWrap:"wrap" }}>
                    {[
                      { val:"ai",      label:"🤖 AI (smart)",     desc:"Auto-ignores patient data, dates, IDs",
                        detail:"Skips: usernames, patient names, dates, live counts, Favourites, Announcements, What's New. Flags only missing UI sections or wrong navigation icons." },
                      { val:"layout",  label:"📍 Layout only",    desc:"Ignores ALL text — only checks structure",
                        detail:"Checks only positions of boxes, panels and sections. Ignores all text, colours and icons. Fails only if elements move or disappear from the page." },
                      { val:"content", label:"📝 Content only",   desc:"Only checks labels and headings",
                        detail:"Verifies section headings, button labels and menu items match. Ignores colours, fonts, spacing and all dynamic data like patient names or dates." },
                      { val:"strict",  label:"🔍 Strict",         desc:"Checks everything including text",
                        detail:"Checks navigation, button text, headings, colours and fonts. Still skips dynamic data: usernames, patient IDs, dates and live counts." },
                    ].map(m => (
                      <div key={m.val}
                        onClick={() => { updateStep(i, "match_level", m.val); setTimeout(()=>{ const btn=document.querySelector('[data-save-btn]'); if(btn)btn.click(); },150); }}
                        style={{
                          padding:"10px 12px", borderRadius:8, cursor:"pointer",
                          border:`1.5px solid ${(step.match_level||"ai")===m.val ? "#8B0000" : "#e5e7eb"}`,
                          background:(step.match_level||"ai")===m.val ? "#fdf2f2" : "#f9fafb",
                          transition:"all 0.12s"
                        }}>
                        <div style={{ fontSize:12, fontWeight:700,
                          color:(step.match_level||"ai")===m.val ? "#8B0000" : "#374151" }}>
                          {m.label}
                        </div>
                        <div style={{ fontSize:10, color:"#9ca3af", marginTop:2 }}>
                          {m.desc}
                        </div>
                        <div style={{ fontSize:10, color:(step.match_level||"ai")===m.val ? "#b45309" : "#6b7280", marginTop:5, lineHeight:1.5, borderTop:"1px solid", borderColor:(step.match_level||"ai")===m.val ? "#fca5a5" : "#e5e7eb", paddingTop:5 }}>
                          {m.detail}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Ignore text patterns */}
                <div style={{ marginBottom:4 }}>
                  <label style={{ fontSize:11, fontWeight:600, color:"#374151",
                    display:"block", marginBottom:4 }}>Also ignore these text patterns (optional)</label>
                  <input
                    style={{ ...s.input, marginBottom:0 }}
                    placeholder="e.g. Dr. Kumar, Ward 4B, Apollo (comma-separated)"
                    value={step.ignore_text||""}
                    onChange={e=>updateStep(i,"ignore_text",e.target.value)}
                  />
                  <div style={{ fontSize:11, color:"#9ca3af", marginTop:3 }}>
                    Comma-separated. Use for doctor names, ward names, hospital-specific text that changes.
                  </div>
                </div>
              </div>
            )}

            {/* JSON Actions */}
            {step.action?.startsWith("json_") && (
              <JsonStepForm step={step} i={i} updateStep={updateStep} />
            )}

            {/* AI Visual Assert */}
            {step.action === "assert_ai" && (
              <div style={{ marginTop: 8 }}>
                <label style={{ fontSize: 12, fontWeight: 600, color: "#7c3aed", display: "block", marginBottom: 4 }}>
                  🤖 Question for Claude (supports {"{{variables}}"})
                </label>
                <textarea
                  value={step.value || ""}
                  onChange={e => updateStep(i, "value", e.target.value)}
                  placeholder={"Does this report show patient name as {{patient_name}}, MRN as {{Ehr_MRN}}, and today's date?"}
                  rows={4}
                  style={{ width: "100%", fontSize: 13, padding: "8px 10px", border: "1.5px solid #ddd6fe", borderRadius: 6, fontFamily: "inherit", resize: "vertical", boxSizing: "border-box" }}
                />
                <div style={{ fontSize: 11, color: "#9ca3af", marginTop: 4 }}>
                  Claude will screenshot the current page and answer YES/NO. Use {"{{variable}}"} for dynamic values.
                </div>
              </div>
            )}

            {/* ── SCROLL ── */}
            {step.action === "scroll" && (
              <div style={{ marginTop: 8, display: "flex", flexDirection: "column", gap: 8 }}>
                <div style={{ display: "flex", gap: 8 }}>
                  <div style={{ flex: 1 }}>
                    <label style={{ fontSize: 11, color: "#8a96a8", display: "block", marginBottom: 3 }}>Scroll Y (vertical px, up↕down)</label>
                    <input style={s.input} placeholder="0" value={step.value || ""} onChange={e => updateStep(i, "value", e.target.value)} />
                  </div>
                  <div style={{ flex: 1 }}>
                    <label style={{ fontSize: 11, color: "#8a96a8", display: "block", marginBottom: 3 }}>Scroll X (horizontal px, left↔right)</label>
                    <input style={s.input} placeholder="0" value={step.value2 || ""} onChange={e => updateStep(i, "value2", e.target.value)} />
                  </div>
                </div>
                <div>
                  <label style={{ fontSize: 11, color: "#8a96a8", display: "block", marginBottom: 3 }}>Scroll element (CSS selector, optional)</label>
                  <input style={s.input} placeholder="e.g. .table-container — leave empty to scroll Angular page scrollbar" value={step.selector || ""} onChange={e => updateStep(i, "selector", e.target.value)} />
                </div>
                <div style={{ fontSize: 11, color: "#9ca3af" }}>
                  💡 Scroll table right: Y=<b>0</b>, X=<b>500</b> (increase X until column is visible). Leave Selector empty.
                </div>
              </div>
            )}

            {/* ── AI EXTRACT ── */}
            {step.action === "ai_extract" && (
              <div style={{ marginTop: 8 }}>
                <label style={{ fontSize: 12, fontWeight: 600, color: "#7c3aed", display: "block", marginBottom: 4 }}>
                  🤖 What to extract from the screen (supports variables)
                </label>
                <textarea
                  value={step.value || ""}
                  onChange={e => updateStep(i, "value", e.target.value)}
                  placeholder={"What is the patient MRN shown on screen?\nWhat is the total amount?\nGet the appointment number from the header"}
                  rows={3}
                  style={{ width: "100%", fontSize: 13, padding: "8px 10px",
                    border: "1.5px solid #ddd6fe", borderRadius: 6,
                    fontFamily: "inherit", resize: "vertical", boxSizing: "border-box" }}
                />
                <div style={{ display: "flex", gap: 8, alignItems: "center", marginTop: 6 }}>
                  <span style={{ fontSize: 12, color: "#8a96a8", minWidth: 80 }}>Store into</span>
                  <input
                    style={{ ...s.input, flex: 1, fontFamily: "'IBM Plex Mono',monospace", fontSize: 12 }}
                    placeholder="variable_name  (e.g. patient_mrn, total_amount)"
                    value={step.store_as || ""}
                    onChange={e => updateStep(i, "store_as", e.target.value)}
                  />
                </div>
                <div style={{ fontSize: 11, color: "#9ca3af", marginTop: 4 }}>
                  Claude will screenshot the page and extract the requested value. Supports dynamic prompts with variables.
                </div>
              </div>
            )}

            {/* Search & Select */}
            {step.action==="search_select" && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                <div style={{ display:"flex", gap:6, alignItems:"center" }}>
                  <div style={{ flex:1, position:"relative" }}>
                    <input style={{ ...s.input, fontFamily:"'IBM Plex Mono',monospace", fontSize:12, paddingRight:hasVars?80:12 }}
                      placeholder='Search input selector (e.g. #indent-store)'
                      value={step.selector||""}
                      onChange={e=>updateStep(i,"selector",e.target.value)} />
                    <VarBtn stepIdx={i} field="selector" />
                  </div>
                  <button onClick={()=>launchInspector(i)}
                    style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14, flexShrink:0 }}>🎯</button>
                </div>
                <div style={{ display:"flex", gap:8 }}>
                  <div style={{ flex:1, position:"relative" }}>
                    <input style={{ ...s.input, paddingRight:hasVars?80:12 }}
                      placeholder='Text to type (e.g. OP)'
                      value={step.search_text||""}
                      onChange={e=>updateStep(i,"search_text",e.target.value)} />
                    <VarBtn stepIdx={i} field="search_text" />
                  </div>
                  <div style={{ flex:1, position:"relative" }}>
                    <input style={{ ...s.input, paddingRight:hasVars?80:12 }}
                      placeholder='Option to select — contains match (e.g. OPD [D] - RAIPUR)'
                      value={step.value||""}
                      onChange={e=>updateStep(i,"value",e.target.value)} />
                    <VarBtn stepIdx={i} field="value" />
                  </div>
                </div>
                {/* Wait time + hint row */}
                <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                  <div style={{ display:"flex", alignItems:"center", gap:6 }}>
                    <span style={{ fontSize:11, color:"#8a96a8", whiteSpace:"nowrap" }}>
                      Wait after typing (ms)
                    </span>
                    <input style={{ ...s.input, width:90, fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                      type="number" min="500" max="10000" step="500"
                      placeholder="1500"
                      value={step.wait_ms||""}
                      onChange={e=>updateStep(i,"wait_ms",e.target.value)} />
                  </div>
                  <div style={{ fontSize:11, color:"#8a96a8", flex:1 }}>
                    💡 Increase if dropdown takes time to load (default 1500ms). Try 2000–3000 for slow APIs.
                  </div>
                </div>
              </div>
            )}

            {/* Table Action */}
            {step.action==="table_action" && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                <div style={{ background:"#e6f1fb", border:"1px solid #b5d4f4", borderRadius:8, padding:"10px 12px" }}>
                  <div style={{ fontSize:11, fontWeight:700, color:"#185fa5", marginBottom:8 }}>📊 Table Action — Find row, act on column</div>
                  {/* Row 1: Table selector */}
                  <div style={{ display:"flex", gap:6, alignItems:"center", marginBottom:8 }}>
                    <div style={{ flex:1, position:"relative" }}>
                      <input style={{ ...s.input, fontFamily:"'IBM Plex Mono',monospace", fontSize:12, paddingRight:hasVars?80:12 }}
                        placeholder='Table CSS selector (e.g. table.athma-table)'
                        value={step.selector||""}
                        onChange={e=>updateStep(i,"selector",e.target.value)} />
                      <VarBtn stepIdx={i} field="selector" />
                    </div>
                    <button onClick={()=>launchInspector(i)}
                      style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14, flexShrink:0 }}>🎯</button>
                  </div>
                  {/* Row 2: search_text, search_col, target_col */}
                  <div style={{ display:"grid", gridTemplateColumns:"2fr 1fr 1fr", gap:8, marginBottom:8 }}>
                    <div>
                      <label style={{ ...s.label, color:"#185fa5" }}>Search Text *</label>
                      <div style={{ position:"relative" }}>
                        <input style={{ ...s.input, paddingRight:hasVars?80:12 }}
                          placeholder='e.g. PARACETAMOL or {{Item_name}}'
                          value={step.search_text||""}
                          onChange={e=>updateStep(i,"search_text",e.target.value)} />
                        <VarBtn stepIdx={i} field="search_text" />
                      </div>
                    </div>
                    <div>
                      <label style={{ ...s.label, color:"#185fa5" }}>Search Column</label>
                      <input style={{ ...s.input, fontFamily:"monospace" }}
                        type="number" min="1" placeholder="1"
                        value={step.search_col||"1"}
                        onChange={e=>updateStep(i,"search_col",e.target.value)} />
                    </div>
                    <div>
                      <label style={{ ...s.label, color:"#185fa5" }}>Target Column *</label>
                      <input style={{ ...s.input, fontFamily:"monospace" }}
                        type="number" min="1" placeholder="7"
                        value={step.target_col||""}
                        onChange={e=>updateStep(i,"target_col",e.target.value)} />
                    </div>
                  </div>
                  {/* Row 3: sub_action + value */}
                  <div style={{ display:"grid", gridTemplateColumns:"1fr 2fr", gap:8 }}>
                    <div>
                      <label style={{ ...s.label, color:"#185fa5" }}>Sub Action</label>
                      <select style={s.input} value={step.sub_action||"click"}
                        onChange={e=>updateStep(i,"sub_action",e.target.value)}>
                        <option value="click">🖱️ Click</option>
                        <option value="type">⌨️ Type text</option>
                        <option value="select">📋 Select option</option>
                        <option value="search_select">🔍 Search & Select</option>
                        <option value="get_text">📋 Get text → variable</option>
                        <option value="assert_text">✅ Assert text contains</option>
                        <option value="assert_visible">✅ Assert visible</option>
                        <option value="check">☑️ Check checkbox</option>
                        <option value="uncheck">☐ Uncheck checkbox</option>
                      </select>
                    </div>
                    <div>
                      <label style={{ ...s.label, color:"#185fa5" }}>
                        {step.sub_action==="get_text" ? "Store as variable" :
                         step.sub_action==="assert_text" ? "Expected text" :
                         step.sub_action==="check"||step.sub_action==="uncheck" ? "— no value needed —" :
                         step.sub_action==="type" || step.sub_action==="select" || step.sub_action==="search_select" ? "Value to enter" :
                         "Value"}
                      </label>
                      <div style={{ position:"relative" }}>
                        <input style={{ ...s.input, paddingRight:hasVars?80:12, opacity: step.sub_action==="check"||step.sub_action==="uncheck" ? 0.4 : 1 }}
                          disabled={step.sub_action==="check"||step.sub_action==="uncheck"}
                          placeholder={
                            step.sub_action==="get_text" ? "e.g. cell_value" :
                            step.sub_action==="assert_text" ? "e.g. Active" :
                            step.sub_action==="type" ? "e.g. 10" :
                            step.sub_action==="select" ? "e.g. EACH" :
                            step.sub_action==="check"||step.sub_action==="uncheck" ? "no value needed" :
                            "(not needed for click/assert_visible)"
                          }
                          value={step.sub_value||step.value||""}
                          onChange={e=>{ updateStep(i,"sub_value",e.target.value); updateStep(i,"value",e.target.value); }} />
                        <VarBtn stepIdx={i} field="sub_value" />
                      </div>
                    </div>
                  </div>
                  {/* Preview */}
                  {step.selector && step.search_text && step.target_col && (
                    <div style={{ marginTop:8, fontSize:11, fontFamily:"monospace",
                      background:"#0f172a", color:"#60a5fa", borderRadius:5,
                      padding:"5px 10px" }}>
                      → Find "{step.search_text}" in col {step.search_col||1}, then {step.sub_action||"click"} col {step.target_col}
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* Table Multi Action */}
            {step.action==="table_multi_action" && <TableMultiActionUI step={step} i={i} updateStep={updateStep} launchInspector={launchInspector} />}

            {/* Standard actions */}
            {!isCF && !isStore && !isStoreUrl && !isAssertVar && !isStrOp && !isMathOp && !isDateOp && !isEncodeOp
              && step.action!=="db_validate" && step.action!=="search_select"
              && step.action!=="table_action"
              && step.action!=="table_multi_action"
              && step.action!=="store_attr" && step.action!=="store_js"
              && step.action!=="call_test" && (
              <div style={{ display:"flex", gap:8, alignItems:"center", flexWrap:"wrap" }}>
                {needsSelector.includes(step.action) && (
                  <div style={{ flex:1, display:"flex", gap:6, minWidth:200 }}>
                    <div style={{ flex:1, position:"relative" }}>
                      <input style={{ ...s.input, paddingRight:hasVars?80:12,
                        fontFamily:"'IBM Plex Mono',monospace", fontSize:12 }}
                        placeholder='CSS Selector / get_by_role(...)'
                        value={step.selector||""}
                        onChange={e=>updateStep(i,"selector",e.target.value)} />
                      <VarBtn stepIdx={i} field="selector" />
                    </div>
                    <button onClick={()=>launchInspector(i)}
                      style={{ ...s.btn("primary",true), padding:"7px 10px", fontSize:14, flexShrink:0 }}>🎯</button>
                  </div>
                )}
                {![“click”,“hover”,“assert_visible”,“assert_not_visible”,“clear”,“check”,“uncheck”,
                   “store_text”,“store_value”,“store_url”,“screenshot”].includes(step.action) && (
                  <div style={{ flex:1, position:“relative”, minWidth:160 }}>
                    {step.action === “upload_attachment” ? (
                      <FileLibraryPicker
                        value={step.value||“”}
                        onChange={v => updateStep(i, “value”, v)}
                      />
                    ) : (
                      <>
                        <input style={{ ...s.input, paddingRight:hasVars?80:12 }}
                          placeholder={step.action==="navigate"?"https://..."
                            :step.action==="wait"?"2000 (milliseconds)"
                            :step.action==="execute_script"?"document.querySelector('.x').remove()"
                            :step.action==="compare_pdf_page"?"C:\\\\path\\\\to\\\\file.pdf"
                            :step.action==="log_message"?"Message or {{variable}} to print"
                            :"value"}
                          value={step.value||""}
                          onChange={e=>updateStep(i,"value",e.target.value)} />
                        <VarBtn stepIdx={i} field="value" />
                      </>
                    )}
                  </div>
                )}
              </div>
            )}
          </div>
          </div>
          </div>
          </React.Fragment>
        );
      })}

      {/* ── Block Insert Toolbar ── */}
      <div style={{ marginTop:8, background:"#f8f9fc", border:"1px solid #e2e6ed",
        borderRadius:8, padding:"10px 12px" }}>
        <div style={{ fontSize:11, fontWeight:700, color:"#8a96a8", textTransform:"uppercase",
          letterSpacing:"0.06em", marginBottom:8 }}>Insert Block</div>
        <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
          <button title="Add a single step"
            style={{ ...s.btn("ghost",true), border:"1px dashed #cdd3dc", color:"#4a5568" }}
            onClick={addStep}>+ Step</button>
          <button title="Repeat N times"
            style={{ ...s.btn("ghost",true), border:"1px solid #805ad5", color:"#805ad5", background:"#faf5ff" }}
            onClick={()=>onChange([...steps,
              {action:"loop_start",value:"3",selector:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"loop_end",value:"",selector:"",timeout:30000}])}>
            🔁 Loop</button>
          <button title="Iterate over a list"
            style={{ ...s.btn("ghost",true), border:"1px solid #6b46c1", color:"#6b46c1", background:"#f5f0ff" }}
            onClick={()=>onChange([...steps,
              {action:"foreach_start",value:"item1, item2, item3",loop_var:"current_item",selector:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"foreach_end",value:"",selector:"",timeout:30000}])}>
            📋 ForEach</button>
          <button title="Conditional steps"
            style={{ ...s.btn("ghost",true), border:"1px solid #d69e2e", color:"#d69e2e", background:"#fffff0" }}
            onClick={()=>onChange([...steps,
              {action:"if_start",if_condition:"element_visible",if_selector:"",if_var:"",if_value:"",selector:"",value:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"else",value:"",selector:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"if_end",value:"",selector:"",timeout:30000}])}>
            ❓ IF / ELSE</button>
          <button title="Match a variable"
            style={{ ...s.btn("ghost",true), border:"1px solid #2b6cb0", color:"#2b6cb0", background:"#ebf8ff" }}
            onClick={()=>onChange([...steps,
              {action:"switch_start",value:"{{my_var}}",selector:"",timeout:30000},
              {action:"case",value:"value1",selector:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"case",value:"value2",selector:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"switch_end",value:"",selector:"",timeout:30000}])}>
            🔀 Switch</button>
          <button title="Repeat until condition"
            style={{ ...s.btn("ghost",true), border:"1px solid #38b2ac", color:"#38b2ac", background:"#e6fffa" }}
            onClick={()=>onChange([...steps,
              {action:"repeat_until",if_condition:"element_visible",if_selector:"",max_retries:"10",interval_ms:"2000",selector:"",value:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"repeat_until_end",value:"",selector:"",timeout:30000}])}>
            🔄 Repeat Until</button>
          <button title="Handle errors"
            style={{ ...s.btn("ghost",true), border:"1px solid #e53e3e", color:"#c53030", background:"#fff5f5" }}
            onClick={()=>onChange([...steps,
              {action:"try_start",value:"",selector:"",timeout:30000},
              {action:"navigate",value:"",selector:"",timeout:30000},
              {action:"catch_start",error_var:"error_message",value:"",selector:"",timeout:30000},
              {action:"screenshot",value:"error_screenshot",selector:"",timeout:30000},
              {action:"try_end",value:"",selector:"",timeout:30000}])}>
            🛡️ Try / Catch</button>
          <button title="Add a comment"
            style={{ ...s.btn("ghost",true), border:"1px dashed #a0aec0", color:"#718096" }}
            onClick={()=>onChange([...steps,
              {action:"group",value:"Section name",selector:"",timeout:30000}])}>
            📦 Comment</button>
        </div>
      </div>

      {/* ── Inspector modals ── */}
      {inspStep !== null && !inspResult && (
        <div style={{ ...s.modal, alignItems:inspLoading?"flex-end":"center",
          justifyContent:inspLoading?"flex-start":"center",
          background:inspLoading?"transparent":"rgba(0,0,0,0.45)",
          pointerEvents:inspLoading?"none":"all" }}
          onClick={e=>!inspLoading&&e.target===e.currentTarget&&closeInspector()}>
          <div style={{ ...s.modalBox, maxWidth:540, width:"100%", maxHeight:"85vh", overflowY:"auto",
            ...(inspLoading ? {
              position:"fixed", bottom:20, left:20, width:340, maxWidth:340,
              maxHeight:"none", boxShadow:"0 8px 32px rgba(0,0,0,0.25)",
              pointerEvents:"all", zIndex:9999
            } : {}) }}>
            <div style={{ fontSize:17, fontWeight:700, color:"#1a2332", marginBottom:16 }}>🎯 Element Inspector</div>
            {!inspLoading ? (
              <>
                <div style={{ background:"#f0f7ff", border:"1px solid #bdd7f5", borderRadius:8,
                  padding:"12px 14px", marginBottom:16, fontSize:13, lineHeight:1.8 }}>
                  <div style={{ fontWeight:700, color:"#1a2332", marginBottom:6 }}>How to inspect an element:</div>
                  <div style={{ color:"#1a6fc4" }}>1. Open your app in a Chrome tab</div>
                  <div style={{ color:"#1a6fc4" }}>2. Click the <b>ATHMA extension icon</b> in Chrome toolbar</div>
                  <div style={{ color:"#1a6fc4" }}>3. Click <b>"🎯 Activate Inspector on Current Tab"</b> in popup</div>
                  <div style={{ color:"#1a6fc4" }}>4. <b>Click</b> any element (or Tab to it) → press <b>Space</b> to capture</div>
                </div>
                <div style={{ background:"#1a2332", borderRadius:8, padding:"10px 16px",
                  fontSize:12, color:"#7dd3fc", textAlign:"center", marginBottom:16 }}>
                  ⏳ Waiting for element capture via extension...
                </div>
                <div style={{ display:"flex", gap:10, justifyContent:"flex-end" }}>
                  <button style={s.btn("ghost")} onClick={closeInspector}>Cancel</button>
                  <button style={s.btn("primary")} onClick={()=>launchInspector(inspStep)}>🎯 Start Waiting</button>
                </div>
              </>
            ) : (
              <div style={{ padding:"8px 0", maxHeight:"70vh", overflowY:"auto" }}>
                {/* Status bar */}
                <div style={{ display:"flex", alignItems:"center", gap:10, background:"#f0f7ff",
                  border:"1px solid #bdd7f5", borderRadius:8, padding:"10px 14px", marginBottom:16 }}>
                  <div style={{ width:10, height:10, borderRadius:"50%", background:"#22c55e",
                    boxShadow:"0 0 0 3px rgba(34,197,94,0.25)", flexShrink:0 }} />
                  <div style={{ fontSize:13, fontWeight:600, color:"#1a2332" }}>
                    Inspector active in your Chrome tab
                  </div>
                </div>

                {/* Instructions */}
                <div style={{ display:"flex", flexDirection:"column", gap:8, marginBottom:16 }}>
                  {[
                    { step:"1", text:"Switch to your app Chrome tab" },
                    { step:"2", text:"Blue highlight box appears as you hover" },
                    { step:"3", text:"Hover over the element you want to inspect" },
                    { step:"4", text:"Click element (or Tab to it) then press Space" },
                  ].map(({step,text}) => (
                    <div key={step} style={{ display:"flex", alignItems:"center", gap:10,
                      padding:"9px 12px", background:"#f8f9fc", borderRadius:7,
                      border:"1px solid #e2e6ed" }}>
                      <div style={{ width:22, height:22, borderRadius:"50%", background:"#1a6fc4",
                        color:"#fff", fontSize:11, fontWeight:700, display:"flex",
                        alignItems:"center", justifyContent:"center", flexShrink:0 }}>{step}</div>
                      <span style={{ fontSize:13, color:"#4a5568" }}>{text}</span>
                    </div>
                  ))}
                </div>

                {/* Click hint */}
                <div style={{ background:"#1a2332", borderRadius:8, padding:"12px 16px",
                  display:"flex", alignItems:"center", justifyContent:"center", gap:12, marginBottom:16 }}>
                  <span style={{ fontSize:12, color:"rgba(255,255,255,0.6)" }}>Click element then press</span>
                  <span style={{ background:"#fbbf24", color:"#1a2332", borderRadius:6,
                    padding:"4px 14px", fontSize:14, fontWeight:900 }}>Space</span>
                  <span style={{ fontSize:12, color:"rgba(255,255,255,0.6)" }}>to capture</span>
                </div>

                <div style={{ display:"flex", justifyContent:"center" }}>
                  <button style={{ ...s.btn("ghost"), fontSize:13 }} onClick={closeInspector}>
                    ✕ Stop Inspector
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {inspResult && (
        <div style={s.modal}>
          <div style={{ ...s.modalBox, maxWidth:600, maxHeight:"85vh", overflowY:"auto" }}>

            {/* Header */}
            <div style={{ display:"flex", justifyContent:"space-between",
              alignItems:"flex-start", marginBottom:16 }}>
              <div>
                <div style={{ fontSize:17, fontWeight:800, color:"#1a2332" }}>
                  🎯 Pick a Selector
                </div>
                {inspResult.element && (
                  <div style={{ fontSize:11, color:"#6b7280", marginTop:3,
                    fontFamily:"monospace" }}>
                    &lt;{inspResult.element.tag}
                    {inspResult.element.id ? ` id="${inspResult.element.id}"` : ""}
                    {inspResult.element.text ? `› "${inspResult.element.text.slice(0,40)}"` : ""}
                    &gt;
                  </div>
                )}
              </div>
              <div style={{ fontSize:11, color:"#9ca3af", textAlign:"right" }}>
                <div>{inspResult.selectors.length} selectors found</div>
                <div style={{ marginTop:2 }}>★★★ = most stable</div>
              </div>
            </div>

            {/* Legend */}
            <div style={{ display:"flex", gap:12, marginBottom:12, fontSize:11, color:"#6b7280" }}>
              <span><span style={{color:"#10b981"}}>★★★</span> Stable — use this</span>
              <span><span style={{color:"#3b82f6"}}>★★☆</span> Good — usually works</span>
              <span><span style={{color:"#9ca3af"}}>★☆☆</span> Fragile — last resort</span>
            </div>

            {/* Selector list */}
            <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
              {inspResult.selectors.map((sel, idx) => {
                const stars  = sel.stars || 1;
                const border = stars===3 ? "#10b981" : stars===2 ? "#3b82f6" : "#475569";
                const bg     = stars===3 ? "#f0fdf4" : stars===2 ? "#eff6ff" : "#f9fafb";
                const isFirst = idx === 0;
                return (
                  <div key={idx}
                    onClick={()=>applySelector(sel.value)}
                    style={{ background:bg,
                      border:`${isFirst?"2px":"1px"} solid ${border}`,
                      borderRadius:8, padding:"10px 14px", cursor:"pointer",
                      transition:"all 0.12s" }}
                    onMouseEnter={e=>{ e.currentTarget.style.transform="translateY(-1px)";
                      e.currentTarget.style.boxShadow="0 3px 10px rgba(0,0,0,0.1)"; }}
                    onMouseLeave={e=>{ e.currentTarget.style.transform="";
                      e.currentTarget.style.boxShadow=""; }}>
                    <div style={{ display:"flex", justifyContent:"space-between",
                      alignItems:"center", marginBottom:4 }}>
                      <div style={{ display:"flex", alignItems:"center", gap:6 }}>
                        <span style={{ fontSize:10, fontWeight:700, color:border,
                          textTransform:"uppercase", letterSpacing:"0.05em" }}>
                          {sel.type}
                        </span>
                        {isFirst && (
                          <span style={{ background:border, color:"#fff",
                            padding:"1px 6px", borderRadius:3, fontSize:9,
                            fontWeight:700, letterSpacing:"0.05em" }}>
                            BEST
                          </span>
                        )}
                      </div>
                      <div style={{ display:"flex", alignItems:"center", gap:8 }}>
                        <span style={{ color:border, fontSize:12 }}>{sel.starsDisplay || "★☆☆"}</span>
                        <span style={{ fontSize:10, color:"#9ca3af" }}>click to use →</span>
                      </div>
                    </div>
                    <div style={{ fontSize:12, fontWeight:700, color:"#1a2332",
                      fontFamily:"'IBM Plex Mono',monospace", wordBreak:"break-all",
                      lineHeight:1.5 }}>
                      {sel.value}
                    </div>
                    {sel.hint && (
                      <div style={{ fontSize:11, color:"#6b7280", marginTop:3 }}>{sel.hint}</div>
                    )}
                  </div>
                );
              })}
            </div>

            <div style={{ display:"flex", justifyContent:"space-between", marginTop:16 }}>
              <button style={{ ...s.btn("ghost",true), fontSize:12 }}
                onClick={async ()=>{ 
                  const stepIdx = inspResult.stepIdx;
                  // Close old session and websocket
                  if (inspSid.current) { api("/api/inspector/" + inspSid.current, { method:"DELETE" }).catch(()=>{}); inspSid.current = null; }
                  if (inspWs.current) { inspWs.current.close(); inspWs.current = null; }
                  setInspResult(null);
                  // Stop extension inspector
                  try { await api("/api/inspector/stop", { method:"POST", body:{} }); } catch(e) {}
                  // Re-launch after short delay
                  setTimeout(() => launchInspector(stepIdx), 200);
                }}>
                🔄 Pick Another Element
              </button>
              <button style={s.btn("ghost")} onClick={closeInspector}>
                Cancel &amp; Close Browser
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}


function ApiEditor({ config, onChange }) {
  const c = config || { method: "GET", url: "", headers: {}, body: "", assertions: [] };
  const update = (field, val) => onChange({ ...c, [field]: val });

  const addAssertion = () => onChange({ ...c, assertions: [...(c.assertions||[]), { type: "status_code", value: "200" }] });
  const updateAssertion = (i, field, val) => {
    const a = [...(c.assertions||[])];
    a[i] = { ...a[i], [field]: val };
    onChange({ ...c, assertions: a });
  };
  const removeAssertion = (i) => onChange({ ...c, assertions: c.assertions.filter((_, idx) => idx !== i) });

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
      <div style={{ display: "flex", gap: 8 }}>
        <select style={{ ...s.input, width: 120 }} value={c.method} onChange={e => update("method", e.target.value)}>
          {["GET","POST","PUT","PATCH","DELETE"].map(m => <option key={m}>{m}</option>)}
        </select>
        <input style={{ ...s.input, flex: 1 }} placeholder="https://api.example.com/endpoint" value={c.url||""} onChange={e => update("url", e.target.value)} />
      </div>
      <div>
        <label style={s.label}>Request Body (JSON)</label>
        <textarea style={{ ...s.input, height: 80, resize: "vertical", fontFamily: "'IBM Plex Mono',monospace", fontSize: 12 }} value={c.body||""} onChange={e => update("body", e.target.value)} placeholder='{"key": "value"}' />
      </div>
      <div>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 8 }}>
          <label style={s.label}>Assertions</label>
          <button style={s.btn("ghost", true)} onClick={addAssertion}>+ Add</button>
        </div>
        {(c.assertions||[]).map((a, i) => (
          <div key={i} style={{ display: "flex", gap: 8, marginBottom: 8 }}>
            <select style={{ ...s.input, flex: 1 }} value={a.type} onChange={e => updateAssertion(i, "type", e.target.value)}>
              {API_ASSERTIONS.map(x => <option key={x.value} value={x.value}>{x.label}</option>)}
            </select>
            <input style={{ ...s.input, flex: 1 }} value={a.value||""} onChange={e => updateAssertion(i, "value", e.target.value)} placeholder="expected value" />
            <button style={{ ...s.btn("danger", true), padding: "4px 8px" }} onClick={() => removeAssertion(i)}>✕</button>
          </div>
        ))}
      </div>
    </div>
  );
}

export { ACTIONS, ACTION_GROUPS, API_ASSERTIONS, VAR_TYPES,
         DbQueryForm, DbValidateStepForm, VariablesPanel,
         stepsToScript, playwrightLocatorToSelector, scriptToSteps, smartSel,
         stepsToCode, codeToSteps, normalizeScriptQuotes,
         ScriptEditor, StepEditor, ApiEditor };
