# Narayana Automation Tool — Backend Environment Variables
# Copy this file to backend/.env and fill in your values

# ── Anthropic API Key (required for AI Generator + Auto-Heal) ──────────────
# Get your key from: https://console.anthropic.com → API Keys


ANTHROPIC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



# ── Optional: change default port ──────────────────────────────────────────
# PORT=6001

# PostgreSQL database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=XXXXXXX
DB_USER=XXXXXXX
DB_PASSWORD=nhtest
DB_POOL_SIZE=20          # max DB connections (15 runs × 3 queries each + headroom)
DB_POOL_MIN=3            # min idle connections

# ─── SMTP Email Settings (for suite run report emails) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=XXXX
SMTP_SECURE=false
SMTP_USER=XXXXXX
SMTP_PASS=XXXXXXXX
SMTP_FROM=XXXXXXX


# ── Run Queue ─────────────────────────────────────────────────────────────────

MAX_CONCURRENT_RUNS=8   # global max parallel test runs (safe with async runner)
MAX_RUNS_PER_ORG=4       # max runs per organisation at once
QUEUE_POLL_INTERVAL=500 # ms between queue checks
STUCK_RUN_TIMEOUT_MIN=60 # auto-fail runs stuck > N minutes
#STUCK_RUN_TIMEOUT_MS=60
MAX_RUNS_PER_SUITE=1     #less than or equal to MAX_RUNS_PER_ORG
SUITE_RETRY_FAILED =1    # if any Testc ase fails in suite wether it should try failed once how many times.  

# ── Data Retention ────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=1        # delete run logs older than N days
SUITE_RUN_RETENTION_DAYS=2  # delete suite runs older than N days
TEST_RUN_RETENTION_DAYS=2  # delete test runs older than N days (overrides LOG_RETENTION_DAYS for runs)
SCREENSHOT_RETENTION_DAYS=1  # delete screenshot files older than N days
CLEANUP_INTERVAL_HOURS=1    # how often cleanup runs (1=every hour, 6=every 6hrs, 24=once daily)

# ── Performance ───────────────────────────────────────────────────────────────
PAGE_SIZE= 10        # default pagination page size
DASHBOARD_CACHE_TTL=30   # dashboard cache TTL in seconds
SLOW_RUN_THRESHOLD=2 #Compares with earlier runs and try to determine if the script is slow more than 2 times

# ── Security ──────────────────────────────────────────────────────────────────
RUNNER_SECRET=nat-internal-runner-2024

#--PROJECT Variables
# ── Project Variables ────────────────────────────────────────────────────────
VAR_ENCRYPTION_KEY=rA9bQ3F5dXJ2L+Zc0KWeT8M4YpS6H/Nu #node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROJECT_VAR_LIMIT=50          # max variables per project
API_BASE_URL=XXXXXXXX
#API_BASE_URL=XXXXXXX

# Login protection===

LOGIN_MAX_ATTEMPTS=5          # failed attempts before lockout
LOGIN_LOCKOUT_MINUTES=15      # how long the lockout lasts

#--------------
MAX_NAME_LEN=255        # names, usernames
MAX_DESC_LEN=2000       # descriptions
MAX_STEPS_COUNT=500     # steps per test case
MAX_TAGS_COUNT=20       # tags per test case
MAX_URL_LEN=500         # base URLs

#============
# API rate limiting  
RATE_LIMIT_GENERAL=1000        # requests per minute for all /api routes
RATE_LIMIT_AI=10              # requests per minute for /api/ai routes
SLOW_RUN_THRESHOLD =3

# ── Visual Testing (separate module — port 6002) ───────────────────────────
VISUAL_PORT=6002
VISUAL_DIFF_RETENTION_DAYS=7
VISUAL_ACTUAL_RETENTION_DAYS=2
PYTHON_PATH=XXXXXXXXX

#CORGS ORIGIN-----------------------
#CORS_ORIGIN=XXXXXXX
CORS_ORIGIN=XXXXXXX
#CORS_ORIGIN=XXXXXXXXX




