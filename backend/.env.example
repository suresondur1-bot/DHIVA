# ATHMA — Backend Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automation_db
DB_USER=appuser
DB_PASSWORD=your_db_password_here
DB_POOL_SIZE=20
DB_POOL_MIN=2

# ── Anthropic API Key (required for AI features) ──────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server ────────────────────────────────────────────────────────────────────
PORT=6001
CORS_ORIGIN=http://localhost:5176

# ── Email Reports (Gmail recommended) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your@gmail.com

# ── Run Queue ─────────────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS=5
MAX_RUNS_PER_ORG=2
MAX_RUNS_PER_SUITE=1
SUITE_RETRY_FAILED=1
QUEUE_POLL_INTERVAL=500
STUCK_RUN_TIMEOUT_MIN=60

# ── Data Retention ────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=2
SCREENSHOT_RETENTION_DAYS=1

# ── Performance ───────────────────────────────────────────────────────────────
PAGE_SIZE=10
DASHBOARD_CACHE_TTL=30
SLOW_RUN_THRESHOLD=3

# ── Security (CHANGE THESE) ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RUNNER_SECRET=change-this-to-a-random-secret-string
VAR_ENCRYPTION_KEY=change-this-to-32-char-random-key
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GENERAL=1000
RATE_LIMIT_AI=10

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_NAME_LEN=255
MAX_DESC_LEN=2000
MAX_STEPS_COUNT=500
MAX_TAGS_COUNT=20
MAX_URL_LEN=500
PROJECT_VAR_LIMIT=50
