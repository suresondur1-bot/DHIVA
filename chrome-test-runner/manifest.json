{
  "manifest_version": 3,
  "name": "QAVYA Test Runner",
  "version": "2.1.0",
  "description": "Record user actions and run automated tests with the QAVYA test automation platform",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": ["http://localhost:5176/*", "http://localhost:5177/*", "http://localhost:6001/*", "http://10.8.7.176:5176/*", "http://10.8.7.176:5177/*", "http://10.8.7.176:6001/*", "http://*/*", "https://*/*"]
  },
  "web_accessible_resources": [
    {
      "resources": ["recorder.js", "inspector.js", "smart_study_recorder.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
